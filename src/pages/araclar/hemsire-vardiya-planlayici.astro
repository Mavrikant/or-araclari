  /* Nurse list cards */
  .ns-nurse-card {
    border: 1px solid var(--ns-grid-border);
    border-radius: 8px;
    padding: 8px 10px;
    background: rgb(255 255 255);
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .dark .ns-nurse-card {
    background: rgb(15 23 42 / 0.4);
  }
  .ns-nurse-row {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .ns-nurse-row input.ns-nurse-name {
    flex: 1;
    border: none;
    background: transparent;
    color: inherit;
    font-size: 0.85rem;
    font-weight: 500;
    padding: 2px 0;
  }
  .ns-nurse-row input.ns-nurse-name:focus {
    outline: 1px solid rgb(99 102 241);
    border-radius: 3px;
  }
  .ns-icon-btn {
    border: 1px solid var(--ns-grid-border);
    border-radius: 4px;
    background: white;
