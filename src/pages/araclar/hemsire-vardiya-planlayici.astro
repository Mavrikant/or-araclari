---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import { withBase, SITE } from '../../data/site';
import { TOOLS } from '../../data/tools';

const tool = TOOLS.find((t) => t.slug === 'hemsire-vardiya-planlayici')!;
const guideHref = tool.guideSlug ? withBase(`/rehberler/${tool.guideSlug}`) : null;

const softwareJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: tool.title,
  applicationCategory: 'WebApplication',
  operatingSystem: 'Any',
  description: tool.description,
  url: new URL(Astro.url.pathname, Astro.site).toString(),
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'TRY' },
  inLanguage: SITE.locale,
  isAccessibleForFree: true,
};

const TR_MONTHS = [
  'Ocak', 'Şubat', 'Mart', 'Nisan', 'Mayıs', 'Haziran',
  'Temmuz', 'Ağustos', 'Eylül', 'Ekim', 'Kasım', 'Aralık',
];
---

<BaseLayout title={tool.title} description={tool.description}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(softwareJsonLd)} />
  </Fragment>

  <Container as="section" size="wide" class="pt-12 sm:pt-16">
    <p class="text-sm font-medium text-brand-600 dark:text-accent-400">
      <a href={withBase('/araclar')} class="hover:underline">Araçlar</a>
      <span class="text-slate-400 dark:text-slate-600"> / </span>
      <span>Çizelgeleme</span>
    </p>
    <h1 class="mt-2 max-w-3xl font-display text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl lg:text-5xl dark:text-white">
      {tool.title}
    </h1>
    <p class="mt-4 max-w-2xl text-base leading-relaxed text-slate-600 sm:text-lg dark:text-slate-400">
      Tablo başlığındaki <strong>+</strong> ile hemşire ekle; hücreye tıklayıp <strong>Yİ</strong>
      seçerek yıllık izin işaretle. Sol panelden tatil günlerini ve kapsama kurallarını ayarla,
      tek tuşla tüm ayın vardiya planını dolsun. Vardiyalar: 8 gündüz (08-16), 16 gece (16-08),
      24 nöbet (00-24). İhlaller canlı vurgulanır.
      {guideHref && (
        <a
          href={guideHref}
          class="font-medium text-brand-600 hover:text-brand-700 dark:text-accent-400 dark:hover:text-accent-300"
        > Rehbere git →</a>
      )}
    </p>
  </Container>

  <Container as="div" size="wide" class="grid gap-6 py-10 sm:py-12 lg:grid-cols-[320px_minmax(0,1fr)] print:block !max-w-[1600px]">
    {/* ------------------------------------------------------------ FORM */}
    <form id="ns-form" class="space-y-6 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900/40 print:hidden" novalidate>
      <div class="flex flex-wrap gap-2">
        <button type="button" id="sample-btn" class="inline-flex items-center gap-1.5 rounded-md border border-slate-300 bg-white px-3 py-1.5 text-xs font-medium text-slate-700 hover:border-slate-400 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800">
          Örnek doldur
        </button>
        <button type="button" id="reset-btn" class="inline-flex items-center gap-1.5 rounded-md border border-transparent bg-transparent px-3 py-1.5 text-xs font-medium text-slate-600 hover:bg-slate-100 dark:text-slate-400 dark:hover:bg-slate-800">
          Sıfırla
        </button>
      </div>

      <div class="space-y-2">
        <button type="button" id="solve-greedy-btn" class="inline-flex w-full items-center justify-center gap-2 rounded-lg bg-brand-700 px-4 py-2.5 text-sm font-semibold text-white hover:bg-brand-800 disabled:cursor-not-allowed disabled:opacity-60 dark:bg-accent-500 dark:text-brand-950 dark:hover:bg-accent-400">
          <span id="solve-greedy-label">Otomatik doldur</span>
        </button>
        <button type="button" id="solve-ilp-btn" class="inline-flex w-full items-center justify-center gap-2 rounded-lg border border-brand-700 bg-white px-4 py-2.5 text-sm font-semibold text-brand-700 hover:bg-brand-50 disabled:cursor-not-allowed disabled:opacity-60 dark:border-accent-500 dark:bg-transparent dark:text-accent-400 dark:hover:bg-slate-800">
          <span id="solve-ilp-label">Optimum çöz (ILP)</span>
        </button>
        <p class="text-xs text-slate-500 dark:text-slate-400">
          <strong>Otomatik doldur</strong> hızlı, sezgisel. <strong>Optimum çöz</strong> ILP
          ile saatleri eşitlemeye çalışır (1-5 sn).
        </p>
      </div>

      <fieldset class="space-y-3">
        <legend class="font-display text-sm font-semibold text-slate-900 dark:text-white">
          Plan dönemi
        </legend>
        <div class="grid grid-cols-2 gap-3">
          <label class="block">
            <span class="text-xs font-medium text-slate-700 dark:text-slate-300">Ay</span>
            <select id="month-select" class="mt-1 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100">
              {TR_MONTHS.map((m, i) => (
                <option value={i + 1}>{m}</option>
              ))}
            </select>
          </label>
          <label class="block">
            <span class="text-xs font-medium text-slate-700 dark:text-slate-300">Yıl</span>
            <input type="number" id="year-input" min="2020" max="2099" step="1"
              class="mt-1 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100" />
          </label>
        </div>
      </fieldset>

      <fieldset class="space-y-3">
        <div class="flex items-center justify-between">
          <legend class="font-display text-sm font-semibold text-slate-900 dark:text-white">
            Resmi tatiller
          </legend>
          <span id="holiday-count" class="text-xs text-slate-500 dark:text-slate-400">0 gün</span>
        </div>
        <p class="text-xs text-slate-500 dark:text-slate-400">
          Bayram ve resmi tatil günlerini takvimden tıklayarak işaretle. Bu günler için ayrı kapsama sayıları geçerli olur.
        </p>
        <div id="holiday-grid" class="ns-day-grid"></div>
      </fieldset>

      <fieldset class="space-y-3">
        <legend class="font-display text-sm font-semibold text-slate-900 dark:text-white">
          Kapsama kuralları
        </legend>
        <div class="grid grid-cols-3 gap-x-2 gap-y-2 rounded-lg border border-slate-200 bg-slate-50/40 p-3 dark:border-slate-800 dark:bg-slate-900/20">
          <div></div>
          <div class="text-center text-xs font-medium text-slate-600 dark:text-slate-400">Gündüz</div>
          <div class="text-center text-xs font-medium text-slate-600 dark:text-slate-400">Gece</div>
          <label class="self-center text-xs font-medium text-slate-700 dark:text-slate-300">Hafta içi</label>
          <input type="number" id="con-min-day-wd" min="0" max="20" step="1"
            class="block w-full rounded border border-slate-300 bg-white px-2 py-1 text-sm text-center text-slate-900 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100" />
          <input type="number" id="con-min-night-wd" min="0" max="20" step="1"
            class="block w-full rounded border border-slate-300 bg-white px-2 py-1 text-sm text-center text-slate-900 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100" />
          <label class="self-center text-xs font-medium text-slate-700 dark:text-slate-300">Hafta sonu</label>
          <input type="number" id="con-min-day-we" min="0" max="20" step="1"
            class="block w-full rounded border border-slate-300 bg-white px-2 py-1 text-sm text-center text-slate-900 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100" />
          <input type="number" id="con-min-night-we" min="0" max="20" step="1"
            class="block w-full rounded border border-slate-300 bg-white px-2 py-1 text-sm text-center text-slate-900 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100" />
          <label class="self-center text-xs font-medium text-slate-700 dark:text-slate-300">Tatil</label>
          <input type="number" id="con-min-day-hol" min="0" max="20" step="1"
            class="block w-full rounded border border-slate-300 bg-white px-2 py-1 text-sm text-center text-slate-900 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100" />
          <input type="number" id="con-min-night-hol" min="0" max="20" step="1"
            class="block w-full rounded border border-slate-300 bg-white px-2 py-1 text-sm text-center text-slate-900 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100" />
        </div>
        <div class="grid grid-cols-2 gap-2">
          <label class="block">
            <span class="text-xs font-medium text-slate-700 dark:text-slate-300">Nöbet sonrası boş (gün)</span>
            <input type="number" id="con-rest" min="0" max="7" step="1"
              class="mt-1 block w-full rounded border border-slate-300 bg-white px-2 py-1.5 text-sm text-slate-900 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100" />
          </label>
          <label class="block">
            <span class="text-xs font-medium text-slate-700 dark:text-slate-300">Gece sonrası boş (gün)</span>
            <input type="number" id="con-rest-eve" min="0" max="7" step="1"
              class="mt-1 block w-full rounded border border-slate-300 bg-white px-2 py-1.5 text-sm text-slate-900 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100" />
          </label>
        </div>
        <label class="flex cursor-pointer items-center gap-2 rounded-lg border border-slate-200 bg-white p-2.5 has-[:checked]:border-emerald-500 has-[:checked]:bg-emerald-50 dark:border-slate-800 dark:bg-slate-900/40 dark:has-[:checked]:border-emerald-500 dark:has-[:checked]:bg-slate-900">
          <input type="checkbox" id="con-prefer-evening" class="size-4 rounded border-slate-300 text-emerald-600 focus:ring-emerald-500" />
          <span class="text-xs text-slate-700 dark:text-slate-300">
            <strong>Zorunda kalmadıkça nöbet yazma</strong> — gece kapsama önce 16h gece vardiyası ile doldurulur, 24h nöbet son çare
          </span>
        </label>
        <label class="flex cursor-pointer items-center gap-2 rounded-lg border border-slate-200 bg-white p-2.5 has-[:checked]:border-amber-500 has-[:checked]:bg-amber-50 dark:border-slate-800 dark:bg-slate-900/40 dark:has-[:checked]:border-amber-500 dark:has-[:checked]:bg-slate-900">
          <input type="checkbox" id="con-allow-single" class="size-4 rounded border-slate-300 text-amber-600 focus:ring-amber-500" />
          <span class="text-xs text-slate-700 dark:text-slate-300">
            <strong>Tek nöbet kabul</strong> — liste dönmüyorsa gece 1 hemşire de yeterli (yumuşak uyarı)
          </span>
        </label>
      </fieldset>
    </form>

    {/* ------------------------------------------------------------ IZGARA */}
    <div class="space-y-6 min-w-0 print:px-0">
      <div id="tutorial-banner" class="ns-tutorial print:hidden" role="region" aria-label="Nasıl kullanılır">
        <button type="button" id="tutorial-close" class="ns-tutorial-close" aria-label="Kapat">×</button>
        <h2 class="font-display text-base font-semibold text-slate-900 dark:text-white">
          👋 Dört adımda hemşire vardiya planı kur
        </h2>
        <ol class="mt-3 space-y-1.5 text-sm text-slate-700 dark:text-slate-300">
          <li>
            <strong class="text-brand-700 dark:text-accent-400">1.</strong>
            Tablonun başlığındaki <strong>+</strong> butonuna basarak <strong>hemşireleri ekle</strong>.
            Yıllık izin günlerini hücreye tıklayıp menüden <strong>Yİ</strong> seçerek işaretle.
          </li>
          <li>
            <strong class="text-brand-700 dark:text-accent-400">2.</strong>
            Hafta içi ve hafta sonu için ayrı <strong>min gündüz / min gece</strong>
            sayılarını ayarla. Vardiyalar: <kbd class="ns-kbd">8</kbd> Gündüz 08-16,
            <kbd class="ns-kbd">16</kbd> Gece 16-08, <kbd class="ns-kbd">24</kbd> Nöbet 00-24.
          </li>
          <li>
            <strong class="text-brand-700 dark:text-accent-400">3.</strong>
            "<strong>Otomatik doldur</strong>" — ızgarayı saniyenin altında dolduran sezgisel.
            Daha sonra "<strong>Optimum çöz (ILP)</strong>" ile saatleri eşitle.
            Boş hücre kalmaz; çalışılmayan günler <strong>DN</strong> (dinlenme) olarak işaretlenir.
          </li>
          <li>
            <strong class="text-brand-700 dark:text-accent-400">4.</strong>
            Bir hücreye <strong>tıkla</strong>: vardiya seçim menüsü. Klavye:
            <kbd class="ns-kbd">8</kbd> gündüz,
            <kbd class="ns-kbd">G</kbd> gece (16),
            <kbd class="ns-kbd">N</kbd> nöbet,
            <kbd class="ns-kbd">D</kbd> dinlenme,
            <kbd class="ns-kbd">Y</kbd> yıllık izin,
            <kbd class="ns-kbd">R</kbd> rapor,
            <kbd class="ns-kbd">L</kbd> kilitle,
            ok tuşları ile dolaş, <kbd class="ns-kbd">Esc</kbd> popover kapat.
          </li>
        </ol>
        <p class="mt-3 text-xs text-slate-500 dark:text-slate-400">
          Tüm veri yalnız tarayıcında kalır — sunucuya gönderilmez.
          {guideHref && (
            <a href={guideHref} class="ml-1 font-medium text-brand-600 hover:underline dark:text-accent-400">Detaylı rehbere git →</a>
          )}
        </p>
      </div>

      <div class="flex items-center justify-end print:hidden">
        <button type="button" id="tutorial-toggle" class="inline-flex items-center gap-1 rounded-md border border-slate-300 bg-white px-2.5 py-1 text-xs font-medium text-slate-700 hover:border-slate-400 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800">
          <span aria-hidden="true">?</span> Nasıl kullanılır
        </button>
      </div>

      <div id="solver-status" class="hidden rounded-lg border px-4 py-3 text-sm" role="status" aria-live="polite"></div>
      <div id="solver-error" class="hidden rounded-lg border border-red-300 bg-red-50 px-4 py-3 text-sm text-red-800 dark:border-red-800 dark:bg-red-900/30 dark:text-red-200" role="alert"></div>

      <div id="legend" class="flex flex-wrap gap-2 text-xs print:hidden">
        <span class="ns-legend"><span class="ns-swatch" data-shift="G8"></span>8 — Gündüz (08-16)</span>
        <span class="ns-legend"><span class="ns-swatch" data-shift="GC16"></span>16 — Gece (16-08)</span>
        <span class="ns-legend"><span class="ns-swatch" data-shift="N24"></span>24 — Nöbet (00-24)</span>
        <span class="ns-legend"><span class="ns-swatch" data-shift="DN"></span>DN — Dinlenme</span>
        <span class="ns-legend"><span class="ns-swatch" data-shift="YI"></span>Yİ — Yıllık izin</span>
        <span class="ns-legend"><span class="ns-swatch" data-shift="RP"></span>RP — Rapor</span>
      </div>

      <div class="ns-table-wrap overflow-x-auto rounded-2xl border border-slate-200 bg-white p-2 shadow-sm dark:border-slate-800 dark:bg-slate-900/40 print:overflow-visible print:p-0 print:shadow-none">
        <table id="schedule-table" class="ns-table"></table>
      </div>

      <div id="issues-block" class="hidden rounded-2xl border border-amber-300 bg-amber-50 p-4 text-sm dark:border-amber-800 dark:bg-amber-900/20 print:hidden">
        <h2 class="mb-2 font-display font-semibold text-amber-900 dark:text-amber-200">İhlaller</h2>
        <ul id="issues-list" class="space-y-1 text-amber-900 dark:text-amber-100"></ul>
      </div>

      <div>
        <h2 class="mb-3 font-display text-base font-semibold text-slate-900 dark:text-white">
          Hemşire başına aylık özet
        </h2>
        <div id="stats-grid" class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3"></div>
      </div>

      <div class="flex flex-wrap gap-2 print:hidden">
        <button type="button" id="export-csv-btn" class="inline-flex items-center gap-1.5 rounded-md border border-slate-300 bg-white px-3 py-1.5 text-xs font-medium text-slate-700 hover:border-slate-400 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800">
          CSV indir
        </button>
        <button type="button" id="print-btn" class="inline-flex items-center gap-1.5 rounded-md border border-slate-300 bg-white px-3 py-1.5 text-xs font-medium text-slate-700 hover:border-slate-400 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800">
          Yazdır
        </button>
      </div>

      {guideHref && (
        <a href={guideHref} class="block rounded-2xl border border-slate-200 bg-white p-5 hover:border-brand-300 hover:shadow-sm dark:border-slate-800 dark:bg-slate-900/40 dark:hover:border-accent-500 print:hidden">
          <p class="text-xs font-medium text-brand-600 dark:text-accent-400">Konuyu derinleştir</p>
          <p class="mt-1 font-display text-sm font-semibold text-slate-900 dark:text-white">
            Hemşire vardiya planlamada kurallar ve adillik →
          </p>
        </a>
      )}
    </div>
  </Container>

  <div id="cell-popover" class="ns-popover hidden" role="menu" aria-label="Vardiya seç">
    <div class="ns-popover-header">
      <span class="ns-popover-title" id="popover-title">Vardiya seç</span>
      <button type="button" id="popover-close-btn" class="ns-popover-close" aria-label="Kapat (Esc)" title="Kapat (Esc)">×</button>
    </div>
    <div class="ns-popover-grid">
      <button type="button" data-shift="G8">8 <span class="ns-shortcut">8</span></button>
      <button type="button" data-shift="GC16">16 <span class="ns-shortcut">G</span></button>
      <button type="button" data-shift="N24">24 <span class="ns-shortcut">N</span></button>
      <button type="button" data-shift="DN">DN <span class="ns-shortcut">D</span></button>
      <button type="button" data-shift="YI">Yİ <span class="ns-shortcut">Y</span></button>
      <button type="button" data-shift="RP">RP <span class="ns-shortcut">R</span></button>
      <button type="button" data-action="toggle-pin" data-shortcut="L">Kilitle <span class="ns-shortcut">L</span></button>
    </div>
  </div>
</BaseLayout>

<style is:global>
  /* CSS değişkenleri ile light/dark renk paleti */
  :root {
    --ns-G8-bg: rgb(224 242 254);
    --ns-G8-fg: rgb(7 89 133);
    --ns-GC16-bg: rgb(224 231 255);
    --ns-GC16-fg: rgb(49 46 129);
    --ns-N24-bg: rgb(255 228 230);
    --ns-N24-fg: rgb(159 18 57);
    --ns-DN-bg: rgb(220 252 231);
    --ns-DN-fg: rgb(6 95 70);
    --ns-YI-bg: rgb(237 233 254);
    --ns-YI-fg: rgb(91 33 182);
    --ns-RP-bg: rgb(226 232 240);
    --ns-RP-fg: rgb(51 65 85);
    --ns-weekend-bg: rgb(248 250 252);
    --ns-holiday-bg: rgb(254 243 199);
    --ns-grid-border: rgb(226 232 240);
  }

  .dark {
    --ns-G8-bg: rgb(12 74 110 / 0.45);
    --ns-G8-fg: rgb(186 230 253);
    --ns-GC16-bg: rgb(49 46 129 / 0.55);
    --ns-GC16-fg: rgb(199 210 254);
    --ns-N24-bg: rgb(159 18 57 / 0.45);
    --ns-N24-fg: rgb(254 205 211);
    --ns-DN-bg: rgb(6 95 70 / 0.35);
    --ns-DN-fg: rgb(167 243 208);
    --ns-YI-bg: rgb(91 33 182 / 0.35);
    --ns-YI-fg: rgb(216 180 254);
    --ns-RP-bg: rgb(30 41 59);
    --ns-RP-fg: rgb(148 163 184);
    --ns-weekend-bg: rgb(15 23 42);
    --ns-holiday-bg: rgb(120 53 15 / 0.4);
    --ns-grid-border: rgb(30 41 59);
  }

  .ns-table {
    border-collapse: collapse;
    font-size: 0.72rem;
    table-layout: fixed;
    margin: 0 auto;
    /* Her zaman içerik kadar geniş; container darsa overflow-x-auto kaydırır */
    min-width: max-content;
  }
  /* Geniş ekranda container'ın tamamını kullansın (1024+) */
  @media (min-width: 1024px) {
    .ns-table {
      width: 100%;
    }
  }
  /* Tablo container'ı mobile'de mask ile sağ kenarda fade — yatay kaydırma cue */
  @media (max-width: 1023px) {
    .ns-table-wrap {
      -webkit-mask-image: linear-gradient(to right, black 0, black calc(100% - 14px), transparent 100%);
      mask-image: linear-gradient(to right, black 0, black calc(100% - 14px), transparent 100%);
    }
  }
  .ns-table th, .ns-table td {
    border: 1px solid var(--ns-grid-border);
    padding: 0;
    text-align: center;
    vertical-align: middle;
    height: 26px;
    font-variant-numeric: tabular-nums;
  }
  .ns-table thead th {
    font-weight: 600;
    background: rgb(248 250 252);
    color: rgb(15 23 42);
    height: 32px;
    padding: 0 2px;
    font-size: 0.74rem;
  }
  .dark .ns-table thead th {
    background: rgb(15 23 42);
    color: rgb(241 245 249);
  }
  .ns-table th.ns-row-name {
    text-align: left;
    padding: 0 6px;
    background: rgb(248 250 252);
    color: rgb(15 23 42);
    font-weight: 500;
    font-size: 0.78rem;
    width: 120px;
    min-width: 100px;
  }
  .dark .ns-table th.ns-row-name {
    background: rgb(15 23 42);
    color: rgb(241 245 249);
  }
  .ns-table th[data-nurse-header] {
    position: relative;
    padding: 0 28px 0 6px;
    height: 32px;
  }
  .ns-table th[data-nurse-header] > span {
    display: inline-block;
    vertical-align: middle;
    line-height: 32px;
  }
  .ns-table th[data-nurse-header] > .ns-add-btn {
    position: absolute;
    right: 4px;
    top: 50%;
