  .dark .ns-icon-btn {
    background: rgb(2 6 23);
    color: rgb(148 163 184);
  }
  .ns-icon-btn:hover {
    background: rgb(241 245 249);
  }
  .dark .ns-icon-btn:hover {
    background: rgb(30 41 59);
  }
  .ns-day-grid {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 2px;
  }
  .ns-day-grid button {
    padding: 3px 0;
    border-radius: 3px;
    border: 1px solid var(--ns-grid-border);
    background: white;
    font-size: 0.68rem;
    cursor: pointer;
    color: rgb(71 85 105);
  }
  .dark .ns-day-grid button {
    background: rgb(2 6 23);
    color: rgb(148 163 184);
  }
  .ns-day-grid button.ns-day-active {
    background: var(--ns-YI-bg);
    color: var(--ns-YI-fg);
    border-color: var(--ns-YI-fg);
    font-weight: 600;
  }

  /* Stats card */
  .ns-stats-card {
    border: 1px solid var(--ns-grid-border);
    border-radius: 12px;
    padding: 12px;
    background: white;
  }
  .dark .ns-stats-card {
    background: rgb(15 23 42 / 0.4);
  }

  /* Print: keep colors */
  @media print {
    .ns-table { font-size: 0.65rem; }
    .ns-table td.ns-cell { height: 22px; }
    [data-shift] { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  }
</style>

<script>
  import {
    DEFAULT_CONSTRAINTS,
    cellKey,
    computeStats,
    createMonthMeta,
    solveScheduleGreedy,
    solveScheduleILP,
    validate,
    buildSampleSchedule,
    type Nurse,
    type Schedule,
    type ScheduleConstraints,
    type ShiftCode,
  } from '../../lib/nurse-schedule';

  const STORAGE_KEY = 'nurse-schedule-v1';
  const TUTORIAL_KEY = 'nurse-schedule-tutorial-dismissed-v1';
  const TR_DAYS = ['Pzt', 'Sal', 'Çar', 'Per', 'Cum', 'Cmt', 'Paz'];

  const $ = <T extends HTMLElement = HTMLElement>(id: string): T => {
    const el = document.getElementById(id);
    if (!el) throw new Error(`Element not found: ${id}`);
    return el as T;
  };

  function escapeHtml(s: string): string {
    return s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));
  }

  function uniqueId(): string {
    return 'n_' + Math.random().toString(36).slice(2, 8) + Date.now().toString(36).slice(-3);
  }

  function defaultSchedule(): Schedule {
    const now = new Date();
    return buildSampleSchedule(now.getFullYear(), now.getMonth() + 1);
  }

  function normalize(raw: unknown): Schedule | null {
    if (!raw || typeof raw !== 'object') return null;
    const o = raw as Record<string, unknown>;
    const meta = o.meta as Record<string, unknown> | undefined;
    if (!meta || typeof meta.year !== 'number' || typeof meta.month !== 'number') return null;
    const year = Math.round(meta.year);
    const month = Math.round(meta.month);
    if (month < 1 || month > 12 || year < 2000 || year > 2100) return null;
    const constraints: ScheduleConstraints = { ...DEFAULT_CONSTRAINTS, ...(o.constraints as object || {}) };
    constraints.minDayPresent = Math.max(0, Math.round(constraints.minDayPresent));
    constraints.minEveningPresent = Math.max(0, Math.round(constraints.minEveningPresent));
    constraints.minNightPresent = Math.max(0, Math.round(constraints.minNightPresent));
    constraints.restAfterNight = Math.max(0, Math.min(7, Math.round(constraints.restAfterNight)));
    constraints.weekendReduced = Boolean(constraints.weekendReduced);
    constraints.allowSingleNight = Boolean(constraints.allowSingleNight);
    const nursesRaw = Array.isArray(o.nurses) ? o.nurses : [];
    const nurses: Nurse[] = nursesRaw.flatMap((n: unknown) => {
      if (!n || typeof n !== 'object') return [];
      const obj = n as Record<string, unknown>;
      const id = typeof obj.id === 'string' && obj.id.length > 0 ? obj.id : uniqueId();
      const name = typeof obj.name === 'string' ? obj.name : '';
      const unavailable = Array.isArray(obj.unavailable)
        ? obj.unavailable.filter((d): d is number => typeof d === 'number' && d >= 1 && d <= 31).map((d) => Math.round(d))
        : [];
      const notes = typeof obj.notes === 'string' ? obj.notes : undefined;
      return [{ id, name, unavailable, notes }];
    });
    const cells: Record<string, ShiftCode> = {};
    const validShifts: ShiftCode[] = ['OFF', 'D8', 'E16', 'N24', 'YI', 'RT', 'NI'];
    const cellsRaw = (o.cells as Record<string, unknown>) || {};
    for (const [k, v] of Object.entries(cellsRaw)) {
      if (typeof v !== 'string') continue;
      if (!validShifts.includes(v as ShiftCode)) continue;
      cells[k] = v as ShiftCode;
    }
    const pinned: Record<string, true> = {};
    const pinnedRaw = (o.pinned as Record<string, unknown>) || {};
    for (const [k, v] of Object.entries(pinnedRaw)) {
      if (v === true) pinned[k] = true;
    }
    return {
      meta: createMonthMeta(year, month),
      nurses,
      cells,
      pinned,
      constraints,
    };
  }

  function loadState(): Schedule {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (raw) {
        const parsed = JSON.parse(raw);
        const norm = normalize(parsed);
        if (norm) return norm;
      }
    } catch {
      /* ignore */
    }
    return defaultSchedule();
  }

  function saveState(): void {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
    } catch {
      /* ignore */
    }
  }

  let state: Schedule = loadState();

  /* --------------------------------------------------------- DOM cache */
  const monthSelect = $<HTMLSelectElement>('month-select');
  const yearInput = $<HTMLInputElement>('year-input');
  const nurseList = $<HTMLUListElement>('nurse-list');
  const nurseCount = $('nurse-count');
  const nurseNameInput = $<HTMLInputElement>('nurse-name-input');
  const nurseAddBtn = $<HTMLButtonElement>('nurse-add-btn');
  const sampleBtn = $<HTMLButtonElement>('sample-btn');
  const resetBtn = $<HTMLButtonElement>('reset-btn');
  const solveGreedyBtn = $<HTMLButtonElement>('solve-greedy-btn');
  const solveIlpBtn = $<HTMLButtonElement>('solve-ilp-btn');
  const solveGreedyLabel = $('solve-greedy-label');
  const solveIlpLabel = $('solve-ilp-label');
  const solverStatus = $('solver-status');
  const solverError = $('solver-error');
  const scheduleTable = $<HTMLTableElement>('schedule-table');
  const issuesBlock = $('issues-block');
  const issuesList = $('issues-list');
  const statsGrid = $('stats-grid');
  const exportCsvBtn = $<HTMLButtonElement>('export-csv-btn');
  const printBtn = $<HTMLButtonElement>('print-btn');
  const popover = $('cell-popover');
  const popoverCloseBtn = $<HTMLButtonElement>('popover-close-btn');
  const popoverTitle = $('popover-title');
  const tutorialBanner = $('tutorial-banner');
  const tutorialCloseBtn = $<HTMLButtonElement>('tutorial-close');
  const tutorialToggleBtn = $<HTMLButtonElement>('tutorial-toggle');

  const conMinDay = $<HTMLInputElement>('con-min-day');
  const conMinEve = $<HTMLInputElement>('con-min-eve');
  const conMinNight = $<HTMLInputElement>('con-min-night');
  const conRest = $<HTMLInputElement>('con-rest');
  const conWeekendReduced = $<HTMLInputElement>('con-weekend-reduced');
  const conAllowSingle = $<HTMLInputElement>('con-allow-single');

  /* --------------------------------------------------------- Render: form */

  function renderForm(): void {
    monthSelect.value = String(state.meta.month);
    yearInput.value = String(state.meta.year);
    conMinDay.value = String(state.constraints.minDayPresent);
    conMinEve.value = String(state.constraints.minEveningPresent);
    conMinNight.value = String(state.constraints.minNightPresent);
    conRest.value = String(state.constraints.restAfterNight);
    conWeekendReduced.checked = state.constraints.weekendReduced;
    conAllowSingle.checked = state.constraints.allowSingleNight;
    nurseCount.textContent = `${state.nurses.length} hemşire`;

    nurseList.innerHTML = state.nurses.map(renderNurseCard).join('');
  }

  function renderNurseCard(nurse: Nurse): string {
    const D = state.meta.daysInMonth;
    const dayBtns = Array.from({ length: D }, (_, i) => {
      const d = i + 1;
      const active = nurse.unavailable.includes(d);
      return `<button type="button" data-nurse="${nurse.id}" data-day="${d}" class="${active ? 'ns-day-active' : ''}" title="Gün ${d}: ${active ? 'izinli' : 'müsait'}">${d}</button>`;
    }).join('');
    return `
      <li class="ns-nurse-card" data-nurse-card="${nurse.id}">
        <div class="ns-nurse-row">
          <input type="text" class="ns-nurse-name" data-nurse-name="${nurse.id}" value="${escapeHtml(nurse.name)}" maxlength="40" />
          <button type="button" class="ns-icon-btn" data-toggle-leaves="${nurse.id}">İzinler ${nurse.unavailable.length > 0 ? `(${nurse.unavailable.length})` : ''}</button>
          <button type="button" class="ns-icon-btn" data-remove-nurse="${nurse.id}" title="Hemşireyi sil">×</button>
        </div>
        <div class="ns-day-grid hidden" data-leaves-grid="${nurse.id}">${dayBtns}</div>
      </li>`;
  }

  /* --------------------------------------------------------- Render: grid */

  const SHIFT_LABEL: Record<ShiftCode, string> = {
    OFF: '',
    D8: '8',
    E16: '16',
    N24: '24',
    YI: 'Yİ',
    RT: 'RT',
    NI: 'Nİ',
  };

  function renderGrid(): void {
    const D = state.meta.daysInMonth;
    const weekendSet = new Set(state.meta.weekendDays);
    const issues = validate(state);
    const violationCells = new Set<string>();
    const violationDays = new Map<number, string>();
    for (const issue of issues) {
      if (issue.severity === 'error') {
        if (issue.nurseId) violationCells.add(`${issue.nurseId}:${issue.day}`);
        const existing = violationDays.get(issue.day);
        violationDays.set(issue.day, existing ? existing + '\n' + issue.message : issue.message);
      }
    }

    // Header row
    const headCells = Array.from({ length: D }, (_, i) => {
      const d = i + 1;
      const dow = new Date(state.meta.year, state.meta.month - 1, d).getDay();
      const dayLabel = TR_DAYS[(dow + 6) % 7]; // map JS Sun=0 → Pzr at end
      const isWeekend = weekendSet.has(d);
      const cls = isWeekend ? 'ns-weekend' : '';
      return `<th class="${cls}" data-day-header="${d}"><div>${d}</div><div style="font-weight:400; font-size: 0.65rem; opacity: 0.7;">${dayLabel}</div></th>`;
    }).join('');
    const headRow = `<tr><th class="ns-row-name">Hemşire</th>${headCells}<th class="ns-row-name" style="text-align:right;">Aylık</th></tr>`;

    // Nurse rows
    const stats = computeStats(state);
    const rows = state.nurses.map((nurse) => {
      const cells = Array.from({ length: D }, (_, i) => {
        const d = i + 1;
        const k = cellKey(nurse.id, d);
        const code = state.cells[k] ?? 'OFF';
        const isPinned = !!state.pinned[k];
        const isWeekend = weekendSet.has(d);
        const isViolation = violationCells.has(k);
        const cls = [
          'ns-cell',
          isWeekend ? 'ns-weekend' : '',
          isPinned ? 'ns-pinned' : '',
          isViolation ? 'ns-violation' : '',
        ].filter(Boolean).join(' ');
        const shiftAttr = code === 'OFF' ? '' : `data-shift="${code}"`;
        const tabIndex = 'tabindex="0"';
        return `<td class="${cls}" ${shiftAttr} data-nurse="${nurse.id}" data-day="${d}" ${tabIndex} title="${escapeHtml(nurse.name)} • ${d}. gün • ${SHIFT_LABEL[code] || 'Boş'}">${SHIFT_LABEL[code]}</td>`;
      }).join('');
      const counts = stats.countsByNurse[nurse.id] || { OFF: 0, D8: 0, E16: 0, N24: 0, YI: 0, RT: 0, NI: 0 };
      const total = stats.hoursByNurse[nurse.id] ?? 0;
      const summary = `${total}sa · N${counts.N24} · 8×${counts.D8}${counts.E16 ? ' · 16×' + counts.E16 : ''}`;
      return `<tr><th class="ns-row-name" title="${escapeHtml(nurse.name)}">${escapeHtml(nurse.name)}</th>${cells}<td class="ns-row-total" title="Aylık toplam: ${total} saat">${summary}</td></tr>`;
    }).join('');

    // Daily summary row
    const summaryCells = Array.from({ length: D }, (_, i) => {
      const d = i + 1;
      const isWeekend = weekendSet.has(d);
      let dayCount = 0, eveCount = 0, nightCount = 0;
      for (const nurse of state.nurses) {
        const c = state.cells[cellKey(nurse.id, d)] ?? 'OFF';
        if (c === 'D8' || c === 'N24') dayCount++;
        if (c === 'E16' || c === 'N24') eveCount++;
        if (c === 'N24') nightCount++;
      }
      const reduceDay = isWeekend && state.constraints.weekendReduced;
      const minDay = reduceDay ? state.constraints.minNightPresent : state.constraints.minDayPresent;
      const minNight = state.constraints.allowSingleNight ? 1 : state.constraints.minNightPresent;
      const dayBad = dayCount < minDay;
      const nightBad = nightCount < minNight;
      const overallBad = dayBad || nightBad;
      const cls = `ns-summary ${isWeekend ? 'ns-weekend' : ''} ${overallBad ? 'ns-summary-bad' : 'ns-summary-ok'}`;
      const tooltip = `Gün ${d}: gündüz ${dayCount}/${minDay} · gece ${nightCount}/${minNight}${eveCount ? ' · akşam ' + eveCount : ''}`;
      return `<td class="${cls}" title="${escapeHtml(tooltip)}">${nightCount}/${dayCount}</td>`;
    }).join('');
    const summaryRow = `<tr><td class="ns-row-name" style="font-size: 0.7rem; font-weight:600;">Gece/Gündüz</td>${summaryCells}<td class="ns-row-total"></td></tr>`;

    scheduleTable.innerHTML = `<thead>${headRow}</thead><tbody>${rows}${summaryRow}</tbody>`;
  }

  /* ---------------------------------------------------- Render: issues */

  function renderIssues(): void {
    const issues = validate(state);
    if (issues.length === 0) {
      issuesBlock.classList.add('hidden');
      issuesList.innerHTML = '';
      return;
    }
    issuesBlock.classList.remove('hidden');
    const items = issues
      .slice(0, 30)
      .map((i) => `<li>${i.severity === 'warning' ? '⚠' : '✗'} ${escapeHtml(i.message)}</li>`)
      .join('');
    const more = issues.length > 30 ? `<li>… ve ${issues.length - 30} ihlal daha</li>` : '';
    issuesList.innerHTML = items + more;
  }

  /* ---------------------------------------------------- Render: stats */

  function renderStats(): void {
    const stats = computeStats(state);
    const totalHours = Object.values(stats.hoursByNurse).reduce((a, b) => a + b, 0);
    const avg = state.nurses.length > 0 ? totalHours / state.nurses.length : 0;
    const cards = state.nurses.map((nurse) => {
      const h = stats.hoursByNurse[nurse.id] ?? 0;
      const c = stats.countsByNurse[nurse.id] || { OFF: 0, D8: 0, E16: 0, N24: 0, YI: 0, RT: 0, NI: 0 };
      const diff = h - avg;
      const diffStr = diff > 0 ? `+${Math.round(diff)}` : Math.round(diff);
      return `
        <div class="ns-stats-card">
          <div class="flex items-center justify-between">
            <span class="text-sm font-semibold text-slate-900 dark:text-white">${escapeHtml(nurse.name)}</span>
            <span class="text-xs text-slate-500 dark:text-slate-400">${diffStr} sa ortalamaya göre</span>
          </div>
          <div class="mt-2 text-2xl font-display font-bold text-slate-900 dark:text-white">${h} <span class="text-sm font-normal text-slate-500">saat</span></div>
          <div class="mt-2 grid grid-cols-3 gap-2 text-xs">
            <span class="rounded bg-slate-100 dark:bg-slate-800 px-2 py-1"><strong>${c.N24}</strong> nöbet</span>
            <span class="rounded bg-slate-100 dark:bg-slate-800 px-2 py-1"><strong>${c.D8}</strong> sabah</span>
            ${c.E16 > 0 ? `<span class="rounded bg-slate-100 dark:bg-slate-800 px-2 py-1"><strong>${c.E16}</strong> akşam</span>` : ''}
            ${c.YI > 0 ? `<span class="rounded bg-slate-100 dark:bg-slate-800 px-2 py-1"><strong>${c.YI}</strong> yıllık</span>` : ''}
            ${c.RT > 0 ? `<span class="rounded bg-slate-100 dark:bg-slate-800 px-2 py-1"><strong>${c.RT}</strong> rapor</span>` : ''}
            ${c.NI > 0 ? `<span class="rounded bg-slate-100 dark:bg-slate-800 px-2 py-1"><strong>${c.NI}</strong> dinlenme</span>` : ''}
          </div>
        </div>`;
    }).join('');
    statsGrid.innerHTML = cards || `<p class="text-sm text-slate-500 dark:text-slate-400">Önce hemşire ekleyin.</p>`;
  }

  /* ---------------------------------------------------- Render: orchestrate */

  function renderAll(): void {
    renderForm();
    renderGrid();
    renderIssues();
    renderStats();
  }

  function commit(): void {
    saveState();
    renderAll();
  }

  /* ---------------------------------------------------- Status helpers */

  function setStatus(msg: string, kind: 'info' | 'success' | 'warn' = 'info'): void {
    const colors: Record<string, string> = {
      info: 'border-slate-300 bg-slate-50 text-slate-800 dark:border-slate-700 dark:bg-slate-900/40 dark:text-slate-200',
      success: 'border-emerald-300 bg-emerald-50 text-emerald-900 dark:border-emerald-800 dark:bg-emerald-900/30 dark:text-emerald-200',
      warn: 'border-amber-300 bg-amber-50 text-amber-900 dark:border-amber-800 dark:bg-amber-900/30 dark:text-amber-200',
    };
    solverStatus.className = `rounded-lg border px-4 py-3 text-sm ${colors[kind]}`;
    solverStatus.textContent = msg;
    solverStatus.classList.remove('hidden');
  }

  function clearStatus(): void {
    solverStatus.classList.add('hidden');
    solverError.classList.add('hidden');
  }

  function setError(msg: string): void {
    solverError.textContent = msg;
    solverError.classList.remove('hidden');
  }

  /* ---------------------------------------------------- Form events */

  monthSelect.addEventListener('change', () => {
    const m = Math.max(1, Math.min(12, parseInt(monthSelect.value, 10) || 1));
    state.meta = createMonthMeta(state.meta.year, m);
    pruneOutOfRangeData();
    commit();
  });
  yearInput.addEventListener('change', () => {
    const y = Math.max(2020, Math.min(2099, parseInt(yearInput.value, 10) || new Date().getFullYear()));
    state.meta = createMonthMeta(y, state.meta.month);
    pruneOutOfRangeData();
    commit();
  });

  function pruneOutOfRangeData(): void {
    const D = state.meta.daysInMonth;
    for (const nurse of state.nurses) {
      nurse.unavailable = nurse.unavailable.filter((d) => d <= D);
    }
    for (const k of Object.keys(state.cells)) {
      const day = parseInt(k.split(':')[1] ?? '0', 10);
      if (!day || day > D) {
        delete state.cells[k];
        delete state.pinned[k];
      }
    }
  }

  conMinDay.addEventListener('change', () => {
    state.constraints.minDayPresent = Math.max(0, parseInt(conMinDay.value, 10) || 0);
    commit();
  });
  conMinEve.addEventListener('change', () => {
    state.constraints.minEveningPresent = Math.max(0, parseInt(conMinEve.value, 10) || 0);
    commit();
  });
  conMinNight.addEventListener('change', () => {
    state.constraints.minNightPresent = Math.max(0, parseInt(conMinNight.value, 10) || 0);
    commit();
  });
  conRest.addEventListener('change', () => {
    state.constraints.restAfterNight = Math.max(0, Math.min(7, parseInt(conRest.value, 10) || 0));
    commit();
  });
  conWeekendReduced.addEventListener('change', () => {
    state.constraints.weekendReduced = conWeekendReduced.checked;
    commit();
  });
  conAllowSingle.addEventListener('change', () => {
    state.constraints.allowSingleNight = conAllowSingle.checked;
    commit();
  });

  /* ---------------------------------------------------- Nurse mgmt */

  nurseAddBtn.addEventListener('click', () => addNurse());
  nurseNameInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      addNurse();
    }
  });

  function addNurse(): void {
    const name = nurseNameInput.value.trim();
    if (!name) {
      nurseNameInput.focus();
      return;
    }
    state.nurses.push({ id: uniqueId(), name, unavailable: [] });
    nurseNameInput.value = '';
    commit();
  }

  nurseList.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const removeId = target.getAttribute('data-remove-nurse');
    if (removeId) {
      state.nurses = state.nurses.filter((n) => n.id !== removeId);
      // Cells & pins for this nurse → kaldır
      for (const k of Object.keys(state.cells)) {
        if (k.startsWith(removeId + ':')) {
          delete state.cells[k];
          delete state.pinned[k];
        }
      }
      commit();
      return;
    }
    const toggleId = target.getAttribute('data-toggle-leaves');
    if (toggleId) {
      const grid = nurseList.querySelector<HTMLElement>(`[data-leaves-grid="${toggleId}"]`);
      if (grid) grid.classList.toggle('hidden');
      return;
    }
    const dayBtnNurse = target.getAttribute('data-nurse');
    const dayBtnDay = target.getAttribute('data-day');
    if (dayBtnNurse && dayBtnDay && target.closest('[data-leaves-grid]')) {
      const nurse = state.nurses.find((n) => n.id === dayBtnNurse);
      if (!nurse) return;
      const d = parseInt(dayBtnDay, 10);
      if (nurse.unavailable.includes(d)) {
        nurse.unavailable = nurse.unavailable.filter((x) => x !== d);
      } else {
        nurse.unavailable.push(d);
        nurse.unavailable.sort((a, b) => a - b);
      }
      commit();
    }
  });

  nurseList.addEventListener('change', (e) => {
    const target = e.target as HTMLInputElement;
    const nameFor = target.getAttribute('data-nurse-name');
    if (nameFor) {
      const nurse = state.nurses.find((n) => n.id === nameFor);
      if (nurse) {
        nurse.name = target.value.trim() || 'İsimsiz';
        commit();
      }
    }
  });

  /* ---------------------------------------------------- Sample / Reset */

  sampleBtn.addEventListener('click', () => {
    state = buildSampleSchedule(state.meta.year, state.meta.month);
    clearStatus();
    commit();
  });

  resetBtn.addEventListener('click', () => {
    if (!confirm('Tüm planı sıfırlamak istediğinden emin misin? Bu işlem geri alınamaz.')) return;
    try {
      localStorage.removeItem(STORAGE_KEY);
    } catch {
      /* ignore */
    }
    state = defaultSchedule();
    clearStatus();
    commit();
  });

  /* ---------------------------------------------------- Solvers */

  solveGreedyBtn.addEventListener('click', () => {
    if (state.nurses.length === 0) {
      setError('Önce en az bir hemşire eklemelisin.');
      return;
    }
    clearStatus();
    solveGreedyBtn.disabled = true;
    solveGreedyLabel.textContent = 'Çözülüyor...';
    try {
      const result = solveScheduleGreedy(state);
      state = result.schedule;
      saveState();
      renderAll();
      const errs = result.issues.filter((i) => i.severity === 'error').length;
      if (errs === 0) {
        setStatus(`Çözüm hazır — ${state.nurses.length} hemşire, ${state.meta.daysInMonth} gün, tüm kısıtlar sağlandı.`, 'success');
      } else {
        setStatus(`Çözüm hazır ama ${errs} ihlal kaldı. Aşağıdaki listeden manuel düzelt veya "Optimum çöz" dene.`, 'warn');
      }
    } catch (err) {
      setError(`Hata: ${err instanceof Error ? err.message : String(err)}`);
    } finally {
      solveGreedyBtn.disabled = false;
      solveGreedyLabel.textContent = 'Otomatik doldur';
    }
  });

  solveIlpBtn.addEventListener('click', async () => {
    if (state.nurses.length === 0) {
      setError('Önce en az bir hemşire eklemelisin.');
      return;
    }
    clearStatus();
    solveIlpBtn.disabled = true;
    solveGreedyBtn.disabled = true;
    solveIlpLabel.textContent = 'ILP çözülüyor (1-5 sn)...';
    setStatus('ILP solver çalışıyor — saatleri eşitlemeye çalışıyor. Bu birkaç saniye sürebilir.', 'info');
    try {
      const t0 = performance.now();
      const result = await solveScheduleILP(state);
      const elapsed = Math.round(performance.now() - t0);
      state = result.schedule;
      saveState();
      renderAll();
      const errs = result.issues.filter((i) => i.severity === 'error').length;
      if (errs === 0) {
        setStatus(`Optimum bulundu (${elapsed} ms). Saat sapması: ${result.stats.hoursStdDev.toFixed(1)} saat.`, 'success');
      } else {
        setStatus(`ILP feasible çözüm verdi ama ${errs} ihlal var (${elapsed} ms). Bazı kısıtlar gevşetilmesi gerekebilir.`, 'warn');
      }
    } catch (err) {
      setError(`ILP hatası: ${err instanceof Error ? err.message : String(err)}`);
    } finally {
      solveIlpBtn.disabled = false;
      solveGreedyBtn.disabled = false;
      solveIlpLabel.textContent = 'Optimum çöz (ILP)';
    }
  });

  /* ---------------------------------------------------- Cell editing */

  let popoverContext: { nurseId: string; day: number; cell: HTMLElement } | null = null;

  function openPopoverAt(cell: HTMLElement): void {
    const nurseId = cell.getAttribute('data-nurse');
    const day = parseInt(cell.getAttribute('data-day') || '0', 10);
    if (!nurseId || !day) return;
    popoverContext = { nurseId, day, cell };

    // Başlığı güncelle: "Ayşe • 7 Mayıs"
    const nurse = state.nurses.find((n) => n.id === nurseId);
    if (nurse && popoverTitle) {
      const monthName = ['Oca','Şub','Mar','Nis','May','Haz','Tem','Ağu','Eyl','Eki','Kas','Ara'][state.meta.month - 1];
      popoverTitle.textContent = `${nurse.name} • ${day} ${monthName}`;
    }

    const rect = cell.getBoundingClientRect();
    popover.classList.remove('hidden');
    // Konumu hesapla (sayfa kaydırmasına dikkat)
    const popRect = popover.getBoundingClientRect();
    let x = rect.left + window.scrollX;
    let y = rect.bottom + window.scrollY + 4;
    if (x + popRect.width > window.innerWidth + window.scrollX - 8) {
      x = window.innerWidth + window.scrollX - popRect.width - 8;
    }
    if (y + popRect.height > window.innerHeight + window.scrollY - 8) {
      y = rect.top + window.scrollY - popRect.height - 4;
    }
    popover.style.left = `${Math.max(8, x)}px`;
    popover.style.top = `${Math.max(8, y)}px`;
  }

  function closePopover(): void {
    popover.classList.add('hidden');
    popoverContext = null;
  }

  popoverCloseBtn.addEventListener('click', (e) => {
    e.stopPropagation();
    closePopover();
  });

  function applyShift(nurseId: string, day: number, shift: ShiftCode): void {
    const k = cellKey(nurseId, day);
    if (shift === 'OFF') {
      delete state.cells[k];
    } else {
      state.cells[k] = shift;
    }
    state.pinned[k] = true; // user'in elle değiştirmesi → pin
    commit();
  }

  function togglePin(nurseId: string, day: number): void {
    const k = cellKey(nurseId, day);
    if (state.pinned[k]) {
      delete state.pinned[k];
    } else {
      state.pinned[k] = true;
    }
    commit();
  }

  scheduleTable.addEventListener('click', (e) => {
    const cell = (e.target as HTMLElement).closest<HTMLElement>('td.ns-cell');
    if (!cell) return;
    if (popoverContext && popoverContext.cell === cell) {
      closePopover();
      return;
    }
    openPopoverAt(cell);
  });

  scheduleTable.addEventListener('focusin', (e) => {
    const cell = (e.target as HTMLElement).closest<HTMLElement>('td.ns-cell');
    if (!cell) return;
    cell.classList.add('ns-focused');
  });
  scheduleTable.addEventListener('focusout', (e) => {
    const cell = (e.target as HTMLElement).closest<HTMLElement>('td.ns-cell');
    if (cell) cell.classList.remove('ns-focused');
  });

  popover.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('button');
    if (!btn || !popoverContext) return;
    const action = btn.getAttribute('data-action');
    const shift = btn.getAttribute('data-shift') as ShiftCode | null;
    const ctx = popoverContext;
    if (action === 'toggle-pin') {
      togglePin(ctx.nurseId, ctx.day);
    } else if (shift) {
      applyShift(ctx.nurseId, ctx.day, shift);
    }
    closePopover();
  });

  document.addEventListener('click', (e) => {
    if (popover.classList.contains('hidden')) return;
    const target = e.target as HTMLElement;
    if (!target.closest('#cell-popover') && !target.closest('td.ns-cell')) {
      closePopover();
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !popover.classList.contains('hidden')) {
      e.preventDefault();
      closePopover();
      // Hücreye odağı geri ver
      if (popoverContext) {
        const { nurseId, day } = popoverContext;
        requestAnimationFrame(() => {
          const cell = scheduleTable.querySelector<HTMLElement>(
            `td.ns-cell[data-nurse="${nurseId}"][data-day="${day}"]`,
          );
          cell?.focus();
        });
      }
    }
  });

  /* ---------------------------------------------------- Tutorial */

  function isTutorialDismissed(): boolean {
    try {
      return localStorage.getItem(TUTORIAL_KEY) === '1';
    } catch {
      return false;
    }
  }

  function setTutorialDismissed(dismissed: boolean): void {
    try {
      if (dismissed) localStorage.setItem(TUTORIAL_KEY, '1');
      else localStorage.removeItem(TUTORIAL_KEY);
    } catch {
      /* ignore */
    }
  }

  function showTutorial(): void {
    tutorialBanner.classList.remove('hidden');
  }

  function hideTutorial(): void {
    tutorialBanner.classList.add('hidden');
  }

  // İlk açılışta dismissed değilse göster, dismissed ise gizle
  if (isTutorialDismissed()) {
    hideTutorial();
  } else {
    showTutorial();
  }

  tutorialCloseBtn.addEventListener('click', () => {
    hideTutorial();
    setTutorialDismissed(true);
  });

  tutorialToggleBtn.addEventListener('click', () => {
    if (tutorialBanner.classList.contains('hidden')) {
      showTutorial();
      // Banner'a yumuşak kaydır
      tutorialBanner.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    } else {
      hideTutorial();
    }
  });

  /* ---------------------------------------------------- Keyboard */

  scheduleTable.addEventListener('keydown', (e) => {
    const cell = (e.target as HTMLElement).closest<HTMLElement>('td.ns-cell');
    if (!cell) return;
    const nurseId = cell.getAttribute('data-nurse');
    const day = parseInt(cell.getAttribute('data-day') || '0', 10);
    if (!nurseId || !day) return;

    // Vardiya kısayolları
    const k = e.key.toLowerCase();
    let shift: ShiftCode | null = null;
    if (k === '8') shift = 'D8';
    else if (k === 'a') shift = 'E16';
    else if (k === 'n') shift = 'N24';
    else if (k === 'i' || e.key === 'İ' || e.key === 'i') {
      // 'i' might be hit by N24 path; explicit İ matches NI
      if (e.key === 'İ' || e.key === 'i' && (e.shiftKey || e.altKey)) shift = 'NI';
    }
    if (k === 'y') shift = 'YI';
    else if (k === 'r') shift = 'RT';
    if (e.key === '0' || e.key === 'Backspace' || e.key === 'Delete') {
      shift = 'OFF';
    }
    if (e.key === 'l' || e.key === 'L') {
      e.preventDefault();
      togglePin(nurseId, day);
      // Refocus: aynı hücre yeniden bulunmalı
      requestAnimationFrame(() => {
        const next = scheduleTable.querySelector<HTMLElement>(`td.ns-cell[data-nurse="${nurseId}"][data-day="${day}"]`);
        next?.focus();
      });
      return;
    }
    if (shift) {
      e.preventDefault();
      applyShift(nurseId, day, shift);
      requestAnimationFrame(() => {
        const next = scheduleTable.querySelector<HTMLElement>(`td.ns-cell[data-nurse="${nurseId}"][data-day="${day}"]`);
        next?.focus();
      });
      return;
    }

    // Ok tuşları ile dolaşma
    const dx = { ArrowLeft: -1, ArrowRight: 1, ArrowUp: 0, ArrowDown: 0 }[e.key] ?? 0;
    const dy = { ArrowLeft: 0, ArrowRight: 0, ArrowUp: -1, ArrowDown: 1 }[e.key] ?? 0;
    if (dx !== 0 || dy !== 0) {
      e.preventDefault();
      const newDay = Math.max(1, Math.min(state.meta.daysInMonth, day + dx));
      const nurseIdx = state.nurses.findIndex((n) => n.id === nurseId);
      const newNurseIdx = Math.max(0, Math.min(state.nurses.length - 1, nurseIdx + dy));
      const newNurseId = state.nurses[newNurseIdx]?.id;
      if (newNurseId) {
        const target = scheduleTable.querySelector<HTMLElement>(`td.ns-cell[data-nurse="${newNurseId}"][data-day="${newDay}"]`);
        target?.focus();
      }
    }
  });

  /* ---------------------------------------------------- Export */

  exportCsvBtn.addEventListener('click', () => {
    const D = state.meta.daysInMonth;
    const header = ['Hemşire', ...Array.from({ length: D }, (_, i) => String(i + 1)), 'Toplam saat', 'Nöbet sayısı'];
    const stats = computeStats(state);
    const rows = state.nurses.map((nurse) => {
      const cells = Array.from({ length: D }, (_, i) => SHIFT_LABEL[state.cells[cellKey(nurse.id, i + 1)] ?? 'OFF']);
      return [nurse.name, ...cells, String(stats.hoursByNurse[nurse.id] ?? 0), String(stats.countsByNurse[nurse.id]?.N24 ?? 0)];
    });
    const csv = [header, ...rows]
      .map((r) => r.map((c) => /[",\n]/.test(c) ? `"${c.replace(/"/g, '""')}"` : c).join(','))
      .join('\n');
    const blob = new Blob(['﻿' + csv], { type: 'text/csv;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `vardiya-${state.meta.year}-${String(state.meta.month).padStart(2, '0')}.csv`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  });

  printBtn.addEventListener('click', () => window.print());

  /* ---------------------------------------------------- Init */

  renderAll();
</script>
