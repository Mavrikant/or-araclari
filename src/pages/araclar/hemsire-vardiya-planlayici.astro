  }
  .ns-popover-grid button:hover {
    transform: translateY(-1px);
  }
  .ns-popover-grid button[data-action="toggle-pin"] {
    grid-column: span 4;
    background: rgb(241 245 249);
  }
  .dark .ns-popover-grid button[data-action="toggle-pin"] {
