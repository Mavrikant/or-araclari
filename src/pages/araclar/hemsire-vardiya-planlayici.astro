<script>
  import {
    DEFAULT_CONSTRAINTS,
    DEFAULT_WORK_STYLE,
    WORK_STYLE_LABEL,
    WORK_STYLE_SHORT,
    cellKey,
    computeStats,
    createMonthMeta,
    solveScheduleGreedy,
    solveScheduleILP,
    validate,
    buildSampleSchedule,
    SHIFT_LABEL,
    isDayCovering,
    isNightCovering,
    type Nurse,
    type Schedule,
    type ScheduleConstraints,
    type ShiftCode,
    type WorkStyle,
  } from '../../lib/nurse-schedule';

  const STORAGE_KEY = 'nurse-schedule-v2';
  const LEGACY_KEY = 'nurse-schedule-v1';
  const TUTORIAL_KEY = 'nurse-schedule-tutorial-dismissed-v1';
  const TR_DAYS = ['Pzt', 'Sal', 'Çar', 'Per', 'Cum', 'Cmt', 'Paz'];
  const TR_MONTH_SHORT = ['Oca','Şub','Mar','Nis','May','Haz','Tem','Ağu','Eyl','Eki','Kas','Ara'];

  const $ = <T extends HTMLElement = HTMLElement>(id: string): T => {
    const el = document.getElementById(id);
    if (!el) throw new Error(`Element not found: ${id}`);
    return el as T;
  };

  function escapeHtml(s: string): string {
    return s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));
  }

  function uniqueId(): string {
    return 'n_' + Math.random().toString(36).slice(2, 8) + Date.now().toString(36).slice(-3);
  }

  function defaultSchedule(): Schedule {
    const now = new Date();
    return buildSampleSchedule(now.getFullYear(), now.getMonth() + 1);
  }

  /** Eski koddan yeni koda dönüştürür (v1 → v2 migration). */
  function migrateShiftCode(code: string): ShiftCode | null {
    const map: Record<string, ShiftCode> = {
      // v2 (kendi)
      G8: 'G8', GC16: 'GC16', N24: 'N24', DN: 'DN', YI: 'YI', RP: 'RP',
      // v1 (eski)
      D8: 'G8',
      E16: 'GC16', // 8 saatli akşamı 16 saat geceye dönüştür
      NI: 'DN',
      RT: 'RP',
      OFF: 'DN',
    };
    return map[code] ?? null;
  }

  function migrateConstraints(raw: Record<string, unknown>): ScheduleConstraints {
    const out: ScheduleConstraints = { ...DEFAULT_CONSTRAINTS };
    // v2/v3 doğrudan
    if (typeof raw.minDayWeekday === 'number') out.minDayWeekday = Math.round(raw.minDayWeekday);
    if (typeof raw.minDayWeekend === 'number') out.minDayWeekend = Math.round(raw.minDayWeekend);
    if (typeof raw.minDayHoliday === 'number') out.minDayHoliday = Math.round(raw.minDayHoliday);
    if (typeof raw.minNightWeekday === 'number') out.minNightWeekday = Math.round(raw.minNightWeekday);
    if (typeof raw.minNightWeekend === 'number') out.minNightWeekend = Math.round(raw.minNightWeekend);
    if (typeof raw.minNightHoliday === 'number') out.minNightHoliday = Math.round(raw.minNightHoliday);
    // v1 ile geriye-uyum: minDayPresent, minNightPresent, weekendReduced
    if (typeof raw.minDayPresent === 'number') {
      out.minDayWeekday = Math.round(raw.minDayPresent);
      out.minDayWeekend = raw.weekendReduced === true ? Math.max(2, Math.round(raw.minDayPresent) - 1) : Math.round(raw.minDayPresent);
      out.minDayHoliday = out.minDayWeekend;
    }
    if (typeof raw.minNightPresent === 'number') {
      out.minNightWeekday = Math.round(raw.minNightPresent);
      out.minNightWeekend = Math.round(raw.minNightPresent);
      out.minNightHoliday = Math.round(raw.minNightPresent);
    }
    if (typeof raw.restAfterNight === 'number') out.restAfterNight = Math.max(0, Math.min(7, Math.round(raw.restAfterNight)));
    if (typeof raw.restAfterEvening === 'number') out.restAfterEvening = Math.max(0, Math.min(7, Math.round(raw.restAfterEvening)));
    if (typeof raw.allowSingleNight === 'boolean') out.allowSingleNight = raw.allowSingleNight;
    if (typeof raw.preferEveningOverNight === 'boolean') out.preferEveningOverNight = raw.preferEveningOverNight;
    out.minDayWeekday = Math.max(0, out.minDayWeekday);
    out.minDayWeekend = Math.max(0, out.minDayWeekend);
    out.minDayHoliday = Math.max(0, out.minDayHoliday);
    out.minNightWeekday = Math.max(0, out.minNightWeekday);
    out.minNightWeekend = Math.max(0, out.minNightWeekend);
    out.minNightHoliday = Math.max(0, out.minNightHoliday);
    return out;
  }

  function normalize(raw: unknown): Schedule | null {
    if (!raw || typeof raw !== 'object') return null;
    const o = raw as Record<string, unknown>;
    const meta = o.meta as Record<string, unknown> | undefined;
    if (!meta || typeof meta.year !== 'number' || typeof meta.month !== 'number') return null;
    const year = Math.round(meta.year);
    const month = Math.round(meta.month);
    if (month < 1 || month > 12 || year < 2000 || year > 2100) return null;
    const constraints = migrateConstraints((o.constraints as Record<string, unknown>) || {});
    const nursesRaw = Array.isArray(o.nurses) ? o.nurses : [];
    const nurses: Nurse[] = nursesRaw.flatMap((n: unknown) => {
      if (!n || typeof n !== 'object') return [];
      const obj = n as Record<string, unknown>;
      const id = typeof obj.id === 'string' && obj.id.length > 0 ? obj.id : uniqueId();
      const name = typeof obj.name === 'string' ? obj.name : '';
      const unavailable = Array.isArray(obj.unavailable)
        ? obj.unavailable.filter((d): d is number => typeof d === 'number' && d >= 1 && d <= 31).map((d) => Math.round(d))
        : [];
      const notes = typeof obj.notes === 'string' ? obj.notes : undefined;
      const wsRaw = obj.workStyle;
      const workStyle: WorkStyle =
        wsRaw === 'oncall' || wsRaw === 'minDays' ? wsRaw : 'standard';
      return [{ id, name, unavailable, workStyle, notes }];
    });
    const cells: Record<string, ShiftCode> = {};
    const cellsRaw = (o.cells as Record<string, unknown>) || {};
    for (const [k, v] of Object.entries(cellsRaw)) {
      if (typeof v !== 'string') continue;
      const migrated = migrateShiftCode(v);
      if (migrated) cells[k] = migrated;
    }
    const pinned: Record<string, true> = {};
    const pinnedRaw = (o.pinned as Record<string, unknown>) || {};
    for (const [k, v] of Object.entries(pinnedRaw)) {
      if (v === true) pinned[k] = true;
    }
    const holidays = Array.isArray(o.holidays)
      ? (o.holidays as unknown[]).filter((d): d is number => typeof d === 'number' && d >= 1 && d <= 31).map((d) => Math.round(d))
      : [];
    return {
      meta: createMonthMeta(year, month),
      nurses,
      cells,
      pinned,
      holidays,
      constraints,
    };
  }

  function loadState(): Schedule {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (raw) {
        const parsed = JSON.parse(raw);
        const norm = normalize(parsed);
        if (norm) return norm;
      }
    } catch {
      /* ignore */
    }
    // v1 migrasyonu
    try {
      const v1 = localStorage.getItem(LEGACY_KEY);
      if (v1) {
        const parsed = JSON.parse(v1);
        const norm = normalize(parsed);
        if (norm) {
          // v1 anahtarını koru, v2 ile yaz
          return norm;
        }
      }
    } catch {
      /* ignore */
    }
    return defaultSchedule();
  }

  function saveState(): void {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
    } catch {
      /* ignore */
    }
  }

  let state: Schedule = loadState();

  /* --------------------------------------------------------- DOM cache */
  const monthSelect = $<HTMLSelectElement>('month-select');
  const yearInput = $<HTMLInputElement>('year-input');
  const sampleBtn = $<HTMLButtonElement>('sample-btn');
  const resetBtn = $<HTMLButtonElement>('reset-btn');
  const solveGreedyBtn = $<HTMLButtonElement>('solve-greedy-btn');
  const solveIlpBtn = $<HTMLButtonElement>('solve-ilp-btn');
  const solveGreedyLabel = $('solve-greedy-label');
  const solveIlpLabel = $('solve-ilp-label');
  const solverStatus = $('solver-status');
  const solverError = $('solver-error');
  const scheduleTable = $<HTMLTableElement>('schedule-table');
  const issuesBlock = $('issues-block');
  const issuesList = $('issues-list');
  const statsGrid = $('stats-grid');
  const exportCsvBtn = $<HTMLButtonElement>('export-csv-btn');
  const printBtn = $<HTMLButtonElement>('print-btn');
  const popover = $('cell-popover');
  const popoverCloseBtn = $<HTMLButtonElement>('popover-close-btn');
  const popoverTitle = $('popover-title');
  const tutorialBanner = $('tutorial-banner');
  const tutorialCloseBtn = $<HTMLButtonElement>('tutorial-close');
  const tutorialToggleBtn = $<HTMLButtonElement>('tutorial-toggle');

  const conMinDayWd = $<HTMLInputElement>('con-min-day-wd');
  const conMinNightWd = $<HTMLInputElement>('con-min-night-wd');
  const conMinDayWe = $<HTMLInputElement>('con-min-day-we');
  const conMinNightWe = $<HTMLInputElement>('con-min-night-we');
  const conMinDayHol = $<HTMLInputElement>('con-min-day-hol');
  const conMinNightHol = $<HTMLInputElement>('con-min-night-hol');
  const conRest = $<HTMLInputElement>('con-rest');
  const conRestEve = $<HTMLInputElement>('con-rest-eve');
  const conPreferEvening = $<HTMLInputElement>('con-prefer-evening');
  const conAllowSingle = $<HTMLInputElement>('con-allow-single');
  const holidayCount = $('holiday-count');
  const holidayGrid = $('holiday-grid');

  /* --------------------------------------------------------- Render */

  function renderForm(): void {
    monthSelect.value = String(state.meta.month);
    yearInput.value = String(state.meta.year);
    conMinDayWd.value = String(state.constraints.minDayWeekday);
    conMinNightWd.value = String(state.constraints.minNightWeekday);
    conMinDayWe.value = String(state.constraints.minDayWeekend);
    conMinNightWe.value = String(state.constraints.minNightWeekend);
    conMinDayHol.value = String(state.constraints.minDayHoliday);
    conMinNightHol.value = String(state.constraints.minNightHoliday);
    conRest.value = String(state.constraints.restAfterNight);
    conRestEve.value = String(state.constraints.restAfterEvening);
    conPreferEvening.checked = state.constraints.preferEveningOverNight;
    conAllowSingle.checked = state.constraints.allowSingleNight;

    // Resmi tatiller takvim widget
    const D = state.meta.daysInMonth;
    const holidaysSet = new Set(state.holidays);
    const dayBtns = Array.from({ length: D }, (_, i) => {
      const d = i + 1;
      const active = holidaysSet.has(d);
      return `<button type="button" data-holiday-day="${d}" class="${active ? 'ns-day-active' : ''}" title="Gün ${d}: ${active ? 'tatil' : 'normal'}">${d}</button>`;
    }).join('');
    holidayGrid.innerHTML = dayBtns;
    holidayCount.textContent = `${state.holidays.length} gün`;
  }

  function renderGrid(): void {
    const D = state.meta.daysInMonth;
    const weekendSet = new Set(state.meta.weekendDays);
    const holidaySet = new Set(state.holidays);
    const dayKindFor = (d: number): 'weekday' | 'weekend' | 'holiday' => {
      if (holidaySet.has(d)) return 'holiday';
      if (weekendSet.has(d)) return 'weekend';
      return 'weekday';
    };
    const issues = validate(state);
    const violationCells = new Set<string>();
    for (const issue of issues) {
      if (issue.severity === 'error' && issue.nurseId) {
        violationCells.add(`${issue.nurseId}:${issue.day}`);
      }
    }

    const headCells = Array.from({ length: D }, (_, i) => {
      const d = i + 1;
      const dow = new Date(state.meta.year, state.meta.month - 1, d).getDay();
      const dayLabel = TR_DAYS[(dow + 6) % 7];
      const kind = dayKindFor(d);
      const cls = kind === 'holiday' ? 'ns-holiday' : kind === 'weekend' ? 'ns-weekend' : '';
      return `<th class="${cls}" data-day-header="${d}"><div>${d}</div><div style="font-weight:400; font-size: 0.65rem; opacity: 0.7;">${dayLabel}</div></th>`;
    }).join('');
    const headRow = `<tr><th class="ns-row-name" data-nurse-header><span>Hemşire</span><button type="button" data-add-nurse class="ns-add-btn" title="Hemşire ekle" aria-label="Hemşire ekle">+</button></th>${headCells}<th class="ns-row-name" style="text-align:right;">Aylık</th></tr>`;

    const stats = computeStats(state);
    const rows = state.nurses.map((nurse) => {
      const cells = Array.from({ length: D }, (_, i) => {
        const d = i + 1;
        const k = cellKey(nurse.id, d);
        const code = state.cells[k];
        const isPinned = !!state.pinned[k];
        const kind = dayKindFor(d);
        const isViolation = violationCells.has(k);
        const cls = [
          'ns-cell',
          kind === 'holiday' ? 'ns-holiday' : kind === 'weekend' ? 'ns-weekend' : '',
          isPinned ? 'ns-pinned' : '',
          isViolation ? 'ns-violation' : '',
        ].filter(Boolean).join(' ');
        const shiftAttr = code ? `data-shift="${code}"` : '';
        const label = code ? SHIFT_LABEL[code] : '';
        return `<td class="${cls}" ${shiftAttr} data-nurse="${nurse.id}" data-day="${d}" tabindex="0" title="${escapeHtml(nurse.name)} • ${d}. gün${kind === 'holiday' ? ' (tatil)' : ''} • ${label || 'Boş'}">${label}</td>`;
      }).join('');
      const counts = stats.countsByNurse[nurse.id] || { G8: 0, GC16: 0, N24: 0, DN: 0, YI: 0, RP: 0 };
      const total = stats.hoursByNurse[nurse.id] ?? 0;
      const summary = `${total}sa · N${counts.N24} · 8×${counts.G8}${counts.GC16 ? ' · 16×' + counts.GC16 : ''}`;
      const ws: WorkStyle = nurse.workStyle ?? DEFAULT_WORK_STYLE;
      const wsBadge = `<button type="button" data-style-nurse="${nurse.id}" class="ns-style-badge ns-style-${ws}" title="Çalışma tarzı: ${WORK_STYLE_LABEL[ws]} (tıkla: değiştir)" aria-label="Çalışma tarzı değiştir">${WORK_STYLE_SHORT[ws]}</button>`;
      return `<tr><th class="ns-row-name ns-nurse-row-header" title="${escapeHtml(nurse.name)}"><button type="button" data-remove-nurse="${nurse.id}" class="ns-remove-btn" title="${escapeHtml(nurse.name)}'i sil" aria-label="Sil">×</button><span data-rename-nurse="${nurse.id}" class="ns-name-text" title="Yeniden adlandır">${escapeHtml(nurse.name)}</span>${wsBadge}</th>${cells}<td class="ns-row-total" title="Aylık toplam: ${total} saat">${summary}</td></tr>`;
    }).join('');

    const summaryCells = Array.from({ length: D }, (_, i) => {
      const d = i + 1;
      const kind = dayKindFor(d);
      let dayCount = 0, nightCount = 0;
      for (const nurse of state.nurses) {
        const c = state.cells[cellKey(nurse.id, d)];
        if (!c) continue;
        if (isDayCovering(c)) dayCount++;
        if (isNightCovering(c)) nightCount++;
      }
      let minDay: number, minNightBase: number;
      if (kind === 'holiday') {
        minDay = state.constraints.minDayHoliday;
        minNightBase = state.constraints.minNightHoliday;
      } else if (kind === 'weekend') {
        minDay = state.constraints.minDayWeekend;
        minNightBase = state.constraints.minNightWeekend;
      } else {
        minDay = state.constraints.minDayWeekday;
        minNightBase = state.constraints.minNightWeekday;
      }
      const minNight = state.constraints.allowSingleNight ? Math.min(1, minNightBase) : minNightBase;
      const dayBad = dayCount < minDay;
      const nightBad = nightCount < minNight;
      const overallBad = dayBad || nightBad;
      const kindClass = kind === 'holiday' ? 'ns-holiday' : kind === 'weekend' ? 'ns-weekend' : '';
      const cls = `ns-summary ${kindClass} ${overallBad ? 'ns-summary-bad' : 'ns-summary-ok'}`.trim();
      const kindLbl = kind === 'holiday' ? ' (tatil)' : kind === 'weekend' ? ' (hafta sonu)' : '';
      const tooltip = `Gün ${d}${kindLbl}: gündüz ${dayCount}/${minDay} · gece ${nightCount}/${minNight}`;
      return `<td class="${cls}" title="${escapeHtml(tooltip)}">${nightCount}/${dayCount}</td>`;
    }).join('');
    const summaryRow = `<tr><td class="ns-row-name" style="font-size: 0.7rem; font-weight:600;">Gece/Gündüz</td>${summaryCells}<td class="ns-row-total"></td></tr>`;

    scheduleTable.innerHTML = `<thead>${headRow}</thead><tbody>${rows}${summaryRow}</tbody>`;
  }

  function renderIssues(): void {
    const issues = validate(state);
    if (issues.length === 0) {
      issuesBlock.classList.add('hidden');
      issuesList.innerHTML = '';
      return;
    }
    issuesBlock.classList.remove('hidden');
    const items = issues
      .slice(0, 30)
      .map((i) => `<li>${i.severity === 'warning' ? '⚠' : '✗'} ${escapeHtml(i.message)}</li>`)
      .join('');
    const more = issues.length > 30 ? `<li>… ve ${issues.length - 30} ihlal daha</li>` : '';
    issuesList.innerHTML = items + more;
  }

  function renderStats(): void {
    const stats = computeStats(state);
    const D = state.meta.daysInMonth;
    const monthTotal = D * 24;

    const cards = state.nurses.map((nurse) => {
      const work = stats.hoursByNurse[nurse.id] ?? 0;
      const c = stats.countsByNurse[nurse.id] || { G8: 0, GC16: 0, N24: 0, DN: 0, YI: 0, RP: 0 };

      // Bar segment'leri: çalışma (mavi) + dinlenme (yeşil) + yıllık (mor) + rapor (gri)
      const restHours = c.G8 * 16 + c.GC16 * 8 + c.DN * 24;
      const yiHours = c.YI * 24;
      const rpHours = c.RP * 24;
      const workPct = monthTotal > 0 ? (work / monthTotal) * 100 : 0;
      const restPct = monthTotal > 0 ? (restHours / monthTotal) * 100 : 0;
      const yiPct = monthTotal > 0 ? (yiHours / monthTotal) * 100 : 0;
      const rpPct = monthTotal > 0 ? (rpHours / monthTotal) * 100 : 0;

      const segs: string[] = [];
      if (workPct > 0) segs.push(`<div class="ns-bar-seg ns-bar-work" style="width: ${workPct}%;" title="Çalışma: ${work} saat"></div>`);
      if (restPct > 0) segs.push(`<div class="ns-bar-seg ns-bar-rest" style="width: ${restPct}%;" title="Dinlenme: ${restHours} saat"></div>`);
      if (yiPct > 0) segs.push(`<div class="ns-bar-seg ns-bar-yi" style="width: ${yiPct}%;" title="Yıllık izin: ${yiHours} saat"></div>`);
      if (rpPct > 0) segs.push(`<div class="ns-bar-seg ns-bar-rp" style="width: ${rpPct}%;" title="Rapor: ${rpHours} saat"></div>`);

      // Tag'leri sadece sıfır olmayanlar için göster
      const tags: string[] = [];
      if (c.N24 > 0) tags.push(`<span class="ns-tag" data-shift="N24"><strong>${c.N24}</strong> nöbet</span>`);
      if (c.G8 > 0) tags.push(`<span class="ns-tag" data-shift="G8"><strong>${c.G8}</strong> gündüz</span>`);
      if (c.GC16 > 0) tags.push(`<span class="ns-tag" data-shift="GC16"><strong>${c.GC16}</strong> gece</span>`);
      if (c.DN > 0) tags.push(`<span class="ns-tag" data-shift="DN"><strong>${c.DN}</strong> dinlenme</span>`);
      if (c.YI > 0) tags.push(`<span class="ns-tag" data-shift="YI"><strong>${c.YI}</strong> yıllık</span>`);
      if (c.RP > 0) tags.push(`<span class="ns-tag" data-shift="RP"><strong>${c.RP}</strong> rapor</span>`);

      return `
        <div class="ns-stats-card">
          <div class="flex items-baseline justify-between">
            <span class="text-base font-semibold text-slate-900 dark:text-white">${escapeHtml(nurse.name)}</span>
            <span class="text-xl font-display font-bold text-slate-900 dark:text-white">${work}<span class="text-xs font-normal text-slate-500 ml-1">saat</span></span>
          </div>
          <div class="ns-bar mt-2" aria-label="Aylık saat dağılımı">${segs.join('')}</div>
          <div class="mt-2 flex flex-wrap gap-1.5 text-xs">${tags.join('')}</div>
        </div>`;
    }).join('');
    statsGrid.innerHTML = cards || `<p class="text-sm text-slate-500 dark:text-slate-400">Önce hemşire ekleyin.</p>`;
  }

  function renderAll(): void {
    renderForm();
    renderGrid();
    renderIssues();
    renderStats();
  }

  function commit(): void {
    saveState();
    renderAll();
  }

  function setStatus(msg: string, kind: 'info' | 'success' | 'warn' = 'info'): void {
    const colors: Record<string, string> = {
      info: 'border-slate-300 bg-slate-50 text-slate-800 dark:border-slate-700 dark:bg-slate-900/40 dark:text-slate-200',
      success: 'border-emerald-300 bg-emerald-50 text-emerald-900 dark:border-emerald-800 dark:bg-emerald-900/30 dark:text-emerald-200',
      warn: 'border-amber-300 bg-amber-50 text-amber-900 dark:border-amber-800 dark:bg-amber-900/30 dark:text-amber-200',
    };
    solverStatus.className = `rounded-lg border px-4 py-3 text-sm ${colors[kind]}`;
    solverStatus.textContent = msg;
    solverStatus.classList.remove('hidden');
  }

  function clearStatus(): void {
    solverStatus.classList.add('hidden');
    solverError.classList.add('hidden');
  }

  function setError(msg: string): void {
    solverError.textContent = msg;
    solverError.classList.remove('hidden');
  }

  /* ---------------------------------------------------- Form events */

  monthSelect.addEventListener('change', () => {
    const m = Math.max(1, Math.min(12, parseInt(monthSelect.value, 10) || 1));
    state.meta = createMonthMeta(state.meta.year, m);
    pruneOutOfRangeData();
    commit();
  });
  yearInput.addEventListener('change', () => {
    const y = Math.max(2020, Math.min(2099, parseInt(yearInput.value, 10) || new Date().getFullYear()));
    state.meta = createMonthMeta(y, state.meta.month);
    pruneOutOfRangeData();
    commit();
  });

  function pruneOutOfRangeData(): void {
    const D = state.meta.daysInMonth;
    for (const nurse of state.nurses) {
      nurse.unavailable = nurse.unavailable.filter((d) => d <= D);
    }
    for (const k of Object.keys(state.cells)) {
      const day = parseInt(k.split(':')[1] ?? '0', 10);
      if (!day || day > D) {
        delete state.cells[k];
        delete state.pinned[k];
      }
    }
  }

  conMinDayWd.addEventListener('change', () => {
    state.constraints.minDayWeekday = Math.max(0, parseInt(conMinDayWd.value, 10) || 0);
    commit();
  });
  conMinNightWd.addEventListener('change', () => {
    state.constraints.minNightWeekday = Math.max(0, parseInt(conMinNightWd.value, 10) || 0);
    commit();
  });
  conMinDayWe.addEventListener('change', () => {
    state.constraints.minDayWeekend = Math.max(0, parseInt(conMinDayWe.value, 10) || 0);
    commit();
  });
  conMinNightWe.addEventListener('change', () => {
    state.constraints.minNightWeekend = Math.max(0, parseInt(conMinNightWe.value, 10) || 0);
    commit();
  });
  conMinDayHol.addEventListener('change', () => {
    state.constraints.minDayHoliday = Math.max(0, parseInt(conMinDayHol.value, 10) || 0);
    commit();
  });
  conMinNightHol.addEventListener('change', () => {
    state.constraints.minNightHoliday = Math.max(0, parseInt(conMinNightHol.value, 10) || 0);
    commit();
  });
  conRest.addEventListener('change', () => {
    state.constraints.restAfterNight = Math.max(0, Math.min(7, parseInt(conRest.value, 10) || 0));
    commit();
  });
  conRestEve.addEventListener('change', () => {
    state.constraints.restAfterEvening = Math.max(0, Math.min(7, parseInt(conRestEve.value, 10) || 0));
    commit();
  });
  conPreferEvening.addEventListener('change', () => {
    state.constraints.preferEveningOverNight = conPreferEvening.checked;
    commit();
  });
  conAllowSingle.addEventListener('change', () => {
    state.constraints.allowSingleNight = conAllowSingle.checked;
    commit();
  });

  // Tatil günü tıklamaları
  holidayGrid.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const dayStr = target.getAttribute('data-holiday-day');
    if (!dayStr) return;
    const d = parseInt(dayStr, 10);
    if (state.holidays.includes(d)) {
      state.holidays = state.holidays.filter((x) => x !== d);
    } else {
      state.holidays.push(d);
      state.holidays.sort((a, b) => a - b);
    }
    commit();
  });

  /* ---------------------------------------------------- Nurse mgmt
   * Hemşire ekleme: tablonun "Hemşire +" başlığındaki butonla.
   * + butonu inline bir input görünümüne dönüşür; Enter/yan tikle ekle, Esc/dış tıkla iptal.
   * Hemşire silme: her satır başlığındaki × butonu.
   * Hemşire adını düzenleme: ad metnine çift tıkla → inline input.
   */

  function addNurse(name: string): void {
    const trimmed = name.trim();
    if (!trimmed) return;
    state.nurses.push({
      id: uniqueId(),
      name: trimmed,
      unavailable: [],
      workStyle: DEFAULT_WORK_STYLE,
    });
    commit();
  }

  function cycleWorkStyle(nurseId: string): void {
    const nurse = state.nurses.find((n) => n.id === nurseId);
    if (!nurse) return;
    const order: WorkStyle[] = ['standard', 'oncall', 'minDays'];
    const cur = nurse.workStyle ?? DEFAULT_WORK_STYLE;
    const next = order[(order.indexOf(cur) + 1) % order.length];
    nurse.workStyle = next;
    commit();
  }

  function removeNurse(nurseId: string): void {
    state.nurses = state.nurses.filter((n) => n.id !== nurseId);
    for (const k of Object.keys(state.cells)) {
      if (k.startsWith(nurseId + ':')) {
        delete state.cells[k];
        delete state.pinned[k];
      }
    }
    commit();
  }

  function renameNurse(nurseId: string, newName: string): void {
    const nurse = state.nurses.find((n) => n.id === nurseId);
    if (!nurse) return;
    nurse.name = newName.trim() || 'İsimsiz';
    commit();
  }

  // Inline input toggle — başlığa enjekte edilen yeni hemşire formu
  function showAddNurseInput(): void {
    const headerEl = scheduleTable.querySelector<HTMLElement>('th.ns-row-name[data-nurse-header]');
    if (!headerEl) return;
    headerEl.innerHTML = `
      <input type="text" id="ns-new-nurse-input" maxlength="40" autocomplete="off" placeholder="Hemşire adı"
        class="ns-inline-input" />
      <button type="button" id="ns-new-nurse-cancel" class="ns-icon-btn" title="İptal (Esc)">×</button>
    `;
    const input = headerEl.querySelector<HTMLInputElement>('#ns-new-nurse-input');
    const cancel = headerEl.querySelector<HTMLButtonElement>('#ns-new-nurse-cancel');
    input?.focus();
    let processed = false;
    const submit = (): void => {
      if (processed) return;
      processed = true;
      const v = input?.value.trim() ?? '';
      if (v) addNurse(v);
      else commit(); // sadece kapat (yeniden render)
    };
    const cancelInput = (): void => {
      if (processed) return;
      processed = true;
      commit();
    };
    input?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        submit();
      } else if (e.key === 'Escape') {
        e.preventDefault();
        cancelInput();
      }
    });
    cancel?.addEventListener('click', (e) => {
      e.stopPropagation();
      cancelInput();
    });
  }

  scheduleTable.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const addBtn = target.closest<HTMLElement>('[data-add-nurse]');
    if (addBtn) {
      e.stopPropagation();
      showAddNurseInput();
      return;
    }
    const removeBtn = target.closest<HTMLElement>('[data-remove-nurse]');
    if (removeBtn) {
      e.stopPropagation();
      const id = removeBtn.getAttribute('data-remove-nurse');
      if (!id) return;
      const nurse = state.nurses.find((n) => n.id === id);
      if (nurse && !confirm(`${nurse.name} silinsin mi? Bu hemşirenin tüm vardiyaları kaldırılacak.`)) return;
      removeNurse(id);
      return;
    }
    const styleBtn = target.closest<HTMLElement>('[data-style-nurse]');
    if (styleBtn) {
      e.stopPropagation();
      const id = styleBtn.getAttribute('data-style-nurse');
      if (!id) return;
      cycleWorkStyle(id);
      return;
    }
    const renameTrigger = target.closest<HTMLElement>('[data-rename-nurse]');
    if (renameTrigger) {
      e.stopPropagation();
      const id = renameTrigger.getAttribute('data-rename-nurse');
      if (!id) return;
      startInlineRename(id, renameTrigger);
    }
  });

  function startInlineRename(nurseId: string, trigger: HTMLElement): void {
    const nurse = state.nurses.find((n) => n.id === nurseId);
    if (!nurse) return;
    // Trigger span'ı bir input'a çevir
    const input = document.createElement('input');
    input.type = 'text';
    input.value = nurse.name;
    input.maxLength = 40;
    input.className = 'ns-inline-input ns-inline-rename';
    input.setAttribute('data-rename-input', nurseId);
    trigger.replaceWith(input);
    input.focus();
    input.select();

    let processed = false;
    const submit = (): void => {
      if (processed) return;
      processed = true;
      const v = input.value.trim();
      if (v && v !== nurse.name) {
        renameNurse(nurseId, v);
      } else {
        commit(); // sadece yeniden render → input geri spana dönüşür
      }
    };
    const cancelEdit = (): void => {
      if (processed) return;
      processed = true;
      commit();
    };
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        submit();
      } else if (e.key === 'Escape') {
        e.preventDefault();
        cancelEdit();
      }
    });
    input.addEventListener('blur', () => {
      // Esc ile çıkmadıysa kaydet
      submit();
    });
  }

  /* ---------------------------------------------------- Sample / Reset */

  sampleBtn.addEventListener('click', () => {
    state = buildSampleSchedule(state.meta.year, state.meta.month);
    clearStatus();
    commit();
  });

  resetBtn.addEventListener('click', () => {
    if (!confirm('Tüm planı sıfırlamak istediğinden emin misin? Bu işlem geri alınamaz.')) return;
    try {
      localStorage.removeItem(STORAGE_KEY);
      localStorage.removeItem(LEGACY_KEY);
    } catch {
      /* ignore */
    }
    state = defaultSchedule();
    clearStatus();
    commit();
  });

  /* ---------------------------------------------------- Solvers */

  solveGreedyBtn.addEventListener('click', () => {
    if (state.nurses.length === 0) {
      setError('Önce en az bir hemşire eklemelisin.');
      return;
    }
    clearStatus();
    solveGreedyBtn.disabled = true;
    solveGreedyLabel.textContent = 'Çözülüyor...';
    try {
      const result = solveScheduleGreedy(state);
      state = result.schedule;
      saveState();
      renderAll();
      const errs = result.issues.filter((i) => i.severity === 'error').length;
      if (errs === 0) {
        setStatus(`Çözüm hazır — ${state.nurses.length} hemşire, ${state.meta.daysInMonth} gün, tüm kısıtlar sağlandı. Saat sapması: ${result.stats.hoursSpread} sa.`, 'success');
      } else {
        setStatus(`Çözüm hazır ama ${errs} ihlal kaldı. Manuel düzelt veya "Optimum çöz" dene.`, 'warn');
      }
    } catch (err) {
      setError(`Hata: ${err instanceof Error ? err.message : String(err)}`);
    } finally {
      solveGreedyBtn.disabled = false;
      solveGreedyLabel.textContent = 'Otomatik doldur';
    }
  });

  solveIlpBtn.addEventListener('click', async () => {
    if (state.nurses.length === 0) {
      setError('Önce en az bir hemşire eklemelisin.');
      return;
    }
    clearStatus();
    solveIlpBtn.disabled = true;
    solveGreedyBtn.disabled = true;
    solveIlpLabel.textContent = 'ILP çözülüyor (1-5 sn)...';
    setStatus('ILP solver çalışıyor — saat sapmasını minimize ediyor.', 'info');
    try {
      const t0 = performance.now();
      const result = await solveScheduleILP(state);
      const elapsed = Math.round(performance.now() - t0);
      state = result.schedule;
      saveState();
      renderAll();
      const errs = result.issues.filter((i) => i.severity === 'error').length;
      if (errs === 0) {
        setStatus(`Optimum bulundu (${elapsed} ms). Saat sapması: ${result.stats.hoursSpread} sa.`, 'success');
      } else {
        setStatus(`ILP feasible çözüm verdi ama ${errs} ihlal var (${elapsed} ms).`, 'warn');
      }
    } catch (err) {
      setError(`ILP hatası: ${err instanceof Error ? err.message : String(err)}`);
    } finally {
      solveIlpBtn.disabled = false;
      solveGreedyBtn.disabled = false;
      solveIlpLabel.textContent = 'Optimum çöz (ILP)';
    }
  });

  /* ---------------------------------------------------- Cell editing */

  let popoverContext: { nurseId: string; day: number; cell: HTMLElement } | null = null;

  function openPopoverAt(cell: HTMLElement): void {
    const nurseId = cell.getAttribute('data-nurse');
    const day = parseInt(cell.getAttribute('data-day') || '0', 10);
    if (!nurseId || !day) return;
    popoverContext = { nurseId, day, cell };

    const nurse = state.nurses.find((n) => n.id === nurseId);
    if (nurse && popoverTitle) {
      const monthName = TR_MONTH_SHORT[state.meta.month - 1];
      popoverTitle.textContent = `${nurse.name} • ${day} ${monthName}`;
    }

    const rect = cell.getBoundingClientRect();
    popover.classList.remove('hidden');
    const popRect = popover.getBoundingClientRect();
    let x = rect.left + window.scrollX;
    let y = rect.bottom + window.scrollY + 4;
    if (x + popRect.width > window.innerWidth + window.scrollX - 8) {
      x = window.innerWidth + window.scrollX - popRect.width - 8;
    }
    if (y + popRect.height > window.innerHeight + window.scrollY - 8) {
      y = rect.top + window.scrollY - popRect.height - 4;
    }
    popover.style.left = `${Math.max(8, x)}px`;
    popover.style.top = `${Math.max(8, y)}px`;
  }

  function closePopover(): void {
    popover.classList.add('hidden');
    popoverContext = null;
  }

  popoverCloseBtn.addEventListener('click', (e) => {
    e.stopPropagation();
    closePopover();
  });

  function applyShift(nurseId: string, day: number, shift: ShiftCode): void {
    const k = cellKey(nurseId, day);
    state.cells[k] = shift;
    state.pinned[k] = true;
    commit();
  }

  function togglePin(nurseId: string, day: number): void {
    const k = cellKey(nurseId, day);
    if (state.pinned[k]) {
      delete state.pinned[k];
    } else {
      state.pinned[k] = true;
    }
    commit();
  }

  scheduleTable.addEventListener('click', (e) => {
    const cell = (e.target as HTMLElement).closest<HTMLElement>('td.ns-cell');
    if (!cell) return;
    if (popoverContext && popoverContext.cell === cell) {
      closePopover();
      return;
    }
    openPopoverAt(cell);
  });

  scheduleTable.addEventListener('focusin', (e) => {
    const cell = (e.target as HTMLElement).closest<HTMLElement>('td.ns-cell');
    if (!cell) return;
    cell.classList.add('ns-focused');
  });
  scheduleTable.addEventListener('focusout', (e) => {
    const cell = (e.target as HTMLElement).closest<HTMLElement>('td.ns-cell');
    if (cell) cell.classList.remove('ns-focused');
  });

  popover.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('button');
    if (!btn || !popoverContext) return;
    const action = btn.getAttribute('data-action');
    const shift = btn.getAttribute('data-shift') as ShiftCode | null;
    const ctx = popoverContext;
    if (action === 'toggle-pin') {
      togglePin(ctx.nurseId, ctx.day);
    } else if (shift) {
      applyShift(ctx.nurseId, ctx.day, shift);
    }
    closePopover();
  });

  document.addEventListener('click', (e) => {
    if (popover.classList.contains('hidden')) return;
    const target = e.target as HTMLElement;
    if (!target.closest('#cell-popover') && !target.closest('td.ns-cell')) {
      closePopover();
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !popover.classList.contains('hidden')) {
      e.preventDefault();
      const ctx = popoverContext;
      closePopover();
      if (ctx) {
        requestAnimationFrame(() => {
          const cell = scheduleTable.querySelector<HTMLElement>(
            `td.ns-cell[data-nurse="${ctx.nurseId}"][data-day="${ctx.day}"]`,
          );
          cell?.focus();
        });
      }
    }
  });

  /* ---------------------------------------------------- Tutorial */

  function isTutorialDismissed(): boolean {
    try { return localStorage.getItem(TUTORIAL_KEY) === '1'; } catch { return false; }
  }
  function setTutorialDismissed(v: boolean): void {
    try { if (v) localStorage.setItem(TUTORIAL_KEY, '1'); else localStorage.removeItem(TUTORIAL_KEY); } catch { /* ignore */ }
  }
  function showTutorial(): void { tutorialBanner.classList.remove('hidden'); }
  function hideTutorial(): void { tutorialBanner.classList.add('hidden'); }

  if (isTutorialDismissed()) hideTutorial(); else showTutorial();

  tutorialCloseBtn.addEventListener('click', () => {
    hideTutorial();
    setTutorialDismissed(true);
  });
  tutorialToggleBtn.addEventListener('click', () => {
    if (tutorialBanner.classList.contains('hidden')) {
      showTutorial();
      tutorialBanner.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    } else {
      hideTutorial();
    }
  });

  /* ---------------------------------------------------- Keyboard */

  scheduleTable.addEventListener('keydown', (e) => {
    const cell = (e.target as HTMLElement).closest<HTMLElement>('td.ns-cell');
    if (!cell) return;
    const nurseId = cell.getAttribute('data-nurse');
    const day = parseInt(cell.getAttribute('data-day') || '0', 10);
    if (!nurseId || !day) return;

    let shift: ShiftCode | null = null;
    const k = e.key.toLowerCase();
    if (k === '8') shift = 'G8';
    else if (k === 'g') shift = 'GC16';
    else if (k === 'n') shift = 'N24';
    else if (k === 'd') shift = 'DN';
    else if (k === 'y') shift = 'YI';
    else if (k === 'r') shift = 'RP';

    if (k === 'l') {
      e.preventDefault();
      togglePin(nurseId, day);
      requestAnimationFrame(() => {
        const next = scheduleTable.querySelector<HTMLElement>(`td.ns-cell[data-nurse="${nurseId}"][data-day="${day}"]`);
        next?.focus();
      });
      return;
    }
    if (shift) {
      e.preventDefault();
      applyShift(nurseId, day, shift);
      requestAnimationFrame(() => {
        const next = scheduleTable.querySelector<HTMLElement>(`td.ns-cell[data-nurse="${nurseId}"][data-day="${day}"]`);
        next?.focus();
      });
      return;
    }

    const dx = { ArrowLeft: -1, ArrowRight: 1, ArrowUp: 0, ArrowDown: 0 }[e.key] ?? 0;
    const dy = { ArrowLeft: 0, ArrowRight: 0, ArrowUp: -1, ArrowDown: 1 }[e.key] ?? 0;
    if (dx !== 0 || dy !== 0) {
      e.preventDefault();
      const newDay = Math.max(1, Math.min(state.meta.daysInMonth, day + dx));
      const nurseIdx = state.nurses.findIndex((n) => n.id === nurseId);
      const newNurseIdx = Math.max(0, Math.min(state.nurses.length - 1, nurseIdx + dy));
      const newNurseId = state.nurses[newNurseIdx]?.id;
      if (newNurseId) {
        const target = scheduleTable.querySelector<HTMLElement>(`td.ns-cell[data-nurse="${newNurseId}"][data-day="${newDay}"]`);
        target?.focus();
      }
    }
  });

  /* ---------------------------------------------------- Export */

  exportCsvBtn.addEventListener('click', () => {
    const D = state.meta.daysInMonth;
    const header = ['Hemşire', ...Array.from({ length: D }, (_, i) => String(i + 1)), 'Toplam saat', 'Nöbet sayısı'];
    const stats = computeStats(state);
    const rows = state.nurses.map((nurse) => {
      const cells = Array.from({ length: D }, (_, i) => {
        const c = state.cells[cellKey(nurse.id, i + 1)];
        return c ? SHIFT_LABEL[c] : '';
      });
      return [nurse.name, ...cells, String(stats.hoursByNurse[nurse.id] ?? 0), String(stats.countsByNurse[nurse.id]?.N24 ?? 0)];
    });
    const csv = [header, ...rows]
      .map((r) => r.map((c) => /[",\n]/.test(c) ? `"${c.replace(/"/g, '""')}"` : c).join(','))
      .join('\n');
    const blob = new Blob(['﻿' + csv], { type: 'text/csv;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `vardiya-${state.meta.year}-${String(state.meta.month).padStart(2, '0')}.csv`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  });

  printBtn.addEventListener('click', () => window.print());

  renderAll();
</script>
