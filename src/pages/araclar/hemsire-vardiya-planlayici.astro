  }
  .dark .ns-popover-close:hover {
    background: rgb(30 41 59);
    color: rgb(241 245 249);
  }
  .ns-popover-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(54px, 1fr));
    gap: 4px;
