---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import { withBase, SITE } from '../../data/site';
import { TOOLS } from '../../data/tools';

const tool = TOOLS.find((t) => t.slug === 'ders-programi-uretici')!;
const guideHref = tool.guideSlug ? withBase(`/rehberler/${tool.guideSlug}`) : null;

const softwareJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: tool.title,
  applicationCategory: 'WebApplication',
  operatingSystem: 'Any',
  description: tool.description,
  url: new URL(Astro.url.pathname, Astro.site).toString(),
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'TRY' },
  inLanguage: SITE.locale,
  isAccessibleForFree: true,
};
---

<BaseLayout title={tool.title} description={tool.description}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(softwareJsonLd)} />
  </Fragment>

  <Container as="section" size="wide" class="pt-12 sm:pt-16">
    <p class="text-sm font-medium text-brand-600 dark:text-accent-400">
      <a href={withBase('/araclar')} class="hover:underline">Araçlar</a>
      <span class="text-slate-400 dark:text-slate-600"> / </span>
      <span>Çizelgeleme</span>
    </p>
    <h1 class="mt-2 max-w-3xl font-display text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl lg:text-5xl dark:text-white">{tool.title}</h1>
    <p class="mt-4 max-w-2xl text-base leading-relaxed text-slate-600 sm:text-lg dark:text-slate-400">
      Ders listeni gir, slot sayısını belirle, çakışmasız haftalık programı
      backtracking algoritmasıyla bul. Aynı öğretmen veya aynı grup aynı
      slotta iki ders almaz.
      {guideHref && (<a href={guideHref} class="font-medium text-brand-600 hover:text-brand-700 dark:text-accent-400 dark:hover:text-accent-300"> Rehbere git →</a>)}
    </p>
  </Container>

  <Container as="div" size="wide" class="grid gap-8 py-10 sm:py-12 lg:grid-cols-[minmax(0,360px)_1fr]">
    <form id="tt-form" class="space-y-6 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900/40" novalidate>
      <fieldset class="space-y-3">
        <div class="flex items-center justify-between">
          <label for="lessons" class="block font-display text-sm font-semibold text-slate-900 dark:text-white">Dersler</label>
          <span id="lesson-count" class="text-xs text-slate-500 dark:text-slate-400" aria-live="polite">0 ders</span>
        </div>
        <textarea id="lessons" name="lessons" rows="9" required autocomplete="off" spellcheck="false"
          class="block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 font-mono text-sm leading-relaxed text-slate-900 focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100"
          placeholder="Her satır: ders<TAB>öğretmen<TAB>grup&#10;&#10;Mat 9A	Ahmet	9A&#10;Fizik 9A	Burak	9A&#10;Mat 9B	Ahmet	9B"></textarea>
        <div class="flex flex-wrap gap-2">
          <button type="button" id="sample-btn" class="inline-flex items-center gap-1.5 rounded-md border border-slate-300 bg-white px-3 py-1.5 text-xs font-medium text-slate-700 hover:border-slate-400 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800">Örnek doldur</button>
          <button type="button" id="clear-btn" class="inline-flex items-center gap-1.5 rounded-md border border-transparent bg-transparent px-3 py-1.5 text-xs font-medium text-slate-600 hover:bg-slate-100 dark:text-slate-400 dark:hover:bg-slate-800">Temizle</button>
        </div>
      </fieldset>

      <fieldset>
        <label class="block">
          <span class="font-display text-sm font-semibold text-slate-900 dark:text-white">Slot sayısı (haftalık toplam)</span>
          <input type="number" id="slots" name="slots" min="1" max="60" step="1" value="10" required
            class="mt-2 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100" />
          <span class="mt-1 block text-xs text-slate-500 dark:text-slate-400">Örnek: 5 gün × 6 slot = 30.</span>
        </label>
      </fieldset>

      <button type="submit" class="inline-flex w-full items-center justify-center gap-2 rounded-lg bg-brand-700 px-4 py-2.5 text-sm font-semibold text-white hover:bg-brand-800 dark:bg-accent-500 dark:text-brand-950 dark:hover:bg-accent-400">Programı oluştur</button>

      <div id="error-box" hidden role="alert" class="rounded-lg border border-red-300 bg-red-50 p-3 text-sm text-red-800 dark:border-red-900/50 dark:bg-red-950/30 dark:text-red-300"></div>
    </form>

    <section id="output" hidden aria-live="polite" class="space-y-6">
      <header>
        <h2 class="font-display text-xl font-semibold tracking-tight text-slate-900 dark:text-white">Program</h2>
        <p id="summary" class="mt-1 text-sm text-slate-600 dark:text-slate-400"></p>
      </header>
      <div id="result-table"></div>
    </section>
  </Container>
</BaseLayout>

<script>
  import { solveTimetable, parseLessons, TimetableError } from '../../lib/timetable';

  const SAMPLE = 'Mat 9A\tAhmet\t9A\nFizik 9A\tBurak\t9A\nİng 9A\tCeyda\t9A\nMat 9B\tAhmet\t9B\nFizik 9B\tBurak\t9B\nİng 9B\tCeyda\t9B\nMat 10A\tAhmet\t10A\nFizik 10A\tBurak\t10A';

  const $ = (id: string): HTMLElement => {
    const el = document.getElementById(id);
    if (!el) throw new Error(`Missing #${id}`);
    return el;
  };

  const form = $('tt-form') as HTMLFormElement;
  const lessonsInput = $('lessons') as HTMLTextAreaElement;
  const lessonCount = $('lesson-count');
  const slotsInput = $('slots') as HTMLInputElement;
  const errorBox = $('error-box');
  const output = $('output');
  const summary = $('summary');
  const resultTable = $('result-table');
  const sampleBtn = $('sample-btn');
  const clearBtn = $('clear-btn');

  function escapeHtml(s: string): string {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  function updateCount(): void {
    const n = lessonsInput.value.split(/\r?\n/).filter((l) => l.trim()).length;
    lessonCount.textContent = `${n} ders`;
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    errorBox.hidden = true;
    try {
      const lessons = parseLessons(lessonsInput.value);
      const slots = Number(slotsInput.value);
      const r = solveTimetable({ lessons, slots });

      summary.textContent = `${r.assignments.length} ders ${r.slots} slot içine yerleştirildi (çakışmasız).`;

      // Group assignments by slot for grid display.
      const bySlot: Map<number, typeof r.assignments> = new Map();
      for (const a of r.assignments) {
        if (!bySlot.has(a.slot)) bySlot.set(a.slot, []);
        bySlot.get(a.slot)!.push(a);
      }

      const slotRows = Array.from({ length: slots }, (_, slotIdx) => {
        const items = bySlot.get(slotIdx) ?? [];
        const cells = items.length
          ? items.map((a) => `<div class="text-sm text-slate-900 dark:text-slate-100"><span class="font-medium">${escapeHtml(a.lesson.label)}</span><span class="ml-2 text-xs text-slate-500">${escapeHtml(a.lesson.teacher)} · ${escapeHtml(a.lesson.group)}</span></div>`).join('<br>')
          : '<span class="text-xs text-slate-400 italic">boş</span>';
        return `<tr class="border-t border-slate-100 dark:border-slate-800"><td class="px-3 py-2 text-xs text-slate-500 align-top">Slot ${slotIdx + 1}</td><td class="px-3 py-2">${cells}</td></tr>`;
      }).join('');

      resultTable.innerHTML = `<div class="overflow-x-auto rounded-xl border border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900/40"><table class="w-full"><thead><tr class="border-b border-slate-200 bg-slate-50 text-left text-xs font-medium uppercase tracking-wider text-slate-500 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-400"><th class="px-3 py-2 w-24">Slot</th><th class="px-3 py-2">Dersler</th></tr></thead><tbody>${slotRows}</tbody></table></div>`;

      output.hidden = false;
      output.scrollIntoView({ behavior: 'smooth', block: 'start' });
    } catch (err) {
      const msg = err instanceof TimetableError ? err.message : err instanceof Error ? err.message : 'Bilinmeyen hata.';
      errorBox.textContent = msg;
      errorBox.hidden = false;
      output.hidden = true;
    }
  });

  lessonsInput.addEventListener('input', updateCount);

  sampleBtn.addEventListener('click', () => {
    lessonsInput.value = SAMPLE;
    slotsInput.value = '6';
    updateCount();
  });

  clearBtn.addEventListener('click', () => {
    form.reset();
    slotsInput.value = '10';
    updateCount();
    output.hidden = true;
    errorBox.hidden = true;
  });

  updateCount();
</script>
