---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import { withBase, SITE } from '../../data/site';
import { TOOLS } from '../../data/tools';

const tool = TOOLS.find((t) => t.slug === 'pert-cpm-kritik-yol')!;
const guideHref = tool.guideSlug ? withBase(`/rehberler/${tool.guideSlug}`) : null;

const softwareJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: tool.title,
  applicationCategory: 'WebApplication',
  operatingSystem: 'Any',
  description: tool.description,
  url: new URL(Astro.url.pathname, Astro.site).toString(),
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'TRY' },
  inLanguage: SITE.locale,
  isAccessibleForFree: true,
};
---

<BaseLayout
  title={tool.title}
  description={tool.description}
  image={withBase(`/og/${tool.slug}.png`)}
  imageAlt={`${tool.title} — OR Araçları`}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(softwareJsonLd)} />
  </Fragment>

  <Container as="section" size="wide" class="pt-12 sm:pt-16">
    <p class="text-sm font-medium text-brand-600 dark:text-accent-400">
      <a href={withBase('/araclar')} class="hover:underline">Araçlar</a>
      <span class="text-slate-400 dark:text-slate-600"> / </span>
      <span>Çizelgeleme</span>
    </p>
    <h1 class="mt-2 max-w-3xl font-display text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl lg:text-5xl dark:text-white">
      {tool.title}
    </h1>
    <p class="mt-4 max-w-2xl text-base leading-relaxed text-slate-600 sm:text-lg dark:text-slate-400">
      Aktiviteleri, sürelerini ve önceller listesini gir; ileri ve geri pas
      ile ES/EF/LS/LF ve slack hesaplansın. Kritik yoldaki aktiviteler
      vurgulu olarak gösterilir ve Gantt çizelgesi otomatik üretilir.
      {guideHref && (
        <a href={guideHref} class="font-medium text-brand-600 hover:text-brand-700 dark:text-accent-400 dark:hover:text-accent-300"> Rehbere git →</a>
      )}
    </p>
  </Container>

  <Container as="div" size="wide" class="grid gap-8 py-10 sm:py-12 lg:grid-cols-[minmax(0,360px)_1fr] print:block">
    <form id="cpm-form" class="space-y-6 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900/40 print:hidden" novalidate>
      <div class="flex flex-wrap gap-2">
        <button type="button" id="sample-btn" class="inline-flex items-center gap-1.5 rounded-md border border-slate-300 bg-white px-3 py-1.5 text-xs font-medium text-slate-700 hover:border-slate-400 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800">
          Örnek doldur
        </button>
        <button type="button" id="reset-btn" class="inline-flex items-center gap-1.5 rounded-md border border-transparent bg-transparent px-3 py-1.5 text-xs font-medium text-slate-600 hover:bg-slate-100 dark:text-slate-400 dark:hover:bg-slate-800">
          Sıfırla
        </button>
      </div>

      <fieldset class="space-y-3">
        <div class="flex items-center justify-between">
          <legend class="font-display text-sm font-semibold text-slate-900 dark:text-white">
            Aktivite ekle
          </legend>
          <span id="activity-count" class="text-xs text-slate-500 dark:text-slate-400">0 aktivite</span>
        </div>
        <div class="space-y-2 rounded-lg border border-slate-200 bg-slate-50/60 p-3 dark:border-slate-800 dark:bg-slate-900/40">
          <div class="grid grid-cols-3 gap-2">
            <label class="block">
              <span class="text-xs text-slate-600 dark:text-slate-400">ID</span>
              <input type="text" id="act-id" placeholder="A" maxlength="20" autocomplete="off"
                class="mt-1 block w-full rounded-md border border-slate-300 bg-white px-2 py-1 text-sm text-slate-900 focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100" />
            </label>
            <label class="col-span-2 block">
              <span class="text-xs text-slate-600 dark:text-slate-400">Etiket (opsiyonel)</span>
              <input type="text" id="act-label" placeholder="Tasarım" autocomplete="off"
                class="mt-1 block w-full rounded-md border border-slate-300 bg-white px-2 py-1 text-sm text-slate-900 focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100" />
            </label>
          </div>
          <div class="grid grid-cols-2 gap-2">
            <label class="block">
              <span class="text-xs text-slate-600 dark:text-slate-400">Süre</span>
              <input type="number" id="act-duration" min="0" step="any" inputmode="decimal" value="1"
                class="mt-1 block w-full rounded-md border border-slate-300 bg-white px-2 py-1 text-sm text-slate-900 focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100" />
            </label>
            <label class="block">
              <span class="text-xs text-slate-600 dark:text-slate-400">Önceller (virgül)</span>
              <input type="text" id="act-preds" placeholder="A,B" autocomplete="off"
                class="mt-1 block w-full rounded-md border border-slate-300 bg-white px-2 py-1 text-sm text-slate-900 focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100" />
            </label>
          </div>
          <button type="button" id="add-btn" class="inline-flex w-full items-center justify-center rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:border-slate-400 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800">
            Ekle
          </button>
        </div>

        <ul id="activity-list" class="space-y-1.5 text-sm" aria-live="polite"></ul>
      </fieldset>

      <button type="submit" class="inline-flex w-full items-center justify-center gap-2 rounded-lg bg-brand-700 px-4 py-2.5 text-sm font-semibold text-white hover:bg-brand-800 dark:bg-accent-500 dark:text-brand-950 dark:hover:bg-accent-400">
        Kritik yolu hesapla
      </button>

      <div id="error-box" hidden role="alert" class="rounded-lg border border-red-300 bg-red-50 p-3 text-sm text-red-800 dark:border-red-900/50 dark:bg-red-950/30 dark:text-red-300"></div>
    </form>

    <section id="output" hidden aria-live="polite" class="space-y-6">
      <div class="rounded-2xl border border-emerald-300 bg-emerald-50 p-5 dark:border-emerald-800/60 dark:bg-emerald-950/30">
        <p class="text-xs font-medium uppercase tracking-wide text-emerald-700 dark:text-emerald-300">
          Proje süresi
        </p>
        <p id="project-duration" class="mt-1 font-display text-4xl font-bold text-emerald-900 dark:text-emerald-100"></p>
        <p id="critical-path" class="mt-1 text-xs text-emerald-800 dark:text-emerald-300"></p>
      </div>

      <div>
        <h2 class="font-display text-base font-semibold text-slate-900 dark:text-white">
          Aktivite tablosu
        </h2>
        <div id="activity-table" class="mt-3 overflow-x-auto rounded-xl border border-slate-200 dark:border-slate-800"></div>
      </div>

      <div>
        <h2 class="font-display text-base font-semibold text-slate-900 dark:text-white">
          Gantt çizelgesi
        </h2>
        <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">
          Kritik yoldaki aktiviteler emerald renkle vurgulanmıştır.
        </p>
        <div id="gantt" class="mt-3 overflow-x-auto rounded-xl border border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900/40"></div>
      </div>
    </section>
  </Container>

  {guideHref && (
    <Container as="section" size="wide" class="py-12 sm:py-16">
      <div class="rounded-2xl border border-slate-200 bg-slate-50 p-8 dark:border-slate-800 dark:bg-slate-900/40">
        <p class="text-xs font-semibold uppercase tracking-wide text-brand-600 dark:text-accent-400">
          Konuyu derinleştir
        </p>
        <h2 class="mt-2 max-w-2xl font-display text-2xl font-semibold tracking-tight text-slate-900 dark:text-white">
          PERT / CPM ve proje yönetiminin temelleri
        </h2>
        <p class="mt-3 max-w-2xl text-sm text-slate-600 dark:text-slate-400">
          1950'lerin ABD donanmasından modern yazılım proje yönetimine kritik
          yol metodolojisinin tarihçesi, matematiği ve gerçek dünya uygulamaları.
        </p>
        <a href={guideHref} class="mt-5 inline-flex items-center gap-1 text-sm font-semibold text-brand-700 hover:text-brand-800 dark:text-accent-300 dark:hover:text-accent-200">
          Rehberi oku →
        </a>
      </div>
    </Container>
  )}
</BaseLayout>

<script>
  import { solveCpm, CpmError, type Activity } from '../../lib/cpm';

  const STORAGE_KEY = 'cpm-state-v1';
  const SAMPLE: Activity[] = [
    { id: 'A', label: 'Tasarım', duration: 3, predecessors: [] },
    { id: 'B', label: 'Yazılım', duration: 5, predecessors: ['A'] },
    { id: 'C', label: 'Donanım', duration: 4, predecessors: ['A'] },
    { id: 'D', label: 'Test', duration: 2, predecessors: ['B', 'C'] },
    { id: 'E', label: 'Eğitim', duration: 3, predecessors: ['B'] },
    { id: 'F', label: 'Devreye alma', duration: 1, predecessors: ['D', 'E'] },
  ];

  const $ = <T extends HTMLElement = HTMLElement>(id: string): T => {
    const el = document.getElementById(id);
    if (!el) throw new Error(`Missing #${id}`);
    return el as T;
  };

  function escapeHtml(s: string): string {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }
  function fmt(n: number): string {
    return Number.isInteger(n) ? String(n) : n.toFixed(2);
  }

  let activities: Activity[] = [];

  const form = $<HTMLFormElement>('cpm-form');
  const idIn = $<HTMLInputElement>('act-id');
  const labelIn = $<HTMLInputElement>('act-label');
  const durIn = $<HTMLInputElement>('act-duration');
  const predIn = $<HTMLInputElement>('act-preds');
  const addBtn = $('add-btn');
  const listEl = $<HTMLUListElement>('activity-list');
  const countEl = $('activity-count');
  const sampleBtn = $('sample-btn');
  const resetBtn = $('reset-btn');
  const errorBox = $('error-box');
  const output = $('output');
  const projectDuration = $('project-duration');
  const criticalPath = $('critical-path');
  const activityTable = $('activity-table');
  const gantt = $('gantt');

  function sanitizeActivities(value: unknown): Activity[] {
    if (!Array.isArray(value)) return [];
    const out: Activity[] = [];
    const seenIds = new Set<string>();
    for (const item of value) {
      if (!item || typeof item !== 'object') continue;
      const raw = item as Record<string, unknown>;
      if (typeof raw.id !== 'string' || raw.id.length === 0) continue;
      if (seenIds.has(raw.id)) continue;
      const duration = typeof raw.duration === 'number' && Number.isFinite(raw.duration) && raw.duration >= 0
        ? raw.duration
        : 0;
      const predecessors = Array.isArray(raw.predecessors)
        ? raw.predecessors.filter((p): p is string => typeof p === 'string' && p.length > 0)
        : [];
      const label = typeof raw.label === 'string' ? raw.label : undefined;
      seenIds.add(raw.id);
      out.push({ id: raw.id, label, duration, predecessors });
    }
    return out;
  }

  function loadState(): void {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return;
      const parsed = JSON.parse(raw);
      const sanitized = sanitizeActivities(parsed);
      if (sanitized.length === 0 && Array.isArray(parsed) && parsed.length > 0) {
        /* Stored data was unrecognisable — drop it so we don't keep loading garbage. */
        localStorage.removeItem(STORAGE_KEY);
        return;
      }
      activities = sanitized;
    } catch {
      try {
        localStorage.removeItem(STORAGE_KEY);
      } catch {
        /* ignore */
      }
    }
  }
  function saveState(): void {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(activities));
    } catch {
      /* ignore */
    }
  }
  loadState();

  function renderList(): void {
    countEl.textContent = `${activities.length} aktivite`;
    listEl.innerHTML = activities.length
      ? activities
          .map(
            (a, i) => `<li class="flex items-center gap-2 rounded-md border border-slate-200 bg-white px-3 py-2 dark:border-slate-800 dark:bg-slate-900/40">
              <span class="font-mono text-xs font-semibold text-brand-700 dark:text-accent-400">${escapeHtml(a.id)}</span>
              <span class="min-w-0 flex-1 truncate text-sm text-slate-900 dark:text-slate-100">${escapeHtml(a.label ?? a.id)}</span>
              <span class="font-mono text-xs text-slate-500 dark:text-slate-400">${fmt(a.duration)}b</span>
              <span class="font-mono text-xs text-slate-500 dark:text-slate-400">${a.predecessors.length ? '←' + a.predecessors.map(escapeHtml).join(',') : '—'}</span>
              <button type="button" data-rm="${i}" aria-label="Aktivite ${escapeHtml(a.id)}, kaldır" class="rounded p-1 text-slate-400 hover:bg-slate-100 hover:text-slate-700 dark:hover:bg-slate-800 dark:hover:text-slate-200">
                <svg class="size-3.5" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 3l6 6M9 3l-6 6"/></svg>
              </button>
            </li>`,
          )
          .join('')
      : '<li class="rounded-md border border-dashed border-slate-200 px-3 py-3 text-xs italic text-slate-400 dark:border-slate-800">Henüz aktivite yok. "Örnek doldur" ile bir proje şablonu yükleyebilirsin.</li>';
  }

  function clearError(): void {
    errorBox.hidden = true;
    errorBox.textContent = '';
  }
  function showError(msg: string): void {
    errorBox.textContent = msg;
    errorBox.hidden = false;
    output.hidden = true;
  }

  function addActivity(): void {
    clearError();
    const id = idIn.value.trim();
    const label = labelIn.value.trim();
    const duration = Number(durIn.value);
    const predsRaw = predIn.value.trim();
    if (!id) { showError('ID boş olamaz.'); return; }
    if (activities.some((a) => a.id === id)) { showError(`"${id}" zaten ekli.`); return; }
    if (!Number.isFinite(duration) || duration < 0) { showError('Süre 0 veya pozitif olmalı.'); return; }
    const predecessors = predsRaw
      ? predsRaw.split(/[,;\s]+/).map((s) => s.trim()).filter(Boolean)
      : [];
    activities.push({ id, label: label || id, duration, predecessors });
    idIn.value = '';
    labelIn.value = '';
    durIn.value = '1';
    predIn.value = '';
    idIn.focus();
    renderList();
    saveState();
  }

  addBtn.addEventListener('click', addActivity);
  [idIn, labelIn, durIn, predIn].forEach((el) =>
    el.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        addActivity();
      }
    }),
  );

  listEl.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-rm]');
    if (!btn) return;
    const i = Number(btn.dataset.rm);
    activities.splice(i, 1);
    renderList();
    saveState();
  });

  function renderResult(result: ReturnType<typeof solveCpm>): void {
    projectDuration.textContent = `${fmt(result.projectDuration)} birim`;
    criticalPath.textContent = `Kritik yol: ${result.criticalPath.join(' → ')}`;

    const rows = result.activities
      .map(
        (a) => `<tr class="${a.critical ? 'bg-emerald-50 dark:bg-emerald-950/20' : 'bg-white dark:bg-slate-900/40'} border-t border-slate-100 dark:border-slate-800">
          <td class="px-3 py-2 font-mono text-xs font-semibold ${a.critical ? 'text-emerald-700 dark:text-emerald-300' : 'text-slate-700 dark:text-slate-300'}">${escapeHtml(a.id)}</td>
          <td class="px-3 py-2 text-sm text-slate-900 dark:text-slate-100">${escapeHtml(a.label)}</td>
          <td class="px-3 py-2 text-right font-mono text-xs tabular-nums text-slate-600 dark:text-slate-400">${fmt(a.duration)}</td>
          <td class="px-3 py-2 text-right font-mono text-xs tabular-nums text-slate-700 dark:text-slate-300">${fmt(a.earlyStart)}</td>
          <td class="px-3 py-2 text-right font-mono text-xs tabular-nums text-slate-700 dark:text-slate-300">${fmt(a.earlyFinish)}</td>
          <td class="px-3 py-2 text-right font-mono text-xs tabular-nums text-slate-700 dark:text-slate-300">${fmt(a.lateStart)}</td>
          <td class="px-3 py-2 text-right font-mono text-xs tabular-nums text-slate-700 dark:text-slate-300">${fmt(a.lateFinish)}</td>
          <td class="px-3 py-2 text-right font-mono text-xs tabular-nums ${a.critical ? 'font-semibold text-emerald-700 dark:text-emerald-300' : 'text-slate-700 dark:text-slate-300'}">${fmt(a.slack)}</td>
          <td class="px-3 py-2 text-center text-xs">${a.critical ? '<span class="rounded bg-emerald-200 px-1.5 py-0.5 text-emerald-900 dark:bg-emerald-800 dark:text-emerald-100">kritik</span>' : ''}</td>
        </tr>`,
      )
      .join('');
    activityTable.innerHTML = `<table class="w-full"><thead><tr class="border-b border-slate-200 bg-slate-50 text-left text-xs font-medium uppercase tracking-wider text-slate-500 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-400">
      <th class="px-3 py-2">ID</th><th class="px-3 py-2">Aktivite</th>
      <th class="px-3 py-2 text-right">Süre</th>
      <th class="px-3 py-2 text-right">ES</th><th class="px-3 py-2 text-right">EF</th>
      <th class="px-3 py-2 text-right">LS</th><th class="px-3 py-2 text-right">LF</th>
      <th class="px-3 py-2 text-right">Slack</th><th></th>
    </tr></thead><tbody>${rows}</tbody></table>`;

    /* Gantt */
    const W = 720;
    const rowH = 28;
    const PL = 80;
    const PR = 16;
    const PT = 16;
    const H = PT + result.activities.length * rowH + 30;
    const tMax = Math.max(result.projectDuration, 1);
    const sx = (t: number) => PL + (t / tMax) * (W - PL - PR);

    const ticks = [];
    const tickStep = Math.max(1, Math.ceil(tMax / 10));
    for (let t = 0; t <= tMax; t += tickStep) {
      ticks.push(`<line x1="${sx(t)}" y1="${PT}" x2="${sx(t)}" y2="${H - 16}" class="stroke-slate-200 dark:stroke-slate-800" stroke-width="1" />
        <text x="${sx(t)}" y="${H - 4}" text-anchor="middle" class="fill-slate-500 text-[10px] dark:fill-slate-400">${t}</text>`);
    }

    const bars = result.activities
      .map((a, i) => {
        const y = PT + i * rowH + 4;
        const x1 = sx(a.earlyStart);
        const x2 = sx(a.earlyFinish);
        const barClass = a.critical
          ? 'fill-emerald-500 dark:fill-emerald-400'
          : 'fill-brand-400 dark:fill-accent-500';
        const slackBarClass = a.slack > 1e-9
          ? `<rect x="${x2.toFixed(1)}" y="${y + 5}" width="${(sx(a.lateFinish) - x2).toFixed(1)}" height="${rowH - 14}" class="fill-slate-200 dark:fill-slate-800" />`
          : '';
        return `<g>
          <text x="${PL - 6}" y="${y + 14}" text-anchor="end" class="fill-slate-700 text-[11px] font-medium dark:fill-slate-300">${escapeHtml(a.id)}</text>
          ${slackBarClass}
          <rect x="${x1.toFixed(1)}" y="${y}" width="${(x2 - x1).toFixed(1)}" height="${rowH - 8}" class="${barClass}" rx="2" />
          <text x="${(x1 + x2) / 2}" y="${y + 14}" text-anchor="middle" class="fill-white text-[10px] font-medium" pointer-events="none">${escapeHtml(a.label)}</text>
        </g>`;
      })
      .join('');
    gantt.innerHTML = `<svg viewBox="0 0 ${W} ${H}" class="block w-full h-auto" role="img" aria-label="Gantt çizelgesi">
      ${ticks.join('')}
      <line x1="${PL}" y1="${PT}" x2="${PL}" y2="${H - 16}" class="stroke-slate-300 dark:stroke-slate-700" stroke-width="1" />
      ${bars}
    </svg>`;
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    clearError();
    if (activities.length === 0) {
      showError('En az bir aktivite ekle.');
      return;
    }
    try {
      const result = solveCpm(activities);
      renderResult(result);
      output.hidden = false;
      output.scrollIntoView({ behavior: 'smooth', block: 'start' });
    } catch (err) {
      const msg = err instanceof CpmError ? err.message : err instanceof Error ? err.message : 'Bilinmeyen hata.';
      showError(msg);
    }
  });

  sampleBtn.addEventListener('click', () => {
    activities = structuredClone(SAMPLE);
    renderList();
    saveState();
    clearError();
  });

  resetBtn.addEventListener('click', () => {
    if (!confirm('Tüm aktiviteler silinecek. Devam edilsin mi?')) return;
    activities = [];
    try {
      localStorage.removeItem(STORAGE_KEY);
    } catch {
      /* ignore */
    }
    renderList();
    output.hidden = true;
    clearError();
  });

  renderList();
</script>
