---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import { withBase, SITE } from '../../data/site';
import { TOOLS } from '../../data/tools';

const tool = TOOLS.find((t) => t.slug === 'lig-fiksturu-olusturucu')!;

const guideHref = tool.guideSlug
  ? withBase(`/rehberler/${tool.guideSlug}`)
  : null;

const softwareJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: tool.title,
  applicationCategory: 'WebApplication',
  operatingSystem: 'Any',
  description: tool.description,
  url: new URL(Astro.url.pathname, Astro.site).toString(),
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'TRY' },
  inLanguage: SITE.locale,
  isAccessibleForFree: true,
};

const weekdays = [
  { value: '', label: 'Hizalama yok (başlangıç tarihi olduğu gibi)' },
  { value: '1', label: 'Pazartesi' },
  { value: '2', label: 'Salı' },
  { value: '3', label: 'Çarşamba' },
  { value: '4', label: 'Perşembe' },
  { value: '5', label: 'Cuma' },
  { value: '6', label: 'Cumartesi' },
  { value: '0', label: 'Pazar' },
];
---

<BaseLayout
  title={tool.title}
  description={tool.description}
  image={withBase(`/og/${tool.slug}.png`)}
  imageAlt={`${tool.title} — OR Araçları`}
>
  <Fragment slot="head">
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(softwareJsonLd)}
    />
  </Fragment>

  <Container as="section" size="wide" class="pt-12 sm:pt-16">
    <p class="text-sm font-medium text-brand-600 dark:text-accent-400">
      <a href={withBase('/araclar')} class="hover:underline">Araçlar</a>
      <span class="text-slate-400 dark:text-slate-600"> / </span>
      <span>Çizelgeleme</span>
    </p>
    <h1 class="mt-2 max-w-3xl font-display text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl lg:text-5xl dark:text-white">
      {tool.title}
    </h1>
    <p class="mt-4 max-w-2xl text-base leading-relaxed text-slate-600 sm:text-lg dark:text-slate-400">
      Takımlarını yapıştır, devre tipini seç, fikstürü saniyeler içinde üret.
      Hesaplama tarayıcında yapılır — hiçbir veri sunucuya gönderilmez.
      {guideHref && (
        <>
          {' '}
          <a
            href={guideHref}
            class="font-medium text-brand-600 hover:text-brand-700 dark:text-accent-400 dark:hover:text-accent-300"
            >Algoritmayı detaylı öğrenmek için rehbere bak →</a
          >
        </>
      )}
    </p>
  </Container>

  <Container as="div" size="wide" class="grid gap-8 py-10 sm:py-12 lg:grid-cols-[minmax(0,360px)_1fr] print:block">
    <form
      id="fixture-form"
      class="space-y-6 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900/40 print:hidden"
      novalidate
    >
      <fieldset class="space-y-3">
        <div class="flex items-center justify-between gap-2">
          <label
            for="teams"
            class="block font-display text-sm font-semibold text-slate-900 dark:text-white"
          >
            Takımlar
          </label>
          <span
            id="team-count"
            class="text-xs text-slate-500 dark:text-slate-400"
            aria-live="polite"
          >
            0 takım
          </span>
        </div>
        <textarea
          id="teams"
          name="teams"
          rows="9"
          required
          autocomplete="off"
          spellcheck="false"
          class="block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 font-mono text-sm leading-relaxed text-slate-900 placeholder:text-slate-400 focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100 dark:placeholder:text-slate-600"
          placeholder="Her satıra bir takım yaz&#10;&#10;Galatasaray&#10;Fenerbahçe&#10;Beşiktaş&#10;Trabzonspor"
        ></textarea>
        <div class="flex flex-wrap gap-2">
          <button
            type="button"
            id="sample-btn"
            class="inline-flex items-center gap-1.5 rounded-md border border-slate-300 bg-white px-3 py-1.5 text-xs font-medium text-slate-700 hover:border-slate-400 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800"
          >
            Örnek doldur
          </button>
          <button
            type="button"
            id="clear-btn"
            class="inline-flex items-center gap-1.5 rounded-md border border-transparent bg-transparent px-3 py-1.5 text-xs font-medium text-slate-600 hover:bg-slate-100 dark:text-slate-400 dark:hover:bg-slate-800"
          >
            Temizle
          </button>
        </div>
      </fieldset>

      <fieldset class="space-y-4">
        <legend class="font-display text-sm font-semibold text-slate-900 dark:text-white">
          Devre tipi
        </legend>
        <div class="space-y-2">
          <label class="flex cursor-pointer items-start gap-3 rounded-lg border border-slate-200 bg-white p-3 has-[:checked]:border-brand-500 has-[:checked]:bg-brand-50 dark:border-slate-800 dark:bg-slate-900/40 dark:has-[:checked]:border-accent-500 dark:has-[:checked]:bg-slate-900">
            <input
              type="radio"
              name="rounds"
              value="single"
              checked
              class="mt-0.5 size-4 border-slate-300 text-brand-600 focus:ring-brand-500"
            />
            <span class="flex-1">
              <span class="block text-sm font-medium text-slate-900 dark:text-white">
                Tek devre
              </span>
              <span class="mt-0.5 block text-xs text-slate-500 dark:text-slate-400">
                Her takım birbiriyle bir kez oynar.
              </span>
            </span>
          </label>
          <label class="flex cursor-pointer items-start gap-3 rounded-lg border border-slate-200 bg-white p-3 has-[:checked]:border-brand-500 has-[:checked]:bg-brand-50 dark:border-slate-800 dark:bg-slate-900/40 dark:has-[:checked]:border-accent-500 dark:has-[:checked]:bg-slate-900">
            <input
              type="radio"
              name="rounds"
              value="double"
              class="mt-0.5 size-4 border-slate-300 text-brand-600 focus:ring-brand-500"
            />
            <span class="flex-1">
              <span class="block text-sm font-medium text-slate-900 dark:text-white">
                Çift devre
              </span>
              <span class="mt-0.5 block text-xs text-slate-500 dark:text-slate-400">
                İkinci yarı ilk yarının ev/deplasman ters çevrilmiş hâli.
              </span>
            </span>
          </label>
        </div>
      </fieldset>

      <fieldset class="space-y-3">
        <legend class="font-display text-sm font-semibold text-slate-900 dark:text-white">
          Tarihler <span class="font-normal text-slate-500">(opsiyonel)</span>
        </legend>
        <div class="space-y-3">
          <label class="block">
            <span class="text-xs font-medium text-slate-700 dark:text-slate-300">
              Başlangıç tarihi
            </span>
            <input
              type="date"
              id="startDate"
              name="startDate"
              class="mt-1 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100 dark:[color-scheme:dark]"
            />
          </label>
          <label class="block">
            <span class="text-xs font-medium text-slate-700 dark:text-slate-300">
              Maç günü
            </span>
            <select
              id="weeklyOn"
              name="weeklyOn"
              class="mt-1 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100 dark:[color-scheme:dark]"
            >
              {weekdays.map((d) => <option value={d.value}>{d.label}</option>)}
            </select>
          </label>
        </div>
      </fieldset>

      <button
        type="submit"
        class="inline-flex w-full items-center justify-center gap-2 rounded-lg bg-brand-700 px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-brand-800 dark:bg-accent-500 dark:text-brand-950 dark:hover:bg-accent-400"
      >
        Fikstürü oluştur
      </button>

      <div
        id="error-box"
        hidden
        role="alert"
        class="rounded-lg border border-red-300 bg-red-50 p-3 text-sm text-red-800 dark:border-red-900/50 dark:bg-red-950/30 dark:text-red-300"
      ></div>
    </form>

    <section
      id="output"
      hidden
      class="space-y-6"
      aria-live="polite"
      aria-atomic="false"
    >
      <header class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between print:block">
        <div>
          <h2 class="font-display text-xl font-semibold tracking-tight text-slate-900 dark:text-white">
            Fikstür
          </h2>
          <p
            id="summary"
            class="mt-1 text-sm text-slate-600 dark:text-slate-400"
          >
          </p>
        </div>
        <div class="flex flex-wrap gap-2 print:hidden">
          <button
            type="button"
            id="csv-btn"
            class="inline-flex items-center gap-1.5 rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:border-slate-400 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800"
          >
            CSV indir
          </button>
          <button
            type="button"
            id="print-btn"
            class="inline-flex items-center gap-1.5 rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:border-slate-400 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800"
          >
            Yazdır
          </button>
          <button
            type="button"
            id="share-btn"
            class="inline-flex items-center gap-1.5 rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 hover:border-slate-400 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800"
          >
            <span id="share-label">Paylaş</span>
          </button>
        </div>
      </header>

      <div role="tablist" class="flex gap-1 border-b border-slate-200 print:hidden dark:border-slate-800">
        <button
          type="button"
          role="tab"
          id="tab-week"
          aria-selected="true"
          aria-controls="view-week"
          class="border-b-2 border-brand-600 px-3 pb-2 text-sm font-medium text-brand-700 dark:border-accent-400 dark:text-accent-300"
        >
          Hafta hafta
        </button>
        <button
          type="button"
          role="tab"
          id="tab-team"
          aria-selected="false"
          aria-controls="view-team"
          class="border-b-2 border-transparent px-3 pb-2 text-sm font-medium text-slate-600 hover:border-slate-300 hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-200"
        >
          Takım bazlı
        </button>
      </div>

      <div id="view-week" role="tabpanel" aria-labelledby="tab-week" class="space-y-6"></div>
      <div id="view-team" role="tabpanel" aria-labelledby="tab-team" hidden class="space-y-6"></div>
    </section>
  </Container>

  {
    guideHref && (
      <Container as="section" size="wide" class="py-12 sm:py-16">
        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-8 dark:border-slate-800 dark:bg-slate-900/40">
          <p class="text-xs font-semibold uppercase tracking-wide text-brand-600 dark:text-accent-400">
            Konuyu derinleştir
          </p>
          <h2 class="mt-2 max-w-2xl font-display text-2xl font-semibold tracking-tight text-slate-900 dark:text-white">
            Round-robin algoritması nasıl çalışır?
          </h2>
          <p class="mt-3 max-w-2xl text-sm leading-relaxed text-slate-600 dark:text-slate-400">
            Fikstürün arkasındaki matematik, çift devre mantığı, bay takımlar ve
            Türkiye Süper Ligi pratiği üzerine 2500+ kelimelik kapsamlı rehber.
          </p>
          <a
            href={guideHref}
            class="mt-5 inline-flex items-center gap-1 text-sm font-semibold text-brand-700 hover:text-brand-800 dark:text-accent-300 dark:hover:text-accent-200"
          >
            Rehberi oku →
          </a>
        </div>
      </Container>
    )
  }
</BaseLayout>

<script>
  import {
    generateFixture,
    groupByTeam,
    fixtureToCsv,
    normalizeTeamList,
    FixtureError,
    type Fixture,
    type Weekday,
  } from '../../lib/fixture';

  const SAMPLE_TEAMS =
    'Galatasaray\nFenerbahçe\nBeşiktaş\nTrabzonspor\nBursaspor\nGöztepe\nSamsunspor\nKayserispor';

  const $ = <T extends HTMLElement = HTMLElement>(id: string): T => {
    const el = document.getElementById(id);
    if (!el) throw new Error(`Missing element: #${id}`);
    return el as T;
  };

  const form = $<HTMLFormElement>('fixture-form');
  const teamsInput = $<HTMLTextAreaElement>('teams');
  const teamCount = $('team-count');
  const startDateInput = $<HTMLInputElement>('startDate');
  const weeklyOnSelect = $<HTMLSelectElement>('weeklyOn');
  const errorBox = $('error-box');
  const output = $('output');
  const summary = $('summary');
  const viewWeek = $('view-week');
  const viewTeam = $('view-team');
  const tabWeek = $<HTMLButtonElement>('tab-week');
  const tabTeam = $<HTMLButtonElement>('tab-team');
  const csvBtn = $<HTMLButtonElement>('csv-btn');
  const printBtn = $<HTMLButtonElement>('print-btn');
  const shareBtn = $<HTMLButtonElement>('share-btn');
  const shareLabel = $('share-label');
  const sampleBtn = $<HTMLButtonElement>('sample-btn');
  const clearBtn = $<HTMLButtonElement>('clear-btn');

  let currentFixture: Fixture | null = null;

  const dateFormatter = new Intl.DateTimeFormat('tr-TR', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
    weekday: 'long',
  });

  function formatDate(iso: string | undefined): string {
    if (!iso) return '';
    const [y, m, d] = iso.split('-').map(Number);
    return dateFormatter.format(new Date(y, m - 1, d));
  }

  function escapeHtml(s: string): string {
    return s
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function updateTeamCount(): void {
    const count = normalizeTeamList(teamsInput.value).length;
    teamCount.textContent = `${count} takım`;
  }

  function showError(message: string): void {
    errorBox.textContent = message;
    errorBox.hidden = false;
    output.hidden = true;
  }

  function clearError(): void {
    errorBox.hidden = true;
    errorBox.textContent = '';
  }

  function readForm() {
    const teams = normalizeTeamList(teamsInput.value);
    const doubleRound =
      (form.elements.namedItem('rounds') as RadioNodeList)?.value === 'double';
    const startDate = startDateInput.value || null;
    const weeklyOnRaw = weeklyOnSelect.value;
    const weeklyOn =
      weeklyOnRaw === '' ? null : (Number(weeklyOnRaw) as Weekday);
    return { teams, doubleRound, startDate, weeklyOn };
  }

  function renderWeekView(fixture: Fixture): void {
    viewWeek.innerHTML = fixture.rounds
      .map((round) => {
        const heading = round.date
          ? `Hafta ${round.weekNumber} <span class="font-normal text-slate-500 dark:text-slate-400">— ${escapeHtml(formatDate(round.date))}</span>`
          : `Hafta ${round.weekNumber}`;
        const rows = round.entries
          .map((entry) => {
            if (entry.kind === 'bye') {
              return `<tr><td colspan="3" class="px-3 py-2 text-sm italic text-slate-500 dark:text-slate-400">Bay: ${escapeHtml(entry.team)}</td></tr>`;
            }
            return `<tr class="border-t border-slate-100 dark:border-slate-800"><td class="px-3 py-2 text-sm text-slate-900 dark:text-slate-100">${escapeHtml(entry.home)}</td><td class="px-3 py-2 text-center text-xs text-slate-400">vs</td><td class="px-3 py-2 text-sm text-slate-900 dark:text-slate-100">${escapeHtml(entry.away)}</td></tr>`;
          })
          .join('');
        return `<section class="rounded-xl border border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900/40">
          <header class="border-b border-slate-200 px-4 py-3 font-display text-sm font-semibold text-slate-900 dark:border-slate-800 dark:text-white">${heading}</header>
          <div class="overflow-x-auto"><table class="w-full"><tbody>${rows}</tbody></table></div>
        </section>`;
      })
      .join('');
  }

  function renderTeamView(fixture: Fixture): void {
    const teams = groupByTeam(fixture);
    viewTeam.innerHTML = teams
      .map((t) => {
        const rows = t.matches
          .map((m) => {
            const date = m.date
              ? escapeHtml(formatDate(m.date))
              : '<span class="text-slate-400">—</span>';
            const venueLabel =
              m.venue === 'home'
                ? '<span class="rounded bg-brand-100 px-1.5 py-0.5 text-[11px] font-medium text-brand-700 dark:bg-brand-900/40 dark:text-accent-300">Ev</span>'
                : m.venue === 'away'
                  ? '<span class="rounded bg-slate-100 px-1.5 py-0.5 text-[11px] font-medium text-slate-700 dark:bg-slate-800 dark:text-slate-300">Dep</span>'
                  : '<span class="rounded bg-amber-100 px-1.5 py-0.5 text-[11px] font-medium text-amber-700 dark:bg-amber-900/40 dark:text-amber-300">Bay</span>';
            const opponent =
              m.venue === 'bye'
                ? '<span class="text-slate-400 italic">—</span>'
                : escapeHtml(m.opponent);
            return `<tr class="border-t border-slate-100 dark:border-slate-800"><td class="px-3 py-1.5 text-xs text-slate-500 dark:text-slate-400">H${m.weekNumber}</td><td class="px-3 py-1.5 text-xs text-slate-600 dark:text-slate-400">${date}</td><td class="px-3 py-1.5 text-sm text-slate-900 dark:text-slate-100">${opponent}</td><td class="px-3 py-1.5">${venueLabel}</td></tr>`;
          })
          .join('');
        return `<section class="rounded-xl border border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900/40">
          <header class="border-b border-slate-200 px-4 py-3 font-display text-sm font-semibold text-slate-900 dark:border-slate-800 dark:text-white">${escapeHtml(t.team)}</header>
          <div class="overflow-x-auto"><table class="w-full"><tbody>${rows}</tbody></table></div>
        </section>`;
      })
      .join('');
  }

  function renderSummary(fixture: Fixture): void {
    const parts = [
      `${fixture.teamCount} takım`,
      `${fixture.rounds.length} hafta`,
      `${fixture.totalMatches} maç`,
    ];
    if (fixture.doubleRound) parts.push('çift devre');
    if (fixture.hasBye) parts.push('bay rotasyonlu');
    summary.textContent = parts.join(' · ');
  }

  function syncUrl(input: ReturnType<typeof readForm>): void {
    const params = new URLSearchParams();
    params.set('teams', input.teams.join('|'));
    if (input.doubleRound) params.set('double', '1');
    if (input.startDate) params.set('start', input.startDate);
    if (input.weeklyOn !== null) params.set('day', String(input.weeklyOn));
    const url = `${window.location.pathname}?${params.toString()}`;
    window.history.replaceState(null, '', url);
  }

  function loadFromUrl(): boolean {
    const params = new URLSearchParams(window.location.search);
    const teamsParam = params.get('teams');
    if (!teamsParam) return false;
    teamsInput.value = teamsParam.split('|').join('\n');
    const isDouble = params.get('double') === '1';
    const radio = form.querySelector<HTMLInputElement>(
      `input[name="rounds"][value="${isDouble ? 'double' : 'single'}"]`,
    );
    if (radio) radio.checked = true;
    const start = params.get('start');
    if (start) startDateInput.value = start;
    const day = params.get('day');
    if (day !== null) weeklyOnSelect.value = day;
    updateTeamCount();
    return true;
  }

  function setActiveTab(which: 'week' | 'team'): void {
    const isWeek = which === 'week';
    tabWeek.setAttribute('aria-selected', String(isWeek));
    tabTeam.setAttribute('aria-selected', String(!isWeek));
    tabWeek.className = isWeek
      ? 'border-b-2 border-brand-600 px-3 pb-2 text-sm font-medium text-brand-700 dark:border-accent-400 dark:text-accent-300'
      : 'border-b-2 border-transparent px-3 pb-2 text-sm font-medium text-slate-600 hover:border-slate-300 hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-200';
    tabTeam.className = !isWeek
      ? 'border-b-2 border-brand-600 px-3 pb-2 text-sm font-medium text-brand-700 dark:border-accent-400 dark:text-accent-300'
      : 'border-b-2 border-transparent px-3 pb-2 text-sm font-medium text-slate-600 hover:border-slate-300 hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-200';
    viewWeek.hidden = !isWeek;
    viewTeam.hidden = isWeek;
  }

  function generate(): void {
    clearError();
    const input = readForm();
    try {
      const fixture = generateFixture(input);
      currentFixture = fixture;
      renderSummary(fixture);
      renderWeekView(fixture);
      renderTeamView(fixture);
      setActiveTab('week');
      output.hidden = false;
      syncUrl(input);
      output.scrollIntoView({ behavior: 'smooth', block: 'start' });
    } catch (err) {
      currentFixture = null;
      const msg =
        err instanceof FixtureError
          ? err.message
          : err instanceof Error
            ? err.message
            : 'Bilinmeyen hata oluştu.';
      showError(msg);
    }
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    generate();
  });

  teamsInput.addEventListener('input', updateTeamCount);

  sampleBtn.addEventListener('click', () => {
    teamsInput.value = SAMPLE_TEAMS;
    updateTeamCount();
    teamsInput.focus();
  });

  clearBtn.addEventListener('click', () => {
    form.reset();
    updateTeamCount();
    clearError();
    output.hidden = true;
    currentFixture = null;
    window.history.replaceState(null, '', window.location.pathname);
  });

  tabWeek.addEventListener('click', () => setActiveTab('week'));
  tabTeam.addEventListener('click', () => setActiveTab('team'));

  csvBtn.addEventListener('click', () => {
    if (!currentFixture) return;
    const csv = fixtureToCsv(currentFixture);
    const blob = new Blob(['﻿' + csv], { type: 'text/csv;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'fikstur.csv';
    document.body.appendChild(a);
    a.click();
    a.remove();
    URL.revokeObjectURL(url);
  });

  printBtn.addEventListener('click', () => window.print());

  shareBtn.addEventListener('click', async () => {
    const url = window.location.href;
    try {
      await navigator.clipboard.writeText(url);
      shareLabel.textContent = 'Bağlantı kopyalandı';
      setTimeout(() => {
        shareLabel.textContent = 'Paylaş';
      }, 2000);
    } catch {
      shareLabel.textContent = 'Kopyalanamadı';
      setTimeout(() => {
        shareLabel.textContent = 'Paylaş';
      }, 2000);
    }
  });

  /* Boot */
  updateTeamCount();
  if (loadFromUrl()) {
    generate();
  }
</script>

