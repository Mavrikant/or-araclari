---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import { withBase, SITE } from '../../data/site';
import { TOOLS } from '../../data/tools';

const tool = TOOLS.find((t) => t.slug === 'erlang-a-bekleme-birakma')!;
const guideHref = tool.guideSlug ? withBase(`/rehberler/${tool.guideSlug}`) : null;

const softwareJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: tool.title,
  applicationCategory: 'WebApplication',
  operatingSystem: 'Any',
  description: tool.description,
  url: new URL(Astro.url.pathname, Astro.site).toString(),
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'TRY' },
  inLanguage: SITE.locale,
  isAccessibleForFree: true,
};
---

<BaseLayout
  title={tool.title}
  description={tool.description}
  image={withBase(`/og/${tool.slug}.png`)}
  imageAlt={`${tool.title} — OR Araçları`}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(softwareJsonLd)} />
  </Fragment>

  <Container as="section" size="wide" class="pt-12 sm:pt-16">
    <p class="text-sm font-medium text-brand-600 dark:text-accent-400">
      <a href={withBase('/araclar')} class="hover:underline">Araçlar</a>
      <span class="text-slate-400 dark:text-slate-600"> / </span>
      <span>Olasılık & Kuyruk</span>
    </p>
    <h1 class="mt-2 max-w-3xl font-display text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl lg:text-5xl dark:text-white">
      {tool.title}
    </h1>
    <p class="mt-4 max-w-2xl text-base leading-relaxed text-slate-600 sm:text-lg dark:text-slate-400">
      Geliş hızı (λ), her sunucunun hizmet hızı (μ), sunucu sayısı (c) ve
      bekleyen müşteri başına bırakma (abandonment) hızı (θ) ver; Erlang-A
      modeli bırakma olasılığını P(abandon), efektif servis hızını,
      ortalama bekleme süresini ve durum dağılımını tarayıcıda anlık
      hesaplasın. θ &gt; 0 olduğunda sistem λ ≥ c·μ olsa bile kararlıdır
      — bırakmalar drift sağlar.
      {guideHref && (
        <a href={guideHref} class="font-medium text-brand-600 hover:text-brand-700 dark:text-accent-400 dark:hover:text-accent-300"> Rehbere git →</a>
      )}
    </p>
  </Container>

  <Container as="div" size="wide" class="grid gap-8 py-10 sm:py-12 lg:grid-cols-[minmax(0,340px)_1fr] print:block">
    <form id="erlanga-form" class="space-y-6 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900/40 print:hidden" novalidate>
      <div class="flex flex-wrap gap-2">
        <button type="button" id="sample-callcenter-btn" class="inline-flex items-center gap-1.5 rounded-md border border-slate-300 bg-white px-3 py-1.5 text-xs font-medium text-slate-700 hover:border-slate-400 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800">
          Çağrı merkezi
        </button>
        <button type="button" id="sample-overload-btn" class="inline-flex items-center gap-1.5 rounded-md border border-slate-300 bg-white px-3 py-1.5 text-xs font-medium text-slate-700 hover:border-slate-400 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800">
          Aşırı yüklü (λ &gt; c·μ)
        </button>
        <button type="button" id="reset-btn" class="inline-flex items-center gap-1.5 rounded-md border border-transparent bg-transparent px-3 py-1.5 text-xs font-medium text-slate-600 hover:bg-slate-100 dark:text-slate-400 dark:hover:bg-slate-800">
          Sıfırla
        </button>
      </div>

      <fieldset class="space-y-3">
        <legend class="font-display text-sm font-semibold text-slate-900 dark:text-white">
          Girdiler
        </legend>
        <label class="block">
          <span class="text-xs font-medium text-slate-700 dark:text-slate-300">
            Geliş hızı (λ, çağrı/birim zaman)
          </span>
          <input type="number" id="lambda-input" min="0.001" step="any" inputmode="decimal" required value="20"
            class="mt-1 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100" />
        </label>
        <label class="block">
          <span class="text-xs font-medium text-slate-700 dark:text-slate-300">
            Hizmet hızı (μ, çağrı/birim zaman — her sunucu)
          </span>
          <input type="number" id="mu-input" min="0.001" step="any" inputmode="decimal" required value="6"
            class="mt-1 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100" />
        </label>
        <label class="block">
          <span class="text-xs font-medium text-slate-700 dark:text-slate-300">
            Sunucu sayısı (c)
          </span>
          <input type="number" id="c-input" min="1" step="1" inputmode="numeric" required value="4"
            class="mt-1 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100" />
        </label>
        <label class="block">
          <span class="text-xs font-medium text-slate-700 dark:text-slate-300">
            Bırakma hızı (θ, bekleyen başına bırakma/birim zaman)
          </span>
          <input type="number" id="theta-input" min="0" step="any" inputmode="decimal" required value="1"
            class="mt-1 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100" />
        </label>
        <p class="text-xs text-slate-500 dark:text-slate-400">
          θ = 0 ise sistem M/M/c'ye (Erlang-C) indirgenir; bu hâlde
          c·μ &gt; λ olmalıdır. θ &gt; 0 her ρ için kararlıdır. Ortalama
          sabır süresi 1/θ.
        </p>
      </fieldset>

      <button type="submit" class="inline-flex w-full items-center justify-center gap-2 rounded-lg bg-brand-700 px-4 py-2.5 text-sm font-semibold text-white hover:bg-brand-800 dark:bg-accent-500 dark:text-brand-950 dark:hover:bg-accent-400">
        Analiz et
      </button>

      <div id="error-box" hidden role="alert" class="rounded-lg border border-red-300 bg-red-50 p-3 text-sm text-red-800 dark:border-red-900/50 dark:bg-red-950/30 dark:text-red-300"></div>
    </form>

    <section id="output" hidden aria-live="polite" class="space-y-6">
      <div id="abandon-card" class="rounded-2xl border p-5">
        <p id="abandon-label" class="text-xs font-medium uppercase tracking-wide"></p>
        <p id="abandon-value" class="mt-1 font-display text-4xl font-bold tabular-nums"></p>
        <p id="abandon-detail" class="mt-1 text-xs"></p>
      </div>

      <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
        <div class="rounded-lg border border-slate-200 bg-white p-3 dark:border-slate-800 dark:bg-slate-900/40">
          <div class="text-xs font-medium text-slate-500 dark:text-slate-400">Sunulan yük (a = λ/μ)</div>
          <div id="m-a" class="mt-1 font-display text-lg font-bold tabular-nums text-slate-900 dark:text-white"></div>
        </div>
        <div class="rounded-lg border border-slate-200 bg-white p-3 dark:border-slate-800 dark:bg-slate-900/40">
          <div class="text-xs font-medium text-slate-500 dark:text-slate-400">Sunucu yoğunluğu (ρ = a/c)</div>
          <div id="m-rho" class="mt-1 font-display text-lg font-bold tabular-nums text-slate-900 dark:text-white"></div>
        </div>
        <div class="rounded-lg border border-slate-200 bg-white p-3 dark:border-slate-800 dark:bg-slate-900/40">
          <div class="text-xs font-medium text-slate-500 dark:text-slate-400">Boşta olma (P₀)</div>
          <div id="m-p0" class="mt-1 font-display text-lg font-bold tabular-nums text-slate-900 dark:text-white"></div>
        </div>
        <div class="rounded-lg border border-slate-200 bg-white p-3 dark:border-slate-800 dark:bg-slate-900/40">
          <div class="text-xs font-medium text-slate-500 dark:text-slate-400">Bekleme olasılığı P(W&gt;0)</div>
          <div id="m-pw" class="mt-1 font-display text-lg font-bold tabular-nums text-slate-900 dark:text-white"></div>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
        <div class="rounded-lg border border-slate-200 bg-white p-3 dark:border-slate-800 dark:bg-slate-900/40">
          <div class="text-xs font-medium text-slate-500 dark:text-slate-400">Sistemde ort. (L)</div>
          <div id="m-L" class="mt-1 font-display text-lg font-bold tabular-nums text-slate-900 dark:text-white"></div>
        </div>
        <div class="rounded-lg border border-slate-200 bg-white p-3 dark:border-slate-800 dark:bg-slate-900/40">
          <div class="text-xs font-medium text-slate-500 dark:text-slate-400">Kuyrukta ort. (Lq)</div>
          <div id="m-Lq" class="mt-1 font-display text-lg font-bold tabular-nums text-slate-900 dark:text-white"></div>
        </div>
        <div class="rounded-lg border border-slate-200 bg-white p-3 dark:border-slate-800 dark:bg-slate-900/40">
          <div class="text-xs font-medium text-slate-500 dark:text-slate-400">Sistemde süre (W)</div>
          <div id="m-W" class="mt-1 font-display text-lg font-bold tabular-nums text-slate-900 dark:text-white"></div>
        </div>
        <div class="rounded-lg border border-slate-200 bg-white p-3 dark:border-slate-800 dark:bg-slate-900/40">
          <div class="text-xs font-medium text-slate-500 dark:text-slate-400">Kuyrukta süre (Wq)</div>
          <div id="m-Wq" class="mt-1 font-display text-lg font-bold tabular-nums text-slate-900 dark:text-white"></div>
        </div>
      </div>

      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
        <div class="rounded-lg border border-amber-300 bg-amber-50/60 p-4 dark:border-amber-800/60 dark:bg-amber-950/20">
          <div class="text-xs font-medium uppercase tracking-wide text-amber-800 dark:text-amber-300">Efektif bırakma hızı (λ<sub>aban</sub> = θ·Lq)</div>
          <div id="m-laban" class="mt-1 font-display text-xl font-bold tabular-nums text-amber-900 dark:text-amber-100"></div>
        </div>
        <div class="rounded-lg border border-emerald-300 bg-emerald-50/60 p-4 dark:border-emerald-800/60 dark:bg-emerald-950/20">
          <div class="text-xs font-medium uppercase tracking-wide text-emerald-800 dark:text-emerald-300">Efektif servis hızı (λ<sub>served</sub> = λ − λ<sub>aban</sub>)</div>
          <div id="m-lserved" class="mt-1 font-display text-xl font-bold tabular-nums text-emerald-900 dark:text-emerald-100"></div>
        </div>
      </div>

      <div>
        <h2 class="font-display text-base font-semibold text-slate-900 dark:text-white">
          Durum olasılıkları
        </h2>
        <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">
          P(n) — sistemde tam olarak n müşteri olma olasılığı. n &lt; c kısmı
          sunucular dolmadan; n ≥ c kısmı kuyruk birikmeye başladıktan
          sonra (bekleme + olası bırakma bölgesi). Sarı kesik çizgi c.
        </p>
        <div id="state-chart" class="mt-3 overflow-hidden rounded-xl border border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900/40"></div>
      </div>

      <div>
        <h2 class="font-display text-base font-semibold text-slate-900 dark:text-white">
          Bırakma hızı (θ) duyarlılığı
        </h2>
        <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">
          Aynı λ, μ, c için θ değiştikçe bırakma olasılığı, Lq ve Wq nasıl
          değişir? Müşteri sabrı azalınca (θ büyük) kuyruk hızla
          kısalır ama daha çok kişi vazgeçer.
        </p>
        <div class="mt-3 overflow-x-auto rounded-xl border border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900/40">
          <table class="w-full min-w-[460px] text-sm">
            <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500 dark:bg-slate-900/60 dark:text-slate-400">
              <tr>
                <th class="px-3 py-2 text-left">θ</th>
                <th class="px-3 py-2 text-right">1/θ (ort. sabır)</th>
                <th class="px-3 py-2 text-right">P(abandon)</th>
                <th class="px-3 py-2 text-right">Lq</th>
                <th class="px-3 py-2 text-right">Wq</th>
              </tr>
            </thead>
            <tbody id="sensitivity-body" class="divide-y divide-slate-100 dark:divide-slate-800"></tbody>
          </table>
        </div>
      </div>
    </section>
  </Container>

  {guideHref && (
    <Container as="section" size="wide" class="py-12 sm:py-16">
      <div class="rounded-2xl border border-slate-200 bg-slate-50 p-8 dark:border-slate-800 dark:bg-slate-900/40">
        <p class="text-xs font-semibold uppercase tracking-wide text-brand-600 dark:text-accent-400">
          Konuyu derinleştir
        </p>
        <h2 class="mt-2 max-w-2xl font-display text-2xl font-semibold tracking-tight text-slate-900 dark:text-white">
          Erlang-A, sabırsız müşteri ve QED rejimi
        </h2>
        <p class="mt-3 max-w-2xl text-sm text-slate-600 dark:text-slate-400">
          Bırakmanın matematiksel modeli, Erlang-C'nin nerede yetersiz
          kaldığı, Garnett-Mandelbaum-Reiman QED ölçeklendirmesi, çağrı
          merkezi pratiği ve sayısal örnekler.
        </p>
        <a href={guideHref} class="mt-5 inline-flex items-center gap-1 text-sm font-semibold text-brand-700 hover:text-brand-800 dark:text-accent-300 dark:hover:text-accent-200">
          Rehberi oku →
        </a>
      </div>
    </Container>
  )}
</BaseLayout>

<script>
  import { analyzeErlangA, ErlangAError, type ErlangAResult } from '../../lib/queue-erlang-a';

  const STORAGE_KEY = 'erlanga-state-v1';
  const SAMPLE_CALLCENTER = { lambda: 20, mu: 6, c: 4, theta: 1 };
  const SAMPLE_OVERLOAD = { lambda: 30, mu: 5, c: 4, theta: 2 }; /* ρ = 1.5 ama θ ile kararlı */

  const $ = <T extends HTMLElement = HTMLElement>(id: string): T => {
    const el = document.getElementById(id);
    if (!el) throw new Error(`Missing #${id}`);
    return el as T;
  };

  function fmt(n: number, decimals = 3): string {
    if (!Number.isFinite(n)) return '—';
    if (Math.abs(n) < 1e-9) return '0';
    return n.toFixed(decimals).replace(/\.?0+$/, '');
  }

  const form = $<HTMLFormElement>('erlanga-form');
  const lambdaInput = $<HTMLInputElement>('lambda-input');
  const muInput = $<HTMLInputElement>('mu-input');
  const cInput = $<HTMLInputElement>('c-input');
  const thetaInput = $<HTMLInputElement>('theta-input');
  const sampleCcBtn = $('sample-callcenter-btn');
  const sampleOlBtn = $('sample-overload-btn');
  const resetBtn = $('reset-btn');
  const errorBox = $('error-box');
  const output = $('output');
  const abandonCard = $('abandon-card');
  const abandonLabel = $('abandon-label');
  const abandonValue = $('abandon-value');
  const abandonDetail = $('abandon-detail');
  const mA = $('m-a');
  const mRho = $('m-rho');
  const mP0 = $('m-p0');
  const mPw = $('m-pw');
  const mL = $('m-L');
  const mLq = $('m-Lq');
  const mW = $('m-W');
  const mWq = $('m-Wq');
  const mLaban = $('m-laban');
  const mLserved = $('m-lserved');
  const stateChart = $('state-chart');
  const sensitivityBody = $('sensitivity-body');

  type SavedState = { lambda?: number; mu?: number; c?: number; theta?: number };
  function loadState(): void {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return;
      const s = JSON.parse(raw) as SavedState;
      if (typeof s.lambda === 'number') lambdaInput.value = String(s.lambda);
      if (typeof s.mu === 'number') muInput.value = String(s.mu);
      if (typeof s.c === 'number') cInput.value = String(s.c);
      if (typeof s.theta === 'number') thetaInput.value = String(s.theta);
    } catch {
      /* önemsiz. */
    }
  }
  function saveState(): void {
    try {
      localStorage.setItem(
        STORAGE_KEY,
        JSON.stringify({
          lambda: Number(lambdaInput.value) || 0,
          mu: Number(muInput.value) || 0,
          c: Number(cInput.value) || 0,
          theta: Number(thetaInput.value) || 0,
        } satisfies SavedState),
      );
    } catch {
      /* önemsiz. */
    }
  }
  loadState();

  function renderChart(result: ErlangAResult): void {
    /* Maksimum gösterim 30 durumdan kesilir (mobil okunabilirlik). */
    const fullProbs = result.stateProbabilities;
    const displayMax = Math.min(fullProbs.length, 30);
    const probs = fullProbs.slice(0, displayMax);
    const c = result.servers;
    const W = 720;
    const H = 280;
    const PL = 44;
    const PR = 16;
    const PT = 16;
    const PB = 36;

    const maxP = Math.max(...probs);
    const barW = (W - PL - PR) / probs.length;
    const sx = (n: number) => PL + n * barW;
    const sy = (p: number) => H - PB - (p / maxP) * (H - PT - PB);

    const bars = probs
      .map((p, n) => {
        const x = sx(n) + 2;
        const y = sy(p);
        const h = H - PB - y;
        const colorCls = n < c
          ? 'fill-brand-600 dark:fill-accent-400'
          : 'fill-amber-500 dark:fill-amber-400';
        return `<rect x="${x.toFixed(1)}" y="${y.toFixed(1)}" width="${(barW - 4).toFixed(1)}" height="${h.toFixed(1)}" class="${colorCls}" />
          <text x="${(x + (barW - 4) / 2).toFixed(1)}" y="${H - PB + 14}" text-anchor="middle" class="fill-slate-500 text-[10px] dark:fill-slate-400">${n}</text>`;
      })
      .join('');

    const yTicks = [0, maxP / 2, maxP]
      .map((p) => `<text x="${PL - 4}" y="${sy(p) + 3}" text-anchor="end" class="fill-slate-500 text-[10px] dark:fill-slate-400">${fmt(p, 3)}</text>`)
      .join('');

    const cx = sx(c);
    const cLine = `<line x1="${cx.toFixed(1)}" y1="${PT}" x2="${cx.toFixed(1)}" y2="${H - PB}" class="stroke-amber-600 dark:stroke-amber-300" stroke-width="1" stroke-dasharray="4 3" />
      <text x="${(cx + 4).toFixed(1)}" y="${PT + 10}" class="fill-amber-700 text-[10px] dark:fill-amber-300">n = c (${c})</text>`;

    const truncated = fullProbs.length > displayMax
      ? `<text x="${W - PR}" y="${PT + 10}" text-anchor="end" class="fill-slate-500 text-[10px] dark:fill-slate-400">n ≥ ${displayMax}: tail kesildi</text>`
      : '';

    stateChart.innerHTML = `<svg viewBox="0 0 ${W} ${H}" class="block w-full h-auto" role="img" aria-label="Durum olasılıkları çubuk grafiği">
      <line x1="${PL}" y1="${H - PB}" x2="${W - PR}" y2="${H - PB}" class="stroke-slate-300 dark:stroke-slate-700" stroke-width="1" />
      <line x1="${PL}" y1="${PT}" x2="${PL}" y2="${H - PB}" class="stroke-slate-300 dark:stroke-slate-700" stroke-width="1" />
      ${bars}${cLine}${yTicks}${truncated}
      <text x="${(W + PL) / 2}" y="${H - 4}" text-anchor="middle" class="fill-slate-500 text-[10px] dark:fill-slate-400">Sistemdeki müşteri sayısı (n)</text>
      <text x="14" y="${(H - PT - PB) / 2 + PT}" transform="rotate(-90 14 ${(H - PT - PB) / 2 + PT})" text-anchor="middle" class="fill-slate-500 text-[10px] dark:fill-slate-400">P(n)</text>
    </svg>`;
  }

  function renderAbandon(result: ErlangAResult): void {
    const p = result.probAbandon;
    let tone: 'good' | 'mid' | 'bad';
    let advice: string;
    if (p < 0.02) {
      tone = 'good';
      advice = 'Bırakma sıfıra yakın — sunucu kapasitesi rahatlıkla yetiyor.';
    } else if (p < 0.1) {
      tone = 'mid';
      advice = 'Görece kabul edilebilir bırakma — endüstri SLA eşiklerine (≤5%) yakın.';
    } else {
      tone = 'bad';
      advice = 'Yüksek bırakma — sunucu eklemeyi ya da hizmet süresini düşürmeyi değerlendirin.';
    }
    const cardCls: Record<typeof tone, string> = {
      good: 'rounded-2xl border border-emerald-300 bg-emerald-50 p-5 dark:border-emerald-800/60 dark:bg-emerald-950/30',
      mid: 'rounded-2xl border border-amber-300 bg-amber-50 p-5 dark:border-amber-800/60 dark:bg-amber-950/30',
      bad: 'rounded-2xl border border-red-300 bg-red-50 p-5 dark:border-red-800/60 dark:bg-red-950/30',
    };
    const labelCls: Record<typeof tone, string> = {
      good: 'text-xs font-medium uppercase tracking-wide text-emerald-700 dark:text-emerald-300',
      mid: 'text-xs font-medium uppercase tracking-wide text-amber-700 dark:text-amber-300',
      bad: 'text-xs font-medium uppercase tracking-wide text-red-700 dark:text-red-300',
    };
    const valueCls: Record<typeof tone, string> = {
      good: 'mt-1 font-display text-4xl font-bold tabular-nums text-emerald-900 dark:text-emerald-100',
      mid: 'mt-1 font-display text-4xl font-bold tabular-nums text-amber-900 dark:text-amber-100',
      bad: 'mt-1 font-display text-4xl font-bold tabular-nums text-red-900 dark:text-red-100',
    };
    const detailCls: Record<typeof tone, string> = {
      good: 'mt-1 text-xs text-emerald-800 dark:text-emerald-300',
      mid: 'mt-1 text-xs text-amber-800 dark:text-amber-300',
      bad: 'mt-1 text-xs text-red-800 dark:text-red-300',
    };
    abandonCard.className = cardCls[tone];
    abandonLabel.className = labelCls[tone];
    abandonValue.className = valueCls[tone];
    abandonDetail.className = detailCls[tone];
    abandonLabel.textContent = 'Bırakma olasılığı P(abandon)';
    abandonValue.textContent = `${fmt(p * 100, 2)}%`;
    abandonDetail.textContent = `${advice} Sabırsız müşteri payı = λ_aban / λ. ${fmt(result.abandonRate, 3)} müşteri/birim zaman vazgeçiyor.`;
  }

  function renderSensitivity(lambda: number, mu: number, c: number, theta: number): void {
    /* θ taraması: 0 (eğer ρ<1) + mevcut θ etrafında log-skala 5 değer. */
    const thetas: number[] = [];
    const rho = lambda / (c * mu);
    if (rho < 1) thetas.push(0);
    const multipliers = [0.25, 0.5, 1, 2, 4];
    for (const m of multipliers) {
      const t = theta * m;
      if (t > 0 && !thetas.includes(t)) thetas.push(t);
    }
    thetas.sort((a, b) => a - b);

    const rows = thetas.map((t) => {
      try {
        const r = analyzeErlangA({ arrivalRate: lambda, serviceRate: mu, servers: c, abandonmentRate: t });
        const highlight = Math.abs(t - theta) < 1e-9 ? 'bg-brand-50 font-semibold text-brand-900 dark:bg-accent-500/10 dark:text-accent-100' : '';
        const meanPatience = t > 0 ? fmt(1 / t, 3) : '∞ (M/M/c)';
        return `<tr class="${highlight}">
          <td class="px-3 py-2 tabular-nums">${fmt(t, 4)}</td>
          <td class="px-3 py-2 text-right tabular-nums">${meanPatience}</td>
          <td class="px-3 py-2 text-right tabular-nums">${fmt(r.probAbandon * 100, 2)}%</td>
          <td class="px-3 py-2 text-right tabular-nums">${fmt(r.avgInQueue, 3)}</td>
          <td class="px-3 py-2 text-right tabular-nums">${fmt(r.avgTimeInQueue, 3)}</td>
        </tr>`;
      } catch {
        return `<tr class="text-slate-400 dark:text-slate-600">
          <td class="px-3 py-2">${fmt(t, 4)}</td>
          <td class="px-3 py-2 text-right" colspan="4">kararsız (θ=0 ve c·μ ≤ λ)</td>
        </tr>`;
      }
    });
    sensitivityBody.innerHTML = rows.join('');
  }

  function showError(msg: string): void {
    errorBox.textContent = msg;
    errorBox.hidden = false;
    output.hidden = true;
  }
  function clearError(): void {
    errorBox.hidden = true;
    errorBox.textContent = '';
  }

  function applySample(s: typeof SAMPLE_CALLCENTER): void {
    lambdaInput.value = String(s.lambda);
    muInput.value = String(s.mu);
    cInput.value = String(s.c);
    thetaInput.value = String(s.theta);
    saveState();
    clearError();
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    clearError();
    saveState();
    try {
      const lambda = Number(lambdaInput.value);
      const mu = Number(muInput.value);
      const c = Number(cInput.value);
      const theta = Number(thetaInput.value);
      const r = analyzeErlangA({
        arrivalRate: lambda,
        serviceRate: mu,
        servers: c,
        abandonmentRate: theta,
      });
      renderAbandon(r);
      mA.textContent = fmt(r.offeredLoad, 3);
      mRho.textContent = fmt(r.utilisation, 3);
      mP0.textContent = fmt(r.probEmpty, 4);
      mPw.textContent = fmt(r.probWait, 4);
      mL.textContent = fmt(r.avgInSystem, 3) + ' müşteri';
      mLq.textContent = fmt(r.avgInQueue, 3) + ' müşteri';
      mW.textContent = fmt(r.avgTimeInSystem, 3) + ' birim';
      mWq.textContent = fmt(r.avgTimeInQueue, 3) + ' birim';
      mLaban.textContent = fmt(r.abandonRate, 3) + ' /birim';
      mLserved.textContent = fmt(r.effectiveServedRate, 3) + ' /birim';
      renderChart(r);
      renderSensitivity(lambda, mu, c, theta);
      output.hidden = false;
      output.scrollIntoView({ behavior: 'smooth', block: 'start' });
    } catch (err) {
      const msg =
        err instanceof ErlangAError ? err.message : err instanceof Error ? err.message : 'Bilinmeyen hata.';
      showError(msg);
    }
  });

  [lambdaInput, muInput, cInput, thetaInput].forEach((el) => el.addEventListener('input', saveState));
  sampleCcBtn.addEventListener('click', () => applySample(SAMPLE_CALLCENTER));
  sampleOlBtn.addEventListener('click', () => applySample(SAMPLE_OVERLOAD));
  resetBtn.addEventListener('click', () => {
    if (!confirm('Form sıfırlanacak. Devam edilsin mi?')) return;
    form.reset();
    try {
      localStorage.removeItem(STORAGE_KEY);
    } catch {
      /* önemsiz. */
    }
    clearError();
    output.hidden = true;
  });
</script>
