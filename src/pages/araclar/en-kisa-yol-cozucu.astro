---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import { withBase, SITE } from '../../data/site';
import { TOOLS } from '../../data/tools';

const tool = TOOLS.find((t) => t.slug === 'en-kisa-yol-cozucu')!;
const guideHref = tool.guideSlug ? withBase(`/rehberler/${tool.guideSlug}`) : null;

const softwareJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: tool.title,
  applicationCategory: 'WebApplication',
  operatingSystem: 'Any',
  description: tool.description,
  url: new URL(Astro.url.pathname, Astro.site).toString(),
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'TRY' },
  inLanguage: SITE.locale,
  isAccessibleForFree: true,
};
---

<BaseLayout
  title={tool.title}
  description={tool.description}
  image={withBase(`/og/${tool.slug}.png`)}
  imageAlt={`${tool.title} — OR Araçları`}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(softwareJsonLd)} />
  </Fragment>

  <Container as="section" size="wide" class="pt-12 sm:pt-16">
    <p class="text-sm font-medium text-brand-600 dark:text-accent-400">
      <a href={withBase('/araclar')} class="hover:underline">Araçlar</a>
      <span class="text-slate-400 dark:text-slate-600"> / </span>
      <span>Graf & Rota</span>
    </p>
    <h1 class="mt-2 max-w-3xl font-display text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl lg:text-5xl dark:text-white">
      {tool.title}
    </h1>
    <p class="mt-4 max-w-2xl text-base leading-relaxed text-slate-600 sm:text-lg dark:text-slate-400">
      Yönlü ağırlıklı ağda kaynaktan (s) tüm düğümlere ya da seçilen
      hedefe (t) en kısa yolu bul. Ağırlıklar negatif değilse
      <strong>Dijkstra</strong> (binary heap), aksi hâlde
      <strong>Bellman-Ford</strong> otomatik seçilir; Bellman-Ford
      ayrıca <strong>negatif çevrim</strong> tespit eder.
      {guideHref && (
        <a href={guideHref} class="font-medium text-brand-600 hover:text-brand-700 dark:text-accent-400 dark:hover:text-accent-300"> Rehbere git →</a>
      )}
    </p>
  </Container>

  <Container as="div" size="wide" class="grid gap-8 py-10 sm:py-12 lg:grid-cols-[minmax(0,380px)_1fr] print:block">
    <form id="sp-form" class="space-y-6 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900/40 print:hidden" novalidate>
      <div class="flex flex-wrap gap-2">
        <button type="button" id="sample-clrs-btn" class="inline-flex items-center gap-1.5 rounded-md border border-slate-300 bg-white px-3 py-1.5 text-xs font-medium text-slate-700 hover:border-slate-400 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800">
          Dijkstra (CLRS)
        </button>
        <button type="button" id="sample-bf-btn" class="inline-flex items-center gap-1.5 rounded-md border border-slate-300 bg-white px-3 py-1.5 text-xs font-medium text-slate-700 hover:border-slate-400 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800">
          Bellman-Ford (negatif)
        </button>
        <button type="button" id="sample-cycle-btn" class="inline-flex items-center gap-1.5 rounded-md border border-slate-300 bg-white px-3 py-1.5 text-xs font-medium text-slate-700 hover:border-slate-400 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800">
          Negatif çevrim
        </button>
        <button type="button" id="reset-btn" class="inline-flex items-center gap-1.5 rounded-md border border-transparent bg-transparent px-3 py-1.5 text-xs font-medium text-slate-600 hover:bg-slate-100 dark:text-slate-400 dark:hover:bg-slate-800">
          Sıfırla
        </button>
      </div>

      <fieldset class="space-y-3">
        <legend class="font-display text-sm font-semibold text-slate-900 dark:text-white">
          Kenarlar
        </legend>
        <label class="block">
          <span class="text-xs font-medium text-slate-700 dark:text-slate-300">
            Her satır: <span class="font-mono">kaynak hedef ağırlık</span> (boşluk, virgül veya tab ile ayır)
          </span>
          <textarea id="edges-input" rows="9" spellcheck="false" autocomplete="off" required
            class="mt-1 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 font-mono text-sm text-slate-900 focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100"
            placeholder="A B 10&#10;A D 5&#10;B C 1&#10;D E 2"></textarea>
        </label>
        <p class="text-xs text-slate-500 dark:text-slate-400">
          Düğüm adları otomatik keşfedilir. Yönlü graf — her satır u → v
          yönünde ağırlıklı bir kenardır. Ağırlık negatif olabilir;
          paralel kenarlardan en küçük ağırlık seçilir.
        </p>
      </fieldset>

      <fieldset class="space-y-3">
        <legend class="font-display text-sm font-semibold text-slate-900 dark:text-white">
          Kaynak & hedef
        </legend>
        <div class="grid grid-cols-2 gap-3">
          <label class="block">
            <span class="text-xs font-medium text-slate-700 dark:text-slate-300">Kaynak (s)</span>
            <input type="text" id="source-input" autocomplete="off" required value="A"
              class="mt-1 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 font-mono text-sm text-slate-900 focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100" />
          </label>
          <label class="block">
            <span class="text-xs font-medium text-slate-700 dark:text-slate-300">Hedef (t, opsiyonel)</span>
            <input type="text" id="target-input" autocomplete="off" value=""
              class="mt-1 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 font-mono text-sm text-slate-900 focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100"
              placeholder="boşsa tüm düğümler" />
          </label>
        </div>
      </fieldset>

      <fieldset class="space-y-2">
        <legend class="font-display text-sm font-semibold text-slate-900 dark:text-white">
          Algoritma
        </legend>
        <div class="flex flex-col gap-1.5 text-sm">
          <label class="inline-flex items-center gap-2">
            <input type="radio" name="algorithm" value="auto" checked class="text-brand-600 focus:ring-brand-500" />
            <span>Otomatik <span class="text-xs text-slate-500 dark:text-slate-400">(negatif varsa Bellman-Ford)</span></span>
          </label>
          <label class="inline-flex items-center gap-2">
            <input type="radio" name="algorithm" value="dijkstra" class="text-brand-600 focus:ring-brand-500" />
            <span>Dijkstra <span class="text-xs text-slate-500 dark:text-slate-400">(yalnızca ≥ 0)</span></span>
          </label>
          <label class="inline-flex items-center gap-2">
            <input type="radio" name="algorithm" value="bellman-ford" class="text-brand-600 focus:ring-brand-500" />
            <span>Bellman-Ford <span class="text-xs text-slate-500 dark:text-slate-400">(negatif çevrim tespiti)</span></span>
          </label>
        </div>
      </fieldset>

      <button type="submit" class="inline-flex w-full items-center justify-center gap-2 rounded-lg bg-brand-700 px-4 py-2.5 text-sm font-semibold text-white hover:bg-brand-800 dark:bg-accent-500 dark:text-brand-950 dark:hover:bg-accent-400">
        En kısa yolu bul
      </button>

      <div id="error-box" hidden role="alert" class="rounded-lg border border-red-300 bg-red-50 p-3 text-sm text-red-800 dark:border-red-900/50 dark:bg-red-950/30 dark:text-red-300"></div>
    </form>

    <section id="output" hidden aria-live="polite" class="space-y-6">
      <div id="cycle-banner" hidden class="rounded-2xl border border-red-300 bg-red-50/60 p-5 dark:border-red-800/60 dark:bg-red-950/30">
        <p class="text-xs font-medium uppercase tracking-wide text-red-700 dark:text-red-300">
          Negatif çevrim
        </p>
        <p class="mt-1 font-display text-lg font-semibold text-red-900 dark:text-red-100">
          Erişilebilir bir negatif ağırlıklı çevrim var
        </p>
        <p class="mt-1 text-sm text-red-800 dark:text-red-200">
          Bu durumda en kısa yol tanımsızdır — çevrimi sonsuz kez dönerek
          uzaklığı −∞'a düşürebilirsiniz. Aşağıdaki uzaklıklar güvenilir
          değildir.
        </p>
        <p id="cycle-nodes" class="mt-2 font-mono text-sm text-red-900 dark:text-red-100"></p>
      </div>

      <div id="target-card" hidden class="rounded-2xl border border-emerald-300 bg-emerald-50/60 p-5 dark:border-emerald-800/60 dark:bg-emerald-950/30">
        <p class="text-xs font-medium uppercase tracking-wide text-emerald-700 dark:text-emerald-300">
          Kaynak → Hedef en kısa uzaklık
        </p>
        <p id="target-distance" class="mt-1 font-display text-4xl font-bold tabular-nums text-emerald-900 dark:text-emerald-100"></p>
        <p id="target-meta" class="mt-1 text-xs text-emerald-700/80 dark:text-emerald-300/80"></p>
      </div>

      <div id="target-path-card" hidden>
        <h2 class="font-display text-base font-semibold text-slate-900 dark:text-white">
          Yol — kenar kenar
        </h2>
        <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">
          Predecessor zinciri ile geri izlenen kaynak → hedef yolu.
        </p>
        <div class="mt-3 overflow-x-auto rounded-xl border border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900/40">
          <table class="w-full min-w-[420px] text-sm">
            <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500 dark:bg-slate-900/60 dark:text-slate-400">
              <tr>
                <th class="px-3 py-2 text-left">Adım</th>
                <th class="px-3 py-2 text-left">Kenar</th>
                <th class="px-3 py-2 text-right">Ağırlık</th>
                <th class="px-3 py-2 text-right">Toplam</th>
              </tr>
            </thead>
            <tbody id="target-path-body" class="divide-y divide-slate-100 dark:divide-slate-800"></tbody>
          </table>
        </div>
      </div>

      <div>
        <h2 class="font-display text-base font-semibold text-slate-900 dark:text-white">
          Tüm düğümlere uzaklıklar
        </h2>
        <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">
          Erişilemeyen düğümler "—" ile işaretlenir. Predecessor sütunu
          en kısa yoldaki bir önceki düğümü gösterir.
        </p>
        <div class="mt-3 overflow-x-auto rounded-xl border border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900/40">
          <table class="w-full min-w-[420px] text-sm">
            <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500 dark:bg-slate-900/60 dark:text-slate-400">
              <tr>
                <th class="px-3 py-2 text-left">Düğüm</th>
                <th class="px-3 py-2 text-right">Uzaklık</th>
                <th class="px-3 py-2 text-left">Önceki</th>
                <th class="px-3 py-2 text-left">Durum</th>
              </tr>
            </thead>
            <tbody id="nodes-body" class="divide-y divide-slate-100 dark:divide-slate-800"></tbody>
          </table>
        </div>
      </div>
    </section>
  </Container>

  {guideHref && (
    <Container as="section" size="wide" class="py-12 sm:py-16">
      <div class="rounded-2xl border border-slate-200 bg-slate-50 p-8 dark:border-slate-800 dark:bg-slate-900/40">
        <p class="text-xs font-semibold uppercase tracking-wide text-brand-600 dark:text-accent-400">
          Konuyu derinleştir
        </p>
        <h2 class="mt-2 max-w-2xl font-display text-2xl font-semibold tracking-tight text-slate-900 dark:text-white">
          Dijkstra, Bellman-Ford ve en kısa yol algoritmaları
        </h2>
        <p class="mt-3 max-w-2xl text-sm text-slate-600 dark:text-slate-400">
          İki algoritmanın karmaşıklık ve uygulanabilirlik karşılaştırması,
          gevşetme (relaxation) kavramı, negatif çevrim tespiti,
          uygulamalar (yol, telekom, oyun yapay zekâsı) ve sayısal örnekler.
        </p>
        <a href={guideHref} class="mt-5 inline-flex items-center gap-1 text-sm font-semibold text-brand-700 hover:text-brand-800 dark:text-accent-300 dark:hover:text-accent-200">
          Rehberi oku →
        </a>
      </div>
    </Container>
  )}
</BaseLayout>

<script>
  import { solveShortestPath, ShortestPathError, type ShortestPathEdge, type ShortestPathResult, type ShortestPathAlgorithm } from '../../lib/shortest-path';

  const STORAGE_KEY = 'sp-state-v1';

  interface Sample {
    edges: string;
    source: string;
    target: string;
    algorithm: ShortestPathAlgorithm;
  }
  const SAMPLE_CLRS: Sample = {
    edges:
      'A B 10\nA D 5\nB C 1\nB D 2\nD B 3\nD C 9\nD E 2\nC E 4\nE A 7\nE C 6',
    source: 'A',
    target: 'C',
    algorithm: 'auto',
  };
  const SAMPLE_BF: Sample = {
    edges:
      's t 6\ns y 7\nt x 5\nt y 8\nt z -4\nx t -2\ny x -3\ny z 9\nz s 2\nz x 7',
    source: 's',
    target: 'z',
    algorithm: 'auto',
  };
  const SAMPLE_CYCLE: Sample = {
    edges: 's a 1\na b 2\nb a -4\nb t 1',
    source: 's',
    target: 't',
    algorithm: 'bellman-ford',
  };

  const $ = <T extends HTMLElement = HTMLElement>(id: string): T => {
    const el = document.getElementById(id);
    if (!el) throw new Error(`Missing #${id}`);
    return el as T;
  };
  function fmt(n: number, d = 4): string {
    if (!Number.isFinite(n)) return '—';
    if (Math.abs(n) < 1e-9) return '0';
    return n.toFixed(d).replace(/\.?0+$/, '');
  }
  function escapeHtml(s: string): string {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  }

  const form = $<HTMLFormElement>('sp-form');
  const edgesInput = $<HTMLTextAreaElement>('edges-input');
  const sourceInput = $<HTMLInputElement>('source-input');
  const targetInput = $<HTMLInputElement>('target-input');
  const sampleClrsBtn = $('sample-clrs-btn');
  const sampleBfBtn = $('sample-bf-btn');
  const sampleCycleBtn = $('sample-cycle-btn');
  const resetBtn = $('reset-btn');
  const errorBox = $('error-box');
  const output = $('output');
  const cycleBanner = $('cycle-banner');
  const cycleNodes = $('cycle-nodes');
  const targetCard = $('target-card');
  const targetDistanceEl = $('target-distance');
  const targetMeta = $('target-meta');
  const targetPathCard = $('target-path-card');
  const targetPathBody = $('target-path-body');
  const nodesBody = $('nodes-body');

  type SavedState = { edges?: string; source?: string; target?: string; algorithm?: ShortestPathAlgorithm };

  function getAlgorithm(): ShortestPathAlgorithm {
    const checked = form.querySelector<HTMLInputElement>('input[name="algorithm"]:checked');
    return (checked?.value as ShortestPathAlgorithm) ?? 'auto';
  }
  function setAlgorithm(value: ShortestPathAlgorithm): void {
    const radio = form.querySelector<HTMLInputElement>(`input[name="algorithm"][value="${value}"]`);
    if (radio) radio.checked = true;
  }

  function loadState(): void {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) {
        applySample(SAMPLE_CLRS);
        return;
      }
      const s = JSON.parse(raw) as SavedState;
      if (typeof s.edges === 'string') edgesInput.value = s.edges;
      if (typeof s.source === 'string') sourceInput.value = s.source;
      if (typeof s.target === 'string') targetInput.value = s.target;
      if (s.algorithm) setAlgorithm(s.algorithm);
    } catch {
      /* önemsiz. */
    }
  }
  function saveState(): void {
    try {
      localStorage.setItem(
        STORAGE_KEY,
        JSON.stringify({
          edges: edgesInput.value,
          source: sourceInput.value,
          target: targetInput.value,
          algorithm: getAlgorithm(),
        } satisfies SavedState),
      );
    } catch {
      /* önemsiz. */
    }
  }
  function applySample(s: Sample): void {
    edgesInput.value = s.edges;
    sourceInput.value = s.source;
    targetInput.value = s.target;
    setAlgorithm(s.algorithm);
    saveState();
    clearError();
  }

  function parseEdges(text: string): ShortestPathEdge[] {
    const lines = text
      .split(/\r?\n/)
      .map((l) => l.trim())
      .filter((l) => l.length > 0 && !l.startsWith('#'));
    const out: ShortestPathEdge[] = [];
    lines.forEach((line, idx) => {
      const parts = line.split(/[\s,;\t]+/).filter((p) => p.length > 0);
      if (parts.length !== 3) {
        throw new ShortestPathError(
          `Satır ${idx + 1}: 3 alan bekleniyor (kaynak hedef ağırlık); ${parts.length} alan bulundu: "${line}".`,
        );
      }
      const [from, to, wRaw] = parts;
      const weight = Number(wRaw.replace(',', '.'));
      if (!Number.isFinite(weight)) {
        throw new ShortestPathError(`Satır ${idx + 1}: ağırlık sayı olmalı ("${wRaw}").`);
      }
      out.push({ from, to, weight });
    });
    return out;
  }

  function renderNodes(result: ShortestPathResult): void {
    const rows = result.nodes.map((n) => {
      const stateLabel = !n.reachable
        ? '<span class="inline-flex items-center rounded px-1.5 py-0.5 text-xs font-medium bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-400">erişilemez</span>'
        : n.predecessor === null
          ? '<span class="inline-flex items-center rounded px-1.5 py-0.5 text-xs font-medium bg-brand-100 text-brand-900 dark:bg-brand-900/40 dark:text-brand-200">kaynak</span>'
          : '<span class="inline-flex items-center rounded px-1.5 py-0.5 text-xs font-medium bg-emerald-100 text-emerald-900 dark:bg-emerald-900/40 dark:text-emerald-200">erişilebilir</span>';
      return `<tr>
        <td class="px-3 py-2 font-mono text-slate-900 dark:text-white">${escapeHtml(n.node)}</td>
        <td class="px-3 py-2 text-right font-mono tabular-nums">${fmt(n.distance, 3)}</td>
        <td class="px-3 py-2 font-mono text-slate-700 dark:text-slate-300">${n.predecessor === null ? '—' : escapeHtml(n.predecessor)}</td>
        <td class="px-3 py-2">${stateLabel}</td>
      </tr>`;
    });
    nodesBody.innerHTML = rows.join('');
  }

  function renderTargetPath(result: ShortestPathResult): void {
    if (result.targetPath === null || result.targetPath.length === 0) {
      targetPathCard.hidden = true;
      return;
    }
    const rows = result.targetPath.map((step, i) => {
      return `<tr>
        <td class="px-3 py-2 text-slate-500 dark:text-slate-400">${i + 1}</td>
        <td class="px-3 py-2 font-mono text-slate-900 dark:text-white">${escapeHtml(step.from)} → ${escapeHtml(step.to)}</td>
        <td class="px-3 py-2 text-right font-mono tabular-nums">${fmt(step.weight, 3)}</td>
        <td class="px-3 py-2 text-right font-mono tabular-nums text-emerald-700 dark:text-emerald-300">${fmt(step.cumulative, 3)}</td>
      </tr>`;
    });
    targetPathBody.innerHTML = rows.join('');
    targetPathCard.hidden = false;
  }

  function showError(msg: string): void {
    errorBox.textContent = msg;
    errorBox.hidden = false;
    output.hidden = true;
  }
  function clearError(): void {
    errorBox.hidden = true;
    errorBox.textContent = '';
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    clearError();
    saveState();
    try {
      const edges = parseEdges(edgesInput.value);
      const target = targetInput.value.trim();
      const result = solveShortestPath({
        edges,
        source: sourceInput.value.trim(),
        target: target.length > 0 ? target : undefined,
        algorithm: getAlgorithm(),
      });

      cycleBanner.hidden = !result.hasNegativeCycle;
      if (result.hasNegativeCycle) {
        cycleNodes.textContent = 'Çevrim üzerindeki düğümler: ' + (result.negativeCycleNodes.join(' → ') || '(belirsiz)');
      }

      if (result.targetDistance !== null) {
        targetCard.hidden = false;
        targetDistanceEl.textContent = Number.isFinite(result.targetDistance)
          ? fmt(result.targetDistance, 4)
          : '∞ (erişilemez)';
        const algLabel = result.algorithm === 'dijkstra' ? 'Dijkstra' : 'Bellman-Ford';
        targetMeta.textContent = `${algLabel} ${result.iterations} adımda yakınsadı. ${result.nodes.length} düğüm, ${edges.length} kenar.`;
        renderTargetPath(result);
      } else {
        targetCard.hidden = true;
        targetPathCard.hidden = true;
      }

      renderNodes(result);
      output.hidden = false;
      output.scrollIntoView({ behavior: 'smooth', block: 'start' });
    } catch (err) {
      const msg = err instanceof ShortestPathError ? err.message : err instanceof Error ? err.message : 'Bilinmeyen hata.';
      showError(msg);
    }
  });

  [edgesInput, sourceInput, targetInput].forEach((el) => el.addEventListener('input', saveState));
  form.querySelectorAll<HTMLInputElement>('input[name="algorithm"]').forEach((el) =>
    el.addEventListener('change', saveState),
  );
  sampleClrsBtn.addEventListener('click', () => applySample(SAMPLE_CLRS));
  sampleBfBtn.addEventListener('click', () => applySample(SAMPLE_BF));
  sampleCycleBtn.addEventListener('click', () => applySample(SAMPLE_CYCLE));
  resetBtn.addEventListener('click', () => {
    if (!confirm('Form sıfırlanacak. Devam edilsin mi?')) return;
    edgesInput.value = '';
    sourceInput.value = '';
    targetInput.value = '';
    setAlgorithm('auto');
    try {
      localStorage.removeItem(STORAGE_KEY);
    } catch {
      /* önemsiz. */
    }
    clearError();
    output.hidden = true;
  });

  loadState();
</script>
