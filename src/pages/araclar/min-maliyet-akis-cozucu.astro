---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import { withBase, SITE } from '../../data/site';
import { TOOLS } from '../../data/tools';

const tool = TOOLS.find((t) => t.slug === 'min-maliyet-akis-cozucu')!;
const guideHref = tool.guideSlug ? withBase(`/rehberler/${tool.guideSlug}`) : null;

const softwareJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: tool.title,
  applicationCategory: 'WebApplication',
  operatingSystem: 'Any',
  description: tool.description,
  url: new URL(Astro.url.pathname, Astro.site).toString(),
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'TRY' },
  inLanguage: SITE.locale,
  isAccessibleForFree: true,
};
---

<BaseLayout
  title={tool.title}
  description={tool.description}
  image={withBase(`/og/${tool.slug}.png`)}
  imageAlt={`${tool.title} — OR Araçları`}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(softwareJsonLd)} />
  </Fragment>

  <Container as="section" size="wide" class="pt-12 sm:pt-16">
    <p class="text-sm font-medium text-brand-600 dark:text-accent-400">
      <a href={withBase('/araclar')} class="hover:underline">Araçlar</a>
      <span class="text-slate-400 dark:text-slate-600"> / </span>
      <span>Graf & Rota</span>
    </p>
    <h1 class="mt-2 max-w-3xl font-display text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl lg:text-5xl dark:text-white">
      {tool.title}
    </h1>
    <p class="mt-4 max-w-2xl text-base leading-relaxed text-slate-600 sm:text-lg dark:text-slate-400">
      Yönlü ağda her kenarın <strong>kapasitesi</strong> ve <strong>birim
      maliyeti</strong> olsun; kaynak (s) ve hedef (t) arasında <em>d</em>
      birim akıtmanın en ucuz yolunu <strong>Successive Shortest Path</strong>
      (Bellman-Ford / SPFA) algoritmasıyla tarayıcıda anlık bul. Hedef akış
      boş bırakılırsa maks akış kadarı minimum maliyetle akıtılır.
      {guideHref && (
        <a href={guideHref} class="font-medium text-brand-600 hover:text-brand-700 dark:text-accent-400 dark:hover:text-accent-300"> Rehbere git →</a>
      )}
    </p>
  </Container>

  <Container as="div" size="wide" class="grid gap-8 py-10 sm:py-12 lg:grid-cols-[minmax(0,400px)_1fr] print:block">
    <form id="mcf-form" class="space-y-6 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900/40 print:hidden" novalidate>
      <div class="flex flex-wrap gap-2">
        <button type="button" id="sample-trap-btn" class="inline-flex items-center gap-1.5 rounded-md border border-slate-300 bg-white px-3 py-1.5 text-xs font-medium text-slate-700 hover:border-slate-400 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800">
          Açgözlük tuzağı
        </button>
        <button type="button" id="sample-transport-btn" class="inline-flex items-center gap-1.5 rounded-md border border-slate-300 bg-white px-3 py-1.5 text-xs font-medium text-slate-700 hover:border-slate-400 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800">
          Ulaştırma örneği
        </button>
        <button type="button" id="reset-btn" class="inline-flex items-center gap-1.5 rounded-md border border-transparent bg-transparent px-3 py-1.5 text-xs font-medium text-slate-600 hover:bg-slate-100 dark:text-slate-400 dark:hover:bg-slate-800">
          Sıfırla
        </button>
      </div>

      <fieldset class="space-y-3">
        <legend class="font-display text-sm font-semibold text-slate-900 dark:text-white">
          Kenarlar
        </legend>
        <label class="block">
          <span class="text-xs font-medium text-slate-700 dark:text-slate-300">
            Her satır: <span class="font-mono">kaynak hedef kapasite maliyet</span> (boşluk, virgül veya tab ile ayır)
          </span>
          <textarea id="edges-input" rows="10" spellcheck="false" autocomplete="off" required
            class="mt-1 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 font-mono text-sm text-slate-900 focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100"
            placeholder="s a 5 2&#10;a t 5 3"></textarea>
        </label>
        <p class="text-xs text-slate-500 dark:text-slate-400">
          Düğüm adları otomatik keşfedilir. Yönlü graf — her satır u → v
          yönünde kapasiteli, birim maliyetli bir kenardır. Kapasite ve
          maliyet ≥ 0 olmalı.
        </p>
      </fieldset>

      <fieldset class="space-y-3">
        <legend class="font-display text-sm font-semibold text-slate-900 dark:text-white">
          Kaynak, hedef, akış miktarı
        </legend>
        <div class="grid grid-cols-2 gap-3">
          <label class="block">
            <span class="text-xs font-medium text-slate-700 dark:text-slate-300">Kaynak (s)</span>
            <input type="text" id="source-input" autocomplete="off" required value="s"
              class="mt-1 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 font-mono text-sm text-slate-900 focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100" />
          </label>
          <label class="block">
            <span class="text-xs font-medium text-slate-700 dark:text-slate-300">Hedef (t)</span>
            <input type="text" id="sink-input" autocomplete="off" required value="t"
              class="mt-1 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 font-mono text-sm text-slate-900 focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100" />
          </label>
        </div>
        <label class="block">
          <span class="text-xs font-medium text-slate-700 dark:text-slate-300">
            Hedef akış miktarı d (boş bırakırsan = maks akış)
          </span>
          <input type="text" id="required-input" autocomplete="off" inputmode="decimal"
            class="mt-1 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 font-mono text-sm text-slate-900 focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100"
            placeholder="örn. 8" />
        </label>
      </fieldset>

      <button type="submit" class="inline-flex w-full items-center justify-center gap-2 rounded-lg bg-brand-700 px-4 py-2.5 text-sm font-semibold text-white hover:bg-brand-800 dark:bg-accent-500 dark:text-brand-950 dark:hover:bg-accent-400">
        Min maliyetli akışı bul
      </button>

      <div id="error-box" hidden role="alert" class="rounded-lg border border-red-300 bg-red-50 p-3 text-sm text-red-800 dark:border-red-900/50 dark:bg-red-950/30 dark:text-red-300"></div>
    </form>

    <section id="output" hidden aria-live="polite" class="space-y-6">
      <div class="grid gap-3 sm:grid-cols-2">
        <div class="rounded-2xl border border-emerald-300 bg-emerald-50/60 p-5 dark:border-emerald-800/60 dark:bg-emerald-950/30">
          <p class="text-xs font-medium uppercase tracking-wide text-emerald-700 dark:text-emerald-300">
            Toplam akış s → t
          </p>
          <p id="totalflow-value" class="mt-1 font-display text-3xl font-bold tabular-nums text-emerald-900 dark:text-emerald-100"></p>
          <p id="totalflow-meta" class="mt-1 text-xs text-emerald-700/80 dark:text-emerald-300/80"></p>
        </div>
        <div class="rounded-2xl border border-brand-300 bg-brand-50/60 p-5 dark:border-brand-800/60 dark:bg-brand-950/30">
          <p class="text-xs font-medium uppercase tracking-wide text-brand-700 dark:text-brand-300">
            Toplam maliyet Σ f · w
          </p>
          <p id="totalcost-value" class="mt-1 font-display text-3xl font-bold tabular-nums text-brand-900 dark:text-brand-100"></p>
          <p id="totalcost-meta" class="mt-1 text-xs text-brand-700/80 dark:text-brand-300/80"></p>
        </div>
      </div>

      <div id="infeasible-box" hidden class="rounded-lg border border-amber-300 bg-amber-50/60 p-4 text-sm text-amber-900 dark:border-amber-800/60 dark:bg-amber-950/30 dark:text-amber-200">
        <strong>Uyarı:</strong> hedef akış değerine ağ kapasitesi yetmedi.
        Yukarıdaki sonuç ulaşılabilen en yüksek akışı ve onun minimum
        maliyetini gösterir.
      </div>

      <div>
        <h2 class="font-display text-base font-semibold text-slate-900 dark:text-white">
          Kenar akışları ve maliyet katkıları
        </h2>
        <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">
          Her kenarda akıtılan miktar, birim maliyet ve toplam katkı
          (flow × cost). Doygun kenarlar amber, kullanılmayanlar gri.
        </p>
        <div class="mt-3 overflow-x-auto rounded-xl border border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900/40">
          <table class="w-full min-w-[560px] text-sm">
            <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500 dark:bg-slate-900/60 dark:text-slate-400">
              <tr>
                <th class="px-3 py-2 text-left">Kenar</th>
                <th class="px-3 py-2 text-right">Kapasite</th>
                <th class="px-3 py-2 text-right">Birim w</th>
                <th class="px-3 py-2 text-right">Akış</th>
                <th class="px-3 py-2 text-right">Maliyet</th>
                <th class="px-3 py-2 text-left">Durum</th>
              </tr>
            </thead>
            <tbody id="edges-body" class="divide-y divide-slate-100 dark:divide-slate-800"></tbody>
            <tfoot class="border-t-2 border-slate-200 bg-slate-50 text-sm font-semibold dark:border-slate-700 dark:bg-slate-900/60">
              <tr>
                <td class="px-3 py-2 text-right" colspan={4}>Toplam</td>
                <td id="footer-cost" class="px-3 py-2 text-right tabular-nums"></td>
                <td></td>
              </tr>
            </tfoot>
          </table>
        </div>
      </div>
    </section>
  </Container>

  {guideHref && (
    <Container as="section" size="wide" class="py-12 sm:py-16">
      <div class="rounded-2xl border border-slate-200 bg-slate-50 p-8 dark:border-slate-800 dark:bg-slate-900/40">
        <p class="text-xs font-semibold uppercase tracking-wide text-brand-600 dark:text-accent-400">
          Konuyu derinleştir
        </p>
        <h2 class="mt-2 max-w-2xl font-display text-2xl font-semibold tracking-tight text-slate-900 dark:text-white">
          Min-cost flow, SSP ve transportation problemi
        </h2>
        <p class="mt-3 max-w-2xl text-sm text-slate-600 dark:text-slate-400">
          Successive Shortest Path iskeleti, residüel grafikte negatif
          maliyetli ters kenarlar, Bellman-Ford / Johnson potansiyel
          dönüşümü, klasik uygulamalar (ulaştırma, atama, lojistik) ve
          örnek çözümler.
        </p>
        <a href={guideHref} class="mt-5 inline-flex items-center gap-1 text-sm font-semibold text-brand-700 hover:text-brand-800 dark:text-accent-300 dark:hover:text-accent-200">
          Rehberi oku →
        </a>
      </div>
    </Container>
  )}
</BaseLayout>

<script>
  import {
    solveMinCostFlow,
    MinCostFlowError,
    type MinCostFlowEdge,
    type MinCostFlowResult,
  } from '../../lib/min-cost-flow';

  const STORAGE_KEY = 'mcf-state-v1';

  interface Sample {
    edges: string;
    source: string;
    sink: string;
    required: string;
  }
  const SAMPLE_TRAP: Sample = {
    edges:
      's a 2 0\ns b 2 1\na b 1 100\na t 2 1\nb t 2 0',
    source: 's',
    sink: 't',
    required: '4',
  };
  const SAMPLE_TRANSPORT: Sample = {
    edges:
      'SRC S1 15 0\nSRC S2 25 0\nS1 D1 40 8\nS1 D2 40 6\nS1 D3 40 10\nS2 D1 40 9\nS2 D2 40 12\nS2 D3 40 13\nD1 SNK 10 0\nD2 SNK 15 0\nD3 SNK 15 0',
    source: 'SRC',
    sink: 'SNK',
    required: '40',
  };

  const $ = <T extends HTMLElement = HTMLElement>(id: string): T => {
    const el = document.getElementById(id);
    if (!el) throw new Error(`Missing #${id}`);
    return el as T;
  };
  function fmt(n: number, d = 4): string {
    if (!Number.isFinite(n)) return '—';
    if (Math.abs(n) < 1e-9) return '0';
    return n.toFixed(d).replace(/\.?0+$/, '');
  }
  function escapeHtml(s: string): string {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  }

  const form = $<HTMLFormElement>('mcf-form');
  const edgesInput = $<HTMLTextAreaElement>('edges-input');
  const sourceInput = $<HTMLInputElement>('source-input');
  const sinkInput = $<HTMLInputElement>('sink-input');
  const requiredInput = $<HTMLInputElement>('required-input');
  const sampleTrapBtn = $('sample-trap-btn');
  const sampleTransportBtn = $('sample-transport-btn');
  const resetBtn = $('reset-btn');
  const errorBox = $('error-box');
  const output = $('output');
  const totalflowValue = $('totalflow-value');
  const totalflowMeta = $('totalflow-meta');
  const totalcostValue = $('totalcost-value');
  const totalcostMeta = $('totalcost-meta');
  const infeasibleBox = $('infeasible-box');
  const edgesBody = $('edges-body');
  const footerCost = $('footer-cost');

  type SavedState = { edges?: string; source?: string; sink?: string; required?: string };
  function loadState(): void {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) {
        applySample(SAMPLE_TRAP);
        return;
      }
      const s = JSON.parse(raw) as SavedState;
      if (typeof s.edges === 'string') edgesInput.value = s.edges;
      if (typeof s.source === 'string') sourceInput.value = s.source;
      if (typeof s.sink === 'string') sinkInput.value = s.sink;
      if (typeof s.required === 'string') requiredInput.value = s.required;
    } catch {
      /* önemsiz. */
    }
  }
  function saveState(): void {
    try {
      localStorage.setItem(
        STORAGE_KEY,
        JSON.stringify({
          edges: edgesInput.value,
          source: sourceInput.value,
          sink: sinkInput.value,
          required: requiredInput.value,
        } satisfies SavedState),
      );
    } catch {
      /* önemsiz. */
    }
  }
  function applySample(s: Sample): void {
    edgesInput.value = s.edges;
    sourceInput.value = s.source;
    sinkInput.value = s.sink;
    requiredInput.value = s.required;
    saveState();
    clearError();
  }

  function parseEdges(text: string): MinCostFlowEdge[] {
    const lines = text
      .split(/\r?\n/)
      .map((l) => l.trim())
      .filter((l) => l.length > 0 && !l.startsWith('#'));
    const out: MinCostFlowEdge[] = [];
    lines.forEach((line, idx) => {
      const parts = line.split(/[\s,;\t]+/).filter((p) => p.length > 0);
      if (parts.length !== 4) {
        throw new MinCostFlowError(
          `Satır ${idx + 1}: 4 alan bekleniyor (kaynak hedef kapasite maliyet); ${parts.length} alan bulundu: "${line}".`,
        );
      }
      const [from, to, capRaw, costRaw] = parts;
      const capacity = Number(capRaw.replace(',', '.'));
      const cost = Number(costRaw.replace(',', '.'));
      if (!Number.isFinite(capacity)) {
        throw new MinCostFlowError(`Satır ${idx + 1}: kapasite sayı olmalı ("${capRaw}").`);
      }
      if (!Number.isFinite(cost)) {
        throw new MinCostFlowError(`Satır ${idx + 1}: birim maliyet sayı olmalı ("${costRaw}").`);
      }
      out.push({ from, to, capacity, cost });
    });
    return out;
  }

  function parseRequired(text: string): number | undefined {
    const t = text.trim();
    if (t.length === 0) return undefined;
    const v = Number(t.replace(',', '.'));
    if (!Number.isFinite(v)) {
      throw new MinCostFlowError(`Hedef akış sayı olmalı ("${text}").`);
    }
    return v;
  }

  function renderEdges(result: MinCostFlowResult): void {
    const rows = result.edges.map((e) => {
      const utilPct = e.capacity > 0 ? (e.flow / e.capacity) * 100 : 0;
      const stateLabel = e.saturated
        ? '<span class="inline-flex items-center rounded px-1.5 py-0.5 text-xs font-medium bg-amber-100 text-amber-900 dark:bg-amber-900/40 dark:text-amber-200">doygun</span>'
        : e.flow > 1e-9
          ? '<span class="inline-flex items-center rounded px-1.5 py-0.5 text-xs font-medium bg-emerald-100 text-emerald-900 dark:bg-emerald-900/40 dark:text-emerald-200">akış var</span>'
          : '<span class="inline-flex items-center rounded px-1.5 py-0.5 text-xs font-medium bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-400">boş</span>';
      const rowCls = e.saturated ? 'bg-amber-50/40 dark:bg-amber-950/10' : '';
      return `<tr class="${rowCls}">
        <td class="px-3 py-2 font-mono tabular-nums text-slate-900 dark:text-white">${escapeHtml(e.from)} → ${escapeHtml(e.to)}</td>
        <td class="px-3 py-2 text-right tabular-nums">${fmt(e.capacity, 3)}</td>
        <td class="px-3 py-2 text-right tabular-nums">${fmt(e.cost, 3)}</td>
        <td class="px-3 py-2 text-right font-mono tabular-nums">${fmt(e.flow, 3)} <span class="text-xs text-slate-500 dark:text-slate-400">(${fmt(utilPct, 1)}%)</span></td>
        <td class="px-3 py-2 text-right font-mono tabular-nums">${fmt(e.totalCost, 3)}</td>
        <td class="px-3 py-2">${stateLabel}</td>
      </tr>`;
    });
    edgesBody.innerHTML = rows.join('');
    footerCost.textContent = fmt(result.totalCost, 3);
  }

  function showError(msg: string): void {
    errorBox.textContent = msg;
    errorBox.hidden = false;
    output.hidden = true;
  }
  function clearError(): void {
    errorBox.hidden = true;
    errorBox.textContent = '';
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    clearError();
    saveState();
    try {
      const edges = parseEdges(edgesInput.value);
      const required = parseRequired(requiredInput.value);
      const result = solveMinCostFlow({
        edges,
        source: sourceInput.value.trim(),
        sink: sinkInput.value.trim(),
        requiredFlow: required,
      });
      totalflowValue.textContent = fmt(result.totalFlow, 4);
      totalflowMeta.textContent = required !== undefined
        ? `Hedef d = ${fmt(required, 4)}. SSP ${result.iterations} artıran yol kullandı.`
        : `Hedef belirtilmedi → maks akış kadar (${fmt(result.totalFlow, 4)}). SSP ${result.iterations} artıran yol kullandı.`;
      totalcostValue.textContent = fmt(result.totalCost, 4);
      const avg = result.totalFlow > 1e-9 ? result.totalCost / result.totalFlow : 0;
      totalcostMeta.textContent = result.totalFlow > 1e-9
        ? `Birim başına ortalama ${fmt(avg, 3)}.`
        : 'Akış yok.';
      infeasibleBox.hidden = !result.infeasible;
      renderEdges(result);
      output.hidden = false;
      output.scrollIntoView({ behavior: 'smooth', block: 'start' });
    } catch (err) {
      const msg = err instanceof MinCostFlowError ? err.message : err instanceof Error ? err.message : 'Bilinmeyen hata.';
      showError(msg);
    }
  });

  [edgesInput, sourceInput, sinkInput, requiredInput].forEach((el) => el.addEventListener('input', saveState));
  sampleTrapBtn.addEventListener('click', () => applySample(SAMPLE_TRAP));
  sampleTransportBtn.addEventListener('click', () => applySample(SAMPLE_TRANSPORT));
  resetBtn.addEventListener('click', () => {
    if (!confirm('Form sıfırlanacak. Devam edilsin mi?')) return;
    edgesInput.value = '';
    sourceInput.value = '';
    sinkInput.value = '';
    requiredInput.value = '';
    try {
      localStorage.removeItem(STORAGE_KEY);
    } catch {
      /* önemsiz. */
    }
    clearError();
    output.hidden = true;
  });

  loadState();
</script>
