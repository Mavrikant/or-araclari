---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import { withBase, SITE } from '../../data/site';
import { TOOLS } from '../../data/tools';

const tool = TOOLS.find((t) => t.slug === 'lineer-programlama-cozucu')!;
const guideHref = tool.guideSlug ? withBase(`/rehberler/${tool.guideSlug}`) : null;

const softwareJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: tool.title,
  applicationCategory: 'WebApplication',
  operatingSystem: 'Any',
  description: tool.description,
  url: new URL(Astro.url.pathname, Astro.site).toString(),
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'TRY' },
  inLanguage: SITE.locale,
  isAccessibleForFree: true,
};
---

<BaseLayout title={tool.title} description={tool.description}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(softwareJsonLd)} />
  </Fragment>

  <Container as="section" size="wide" class="pt-12 sm:pt-16">
    <p class="text-sm font-medium text-brand-600 dark:text-accent-400">
      <a href={withBase('/araclar')} class="hover:underline">Araçlar</a>
      <span class="text-slate-400 dark:text-slate-600"> / </span>
      <span>Optimizasyon</span>
    </p>
    <h1 class="mt-2 max-w-3xl font-display text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl lg:text-5xl dark:text-white">
      {tool.title}
    </h1>
    <p class="mt-4 max-w-2xl text-base leading-relaxed text-slate-600 sm:text-lg dark:text-slate-400">
      LP'yi metin olarak yaz, GLPK'nın WebAssembly motoru tarayıcıda çözsün.
      Tüm hesaplama yerel — model verisi sunucuya gönderilmez.
      {guideHref && (
        <a href={guideHref} class="font-medium text-brand-600 hover:text-brand-700 dark:text-accent-400 dark:hover:text-accent-300"> Rehbere git →</a>
      )}
    </p>
  </Container>

  <Container as="div" size="wide" class="grid gap-8 py-10 sm:py-12 lg:grid-cols-[minmax(0,300px)_1fr] print:block">
    <form id="lp-form" class="space-y-6 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900/40 print:hidden" novalidate>
      <div class="flex flex-wrap gap-2">
        <button type="button" id="sample-btn" class="inline-flex items-center gap-1.5 rounded-md border border-slate-300 bg-white px-3 py-1.5 text-xs font-medium text-slate-700 hover:border-slate-400 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800">
          Örnek doldur
        </button>
        <button type="button" id="reset-btn" class="inline-flex items-center gap-1.5 rounded-md border border-transparent bg-transparent px-3 py-1.5 text-xs font-medium text-slate-600 hover:bg-slate-100 dark:text-slate-400 dark:hover:bg-slate-800">
          Sıfırla
        </button>
      </div>

      <button type="submit" id="solve-btn" class="inline-flex w-full items-center justify-center gap-2 rounded-lg bg-brand-700 px-4 py-2.5 text-sm font-semibold text-white hover:bg-brand-800 disabled:cursor-not-allowed disabled:opacity-60 dark:bg-accent-500 dark:text-brand-950 dark:hover:bg-accent-400">
        <span id="solve-label">Çöz</span>
      </button>

      <div id="status-box" hidden class="space-y-3">
        <div id="status-card" class="rounded-lg border p-3 text-sm">
          <div id="status-title" class="text-xs font-medium uppercase tracking-wide"></div>
          <div id="status-z" class="mt-1 font-display text-2xl font-bold"></div>
          <div id="status-time" class="mt-1 text-xs"></div>
        </div>
        <div id="result-actions" class="flex flex-wrap gap-2">
          <button type="button" id="print-btn" class="inline-flex items-center gap-1.5 rounded-md border border-slate-300 bg-white px-3 py-1.5 text-xs font-medium text-slate-700 hover:border-slate-400 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800">
            Yazdır
          </button>
        </div>
      </div>

      <details class="rounded-lg border border-slate-200 bg-slate-50/60 p-3 text-xs dark:border-slate-800 dark:bg-slate-900/40">
        <summary class="cursor-pointer font-medium text-slate-700 dark:text-slate-300">
          Format yardımı
        </summary>
        <div class="mt-2 space-y-2 text-slate-600 dark:text-slate-400">
          <p>İlk satır: <code>max</code> veya <code>min</code> + hedef ifadesi.</p>
          <p>Sonraki satırlar: <code>ifade &lt;= sayı</code>, <code>ifade &gt;= sayı</code>, <code>ifade = sayı</code>.</p>
          <p><code>#</code> veya <code>//</code> ile başlayan satırlar yorumdur.</p>
          <p>Tüm değişkenler varsayılan olarak ≥ 0'dır; bunu değiştirmek için <code>x &gt;= -5</code> gibi açık bir kısıt ekleyebilirsin.</p>
          <p>Türkçe ondalık virgülü (1,5) desteklenir.</p>
        </div>
      </details>

      <div id="error-box" hidden role="alert" class="rounded-lg border border-red-300 bg-red-50 p-3 text-sm text-red-800 dark:border-red-900/50 dark:bg-red-950/30 dark:text-red-300"></div>
    </form>

    <section aria-live="polite" class="space-y-6">
      <div>
        <label for="lp-text" class="block font-display text-base font-semibold text-slate-900 dark:text-white">
          LP modeli
        </label>
        <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">
          Hedef + kısıtları metin olarak yaz, "Çöz" butonuna bas.
        </p>
        <textarea id="lp-text" rows="14" required autocomplete="off" spellcheck="false"
          class="mt-3 block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 font-mono text-sm leading-relaxed text-slate-900 focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100"
          placeholder="max 3x + 4y&#10;&#10;x + 2y <= 14&#10;3x - y >= 0&#10;x - y <= 2"></textarea>
      </div>

      <div id="result-panel" hidden class="space-y-4">
        <h2 class="font-display text-base font-semibold text-slate-900 dark:text-white">
          Değişken değerleri
        </h2>
        <div id="vars-grid" class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3"></div>
        <details class="text-sm">
          <summary class="cursor-pointer font-medium text-slate-700 dark:text-slate-300">
            Çözücü ayrıntıları
          </summary>
          <pre id="solver-detail" class="mt-2 overflow-x-auto rounded-lg bg-slate-50 p-3 font-mono text-xs text-slate-700 dark:bg-slate-900/60 dark:text-slate-300"></pre>
        </details>
      </div>
    </section>
  </Container>

  {guideHref && (
    <Container as="section" size="wide" class="py-12 sm:py-16">
      <div class="rounded-2xl border border-slate-200 bg-slate-50 p-8 dark:border-slate-800 dark:bg-slate-900/40">
        <p class="text-xs font-semibold uppercase tracking-wide text-brand-600 dark:text-accent-400">
          Konuyu derinleştir
        </p>
        <h2 class="mt-2 max-w-2xl font-display text-2xl font-semibold tracking-tight text-slate-900 dark:text-white">
          Doğrusal programlama: tarihçe, simpleks, dualite
        </h2>
        <p class="mt-3 max-w-2xl text-sm text-slate-600 dark:text-slate-400">
          Standart formülasyon, geometrik sezgi, simpleks algoritması, iç-nokta
          yöntemleri, pratik tuzaklar — kapsamlı Türkçe rehber.
        </p>
        <a href={guideHref} class="mt-5 inline-flex items-center gap-1 text-sm font-semibold text-brand-700 hover:text-brand-800 dark:text-accent-300 dark:hover:text-accent-200">
          Rehberi oku →
        </a>
      </div>
    </Container>
  )}
</BaseLayout>

<script>
  import { parseLp, solveLp, LpParseError, LpSolveError, type LpSolveResult } from '../../lib/lp';

  const STORAGE_KEY = 'lp-state-v2';
  const SAMPLE = `max 3x + 4y\n\nx + 2y <= 14\n3x - y >= 0\nx - y <= 2`;

  const $ = <T extends HTMLElement = HTMLElement>(id: string): T => {
    const el = document.getElementById(id);
    if (!el) throw new Error(`Missing #${id}`);
    return el as T;
  };

  function escapeHtml(s: string): string {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  function fmt(n: number): string {
    if (Number.isInteger(n)) return String(n);
    if (Math.abs(n) < 1e-9) return '0';
    return n.toFixed(4).replace(/\.?0+$/, '');
  }

  const form = $<HTMLFormElement>('lp-form');
  const lpText = $<HTMLTextAreaElement>('lp-text');
  const sampleBtn = $('sample-btn');
  const resetBtn = $('reset-btn');
  const solveBtn = $<HTMLButtonElement>('solve-btn');
  const solveLabel = $('solve-label');
  const errorBox = $('error-box');
  const statusBox = $('status-box');
  const statusCard = $('status-card');
  const statusTitle = $('status-title');
  const statusZ = $('status-z');
  const statusTime = $('status-time');
  const printBtn = $<HTMLButtonElement>('print-btn');
  const resultPanel = $('result-panel');
  const varsGrid = $('vars-grid');
  const solverDetail = $('solver-detail') as HTMLPreElement;

  /* ---------- state ---------- */

  function loadState(): string {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      return raw ?? '';
    } catch {
      return '';
    }
  }
  function saveState(): void {
    try {
      localStorage.setItem(STORAGE_KEY, lpText.value);
    } catch {
      /* ignore */
    }
  }
  lpText.value = loadState();
  lpText.addEventListener('input', saveState);

  /* ---------- error / status helpers ---------- */

  function showError(msg: string): void {
    errorBox.textContent = msg;
    errorBox.hidden = false;
    statusBox.hidden = true;
    resultPanel.hidden = true;
  }
  function clearError(): void {
    errorBox.hidden = true;
    errorBox.textContent = '';
  }

  function setStatus(result: LpSolveResult): void {
    const positive = result.status === 'optimal' || result.status === 'feasible';
    statusCard.className = positive
      ? 'rounded-lg border border-emerald-300 bg-emerald-50 p-3 text-sm dark:border-emerald-800/60 dark:bg-emerald-950/30'
      : 'rounded-lg border border-amber-300 bg-amber-50 p-3 text-sm dark:border-amber-800/60 dark:bg-amber-950/30';
    statusTitle.className = positive
      ? 'text-xs font-medium uppercase tracking-wide text-emerald-700 dark:text-emerald-300'
      : 'text-xs font-medium uppercase tracking-wide text-amber-700 dark:text-amber-300';
    statusZ.className = positive
      ? 'mt-1 font-display text-2xl font-bold text-emerald-900 dark:text-emerald-100'
      : 'mt-1 font-display text-lg font-bold text-amber-900 dark:text-amber-100';
    statusTime.className = positive
      ? 'mt-1 text-xs text-emerald-800 dark:text-emerald-300'
      : 'mt-1 text-xs text-amber-800 dark:text-amber-300';

    const labels: Record<typeof result.status, string> = {
      optimal: 'Optimum bulundu',
      feasible: 'Uygun çözüm (interior)',
      infeasible: 'Uygun çözüm yok',
      no_feasible: 'Uygun bölge boş',
      unbounded: 'Sınırsız problem',
      undefined: 'Çözüm tanımsız',
    };
    statusTitle.textContent = labels[result.status];
    statusZ.textContent =
      result.status === 'optimal' || result.status === 'feasible'
        ? `z* = ${fmt(result.objectiveValue)}`
        : '—';
    statusTime.textContent = `${result.solveTimeMs} ms`;
    statusBox.hidden = false;
  }

  function renderVars(result: LpSolveResult): void {
    if (result.status !== 'optimal' && result.status !== 'feasible') {
      resultPanel.hidden = true;
      return;
    }
    varsGrid.innerHTML = result.variables
      .map(
        (v) => `<div class="rounded-lg border border-slate-200 bg-white p-3 dark:border-slate-800 dark:bg-slate-900/40">
          <div class="text-xs font-medium text-slate-500 dark:text-slate-400">${escapeHtml(v.variable)}</div>
          <div class="mt-1 font-display text-xl font-bold tabular-nums text-slate-900 dark:text-white">${fmt(v.value)}</div>
        </div>`,
      )
      .join('');
    solverDetail.textContent = JSON.stringify(
      {
        status: result.status,
        z: result.objectiveValue,
        vars: Object.fromEntries(result.variables.map((v) => [v.variable, v.value])),
        time_ms: result.solveTimeMs,
      },
      null,
      2,
    );
    resultPanel.hidden = false;
  }

  /* ---------- solve ---------- */

  async function solve(): Promise<void> {
    clearError();
    if (lpText.value.trim().length === 0) {
      showError('LP modeli boş — bir hedef ve en az bir kısıt ekle.');
      return;
    }

    let parsed;
    try {
      parsed = parseLp(lpText.value);
    } catch (err) {
      const msg = err instanceof LpParseError ? err.message : err instanceof Error ? err.message : 'Bilinmeyen hata.';
      showError(msg);
      return;
    }

    solveBtn.disabled = true;
    solveLabel.textContent = 'Çözülüyor… (ilk yüklemede ~600 KB WASM iniyor)';

    try {
      const result = await solveLp(parsed);
      setStatus(result);
      renderVars(result);
    } catch (err) {
      const msg = err instanceof LpSolveError ? err.message : err instanceof Error ? err.message : 'Bilinmeyen hata.';
      showError(msg);
    } finally {
      solveBtn.disabled = false;
      solveLabel.textContent = 'Çöz';
    }
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    solve();
  });

  sampleBtn.addEventListener('click', () => {
    lpText.value = SAMPLE;
    saveState();
    clearError();
    statusBox.hidden = true;
    resultPanel.hidden = true;
    lpText.focus();
  });

  resetBtn.addEventListener('click', () => {
    if (lpText.value.trim() && !confirm('Mevcut model temizlenecek. Devam edilsin mi?')) return;
    lpText.value = '';
    try {
      localStorage.removeItem(STORAGE_KEY);
    } catch {
      /* ignore */
    }
    clearError();
    statusBox.hidden = true;
    resultPanel.hidden = true;
  });

  printBtn.addEventListener('click', () => window.print());
</script>

<style>
  @media print {
    @page {
      margin: 1.5cm;
    }
    body {
      background: white !important;
    }
  }
</style>
