---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import AdSlot from '../../components/AdSlot.astro';
import { withBase, SITE } from '../../data/site';
import { TOOLS } from '../../data/tools';

const tool = TOOLS.find((t) => t.slug === 'atama-problemi-cozucu')!;
const guideHref = tool.guideSlug ? withBase(`/rehberler/${tool.guideSlug}`) : null;

const softwareJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: tool.title,
  applicationCategory: 'WebApplication',
  operatingSystem: 'Any',
  description: tool.description,
  url: new URL(Astro.url.pathname, Astro.site).toString(),
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'TRY' },
  inLanguage: SITE.locale,
  isAccessibleForFree: true,
};
---

<BaseLayout title={tool.title} description={tool.description}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(softwareJsonLd)} />
  </Fragment>

  <Container as="section" size="wide" class="pt-12 sm:pt-16">
    <p class="text-sm font-medium text-brand-600 dark:text-accent-400">
      <a href={withBase('/araclar')} class="hover:underline">Araçlar</a>
      <span class="text-slate-400 dark:text-slate-600"> / </span>
      <span>Optimizasyon</span>
    </p>
    <h1 class="mt-2 max-w-3xl font-display text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl lg:text-5xl dark:text-white">
      {tool.title}
    </h1>
    <p class="mt-4 max-w-2xl text-base leading-relaxed text-slate-600 sm:text-lg dark:text-slate-400">
      Maliyet matrisini gir, Macar (Hungarian) algoritması ile optimum atamayı
      saniyeler içinde bul. {guideHref && (
        <>
          <a href={guideHref} class="font-medium text-brand-600 hover:text-brand-700 dark:text-accent-400 dark:hover:text-accent-300">Rehbere git →</a>
        </>
      )}
    </p>
  </Container>

  <Container as="div" size="wide" class="grid gap-8 py-10 sm:py-12 lg:grid-cols-[minmax(0,360px)_1fr] print:block">
    <form id="assign-form" class="space-y-6 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900/40 print:hidden" novalidate>
      <fieldset class="space-y-3">
        <div class="flex items-center justify-between">
          <label for="matrix" class="block font-display text-sm font-semibold text-slate-900 dark:text-white">Maliyet matrisi</label>
          <span id="matrix-info" class="text-xs text-slate-500 dark:text-slate-400" aria-live="polite">— × —</span>
        </div>
        <textarea id="matrix" name="matrix" rows="9" required autocomplete="off" spellcheck="false"
          class="block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 font-mono text-sm leading-relaxed text-slate-900 placeholder:text-slate-400 focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100"
          placeholder="Her satıra bir agent yaz, hücreleri tab veya boşlukla ayır.&#10;Türkçe ondalık (1,5) desteklenir.&#10;&#10;4 1 3&#10;2 0 5&#10;3 2 2"></textarea>
        <div class="flex flex-wrap gap-2">
          <button type="button" id="sample-btn" class="inline-flex items-center gap-1.5 rounded-md border border-slate-300 bg-white px-3 py-1.5 text-xs font-medium text-slate-700 hover:border-slate-400 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800">Örnek doldur</button>
          <button type="button" id="clear-btn" class="inline-flex items-center gap-1.5 rounded-md border border-transparent bg-transparent px-3 py-1.5 text-xs font-medium text-slate-600 hover:bg-slate-100 dark:text-slate-400 dark:hover:bg-slate-800">Temizle</button>
        </div>
      </fieldset>

      <fieldset>
        <legend class="font-display text-sm font-semibold text-slate-900 dark:text-white">Etiketler <span class="font-normal text-slate-500">(opsiyonel)</span></legend>
        <div class="mt-3 space-y-3">
          <label class="block">
            <span class="text-xs font-medium text-slate-700 dark:text-slate-300">Satır etiketleri (her satıra bir tane)</span>
            <textarea id="row-labels" rows="3" autocomplete="off" spellcheck="false"
              class="mt-1 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100"
              placeholder="Ali&#10;Veli&#10;Ayşe"></textarea>
          </label>
          <label class="block">
            <span class="text-xs font-medium text-slate-700 dark:text-slate-300">Sütun etiketleri (her satıra bir tane)</span>
            <textarea id="col-labels" rows="3" autocomplete="off" spellcheck="false"
              class="mt-1 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100"
              placeholder="Görev A&#10;Görev B&#10;Görev C"></textarea>
          </label>
        </div>
      </fieldset>

      <fieldset>
        <legend class="font-display text-sm font-semibold text-slate-900 dark:text-white">Optimizasyon yönü</legend>
        <div class="mt-3 space-y-2">
          <label class="flex cursor-pointer items-start gap-3 rounded-lg border border-slate-200 bg-white p-3 has-[:checked]:border-brand-500 has-[:checked]:bg-brand-50 dark:border-slate-800 dark:bg-slate-900/40 dark:has-[:checked]:border-accent-500 dark:has-[:checked]:bg-slate-900">
            <input type="radio" name="dir" value="min" checked class="mt-0.5 size-4 border-slate-300 text-brand-600 focus:ring-brand-500" />
            <span class="flex-1">
              <span class="block text-sm font-medium text-slate-900 dark:text-white">Minimize et</span>
              <span class="mt-0.5 block text-xs text-slate-500 dark:text-slate-400">Toplam maliyeti en aza indir (varsayılan).</span>
            </span>
          </label>
          <label class="flex cursor-pointer items-start gap-3 rounded-lg border border-slate-200 bg-white p-3 has-[:checked]:border-brand-500 has-[:checked]:bg-brand-50 dark:border-slate-800 dark:bg-slate-900/40 dark:has-[:checked]:border-accent-500 dark:has-[:checked]:bg-slate-900">
            <input type="radio" name="dir" value="max" class="mt-0.5 size-4 border-slate-300 text-brand-600 focus:ring-brand-500" />
            <span class="flex-1">
              <span class="block text-sm font-medium text-slate-900 dark:text-white">Maximize et</span>
              <span class="mt-0.5 block text-xs text-slate-500 dark:text-slate-400">Hücreler kâr/skor ise toplamı en üst seviyeye çıkar.</span>
            </span>
          </label>
        </div>
      </fieldset>

      <button type="submit" class="inline-flex w-full items-center justify-center gap-2 rounded-lg bg-brand-700 px-4 py-2.5 text-sm font-semibold text-white hover:bg-brand-800 dark:bg-accent-500 dark:text-brand-950 dark:hover:bg-accent-400">Atamayı çöz</button>

      <div id="error-box" hidden role="alert" class="rounded-lg border border-red-300 bg-red-50 p-3 text-sm text-red-800 dark:border-red-900/50 dark:bg-red-950/30 dark:text-red-300"></div>
    </form>

    <section id="output" hidden aria-live="polite" class="space-y-6">
      <header>
        <h2 class="font-display text-xl font-semibold tracking-tight text-slate-900 dark:text-white">Sonuç</h2>
        <p id="summary" class="mt-1 text-sm text-slate-600 dark:text-slate-400"></p>
      </header>
      <div id="result-table"></div>
    </section>
  </Container>

  {guideHref && (
    <Container as="section" size="wide" class="py-12 sm:py-16">
      <div class="rounded-2xl border border-slate-200 bg-slate-50 p-8 dark:border-slate-800 dark:bg-slate-900/40">
        <p class="text-xs font-semibold uppercase tracking-wide text-brand-600 dark:text-accent-400">Konuyu derinleştir</p>
        <h2 class="mt-2 max-w-2xl font-display text-2xl font-semibold tracking-tight text-slate-900 dark:text-white">Macar algoritması nasıl çalışır?</h2>
        <p class="mt-3 max-w-2xl text-sm text-slate-600 dark:text-slate-400">Atama probleminin matematiksel formülasyonu, Munkres adımları, gerçek dünya örnekleri ve performans analizi üzerine kapsamlı rehber.</p>
        <a href={guideHref} class="mt-5 inline-flex items-center gap-1 text-sm font-semibold text-brand-700 hover:text-brand-800 dark:text-accent-300 dark:hover:text-accent-200">Rehberi oku →</a>
      </div>
    </Container>
  )}
</BaseLayout>

<script>
  import { solveAssignment, parseCostMatrix, AssignmentError } from '../../lib/hungarian';

  const SAMPLE = '4\t1\t3\n2\t0\t5\n3\t2\t2';

  const $ = (id: string): HTMLElement => {
    const el = document.getElementById(id);
    if (!el) throw new Error(`Missing element: #${id}`);
    return el;
  };

  const form = $('assign-form') as HTMLFormElement;
  const matrixInput = $('matrix') as HTMLTextAreaElement;
  const matrixInfo = $('matrix-info');
  const rowLabelsInput = $('row-labels') as HTMLTextAreaElement;
  const colLabelsInput = $('col-labels') as HTMLTextAreaElement;
  const errorBox = $('error-box');
  const output = $('output');
  const summary = $('summary');
  const resultTable = $('result-table');
  const sampleBtn = $('sample-btn');
  const clearBtn = $('clear-btn');

  function escapeHtml(s: string): string {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  function readLines(s: string): string[] {
    return s.split(/\r?\n/).map((l) => l.trim()).filter(Boolean);
  }

  function updateMatrixInfo(): void {
    try {
      const m = parseCostMatrix(matrixInput.value);
      if (m.length && m[0].length) matrixInfo.textContent = `${m.length} × ${m[0].length}`;
      else matrixInfo.textContent = '— × —';
    } catch {
      matrixInfo.textContent = '— × —';
    }
  }

  function showError(msg: string): void {
    errorBox.textContent = msg;
    errorBox.hidden = false;
    output.hidden = true;
  }

  function clearError(): void {
    errorBox.hidden = true;
    errorBox.textContent = '';
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    clearError();
    try {
      const costs = parseCostMatrix(matrixInput.value);
      const dir = (form.elements.namedItem('dir') as RadioNodeList)?.value;
      const rowLabels = readLines(rowLabelsInput.value);
      const colLabels = readLines(colLabelsInput.value);
      const result = solveAssignment({
        costs,
        maximize: dir === 'max',
        ...(rowLabels.length === costs.length ? { rowLabels } : {}),
        ...(colLabels.length === costs[0].length ? { colLabels } : {}),
      });

      summary.textContent = [
        `${result.assignments.length} atama`,
        `Toplam ${dir === 'max' ? 'kâr' : 'maliyet'}: ${result.totalCost}`,
        result.square ? null : `${result.rows}×${result.cols} (kare değil — ${Math.abs(result.rows - result.cols)} ${result.rows < result.cols ? 'sütun' : 'satır'} eşleşmedi)`,
      ].filter(Boolean).join(' · ');

      const rows = result.assignments.map((a) => {
        const r = a.rowLabel ?? `Satır ${a.row + 1}`;
        const c = a.colLabel ?? `Sütun ${a.col + 1}`;
        return `<tr class="border-t border-slate-100 dark:border-slate-800"><td class="px-3 py-2 text-sm text-slate-900 dark:text-slate-100">${escapeHtml(r)}</td><td class="px-3 py-2 text-center text-xs text-slate-400">→</td><td class="px-3 py-2 text-sm text-slate-900 dark:text-slate-100">${escapeHtml(c)}</td><td class="px-3 py-2 text-right font-mono text-sm text-slate-700 dark:text-slate-300">${a.cost}</td></tr>`;
      }).join('');

      resultTable.innerHTML = `<div class="overflow-x-auto rounded-xl border border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900/40"><table class="w-full"><thead><tr class="border-b border-slate-200 bg-slate-50 text-left text-xs font-medium uppercase tracking-wider text-slate-500 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-400"><th class="px-3 py-2">Agent</th><th class="px-3 py-2"></th><th class="px-3 py-2">Görev</th><th class="px-3 py-2 text-right">Maliyet</th></tr></thead><tbody>${rows}</tbody></table></div>`;
      output.hidden = false;
      output.scrollIntoView({ behavior: 'smooth', block: 'start' });
    } catch (err) {
      const msg = err instanceof AssignmentError ? err.message : err instanceof Error ? err.message : 'Bilinmeyen hata.';
      showError(msg);
    }
  });

  matrixInput.addEventListener('input', updateMatrixInfo);

  sampleBtn.addEventListener('click', () => {
    matrixInput.value = SAMPLE;
    rowLabelsInput.value = 'Ali\nVeli\nAyşe';
    colLabelsInput.value = 'Görev A\nGörev B\nGörev C';
    updateMatrixInfo();
  });

  clearBtn.addEventListener('click', () => {
    form.reset();
    updateMatrixInfo();
    clearError();
    output.hidden = true;
  });

  updateMatrixInfo();
</script>
