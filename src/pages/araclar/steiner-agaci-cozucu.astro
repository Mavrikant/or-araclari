---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import { withBase, SITE } from '../../data/site';
import { TOOLS } from '../../data/tools';

const tool = TOOLS.find((t) => t.slug === 'steiner-agaci-cozucu')!;
const guideHref = tool.guideSlug ? withBase(`/rehberler/${tool.guideSlug}`) : null;

const softwareJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: tool.title,
  applicationCategory: 'WebApplication',
  operatingSystem: 'Any',
  description: tool.description,
  url: new URL(Astro.url.pathname, Astro.site).toString(),
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'TRY' },
  inLanguage: SITE.locale,
  isAccessibleForFree: true,
};
---

<BaseLayout
  title={tool.title}
  description={tool.description}
  image={withBase(`/og/${tool.slug}.png`)}
  imageAlt={`${tool.title} — OR Araçları`}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(softwareJsonLd)} />
  </Fragment>

  <Container as="section" size="wide" class="pt-12 sm:pt-16">
    <p class="text-sm font-medium text-brand-600 dark:text-accent-400">
      <a href={withBase('/araclar')} class="hover:underline">Araçlar</a>
      <span class="text-slate-400 dark:text-slate-600"> / </span>
      <span>Graf & Rota</span>
    </p>
    <h1 class="mt-2 max-w-3xl font-display text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl lg:text-5xl dark:text-white">
      {tool.title}
    </h1>
    <p class="mt-4 max-w-2xl text-base leading-relaxed text-slate-600 sm:text-lg dark:text-slate-400">
      Yönsüz ağırlıklı bir ağda <strong>terminal</strong> alt kümesini
      birbirine bağlayan en az toplam ağırlıklı ağacı bul. Ara düğümler
      (Steiner noktaları) isteğe bağlı olarak ağaca dahil edilebilir.
      Problem NP-zor; aracımız <strong>Kou-Markowsky-Berman (KMB)
      1981</strong> algoritmasını kullanır — yaklaşım faktörü 2.
      {guideHref && (
        <a href={guideHref} class="font-medium text-brand-600 hover:text-brand-700 dark:text-accent-400 dark:hover:text-accent-300"> Rehbere git →</a>
      )}
    </p>
  </Container>

  <Container as="div" size="wide" class="grid gap-8 py-10 sm:py-12 lg:grid-cols-[minmax(0,380px)_1fr] print:block">
    <form id="steiner-form" class="space-y-6 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900/40 print:hidden" novalidate>
      <div class="flex flex-wrap gap-2">
        <button type="button" id="sample-star-btn" class="inline-flex items-center gap-1.5 rounded-md border border-slate-300 bg-white px-3 py-1.5 text-xs font-medium text-slate-700 hover:border-slate-400 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800">
          Y-yıldız (3 terminal)
        </button>
        <button type="button" id="sample-grid-btn" class="inline-flex items-center gap-1.5 rounded-md border border-slate-300 bg-white px-3 py-1.5 text-xs font-medium text-slate-700 hover:border-slate-400 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800">
          Izgara (4 köşe)
        </button>
        <button type="button" id="sample-stub-btn" class="inline-flex items-center gap-1.5 rounded-md border border-slate-300 bg-white px-3 py-1.5 text-xs font-medium text-slate-700 hover:border-slate-400 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800">
          Saplama (kırpma)
        </button>
        <button type="button" id="reset-btn" class="inline-flex items-center gap-1.5 rounded-md border border-transparent bg-transparent px-3 py-1.5 text-xs font-medium text-slate-600 hover:bg-slate-100 dark:text-slate-400 dark:hover:bg-slate-800">
          Sıfırla
        </button>
      </div>

      <fieldset class="space-y-3">
        <legend class="font-display text-sm font-semibold text-slate-900 dark:text-white">
          Kenarlar
        </legend>
        <label class="block">
          <span class="text-xs font-medium text-slate-700 dark:text-slate-300">
            Her satır: <span class="font-mono">u v ağırlık</span> (boşluk, virgül veya tab ile ayır)
          </span>
          <textarea id="edges-input" rows="9" spellcheck="false" autocomplete="off" required
            class="mt-1 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 font-mono text-sm text-slate-900 focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100"
            placeholder="T1 C 1&#10;T2 C 1&#10;T3 C 1"></textarea>
        </label>
        <p class="text-xs text-slate-500 dark:text-slate-400">
          Kenarlar <strong>yönsüz</strong>; (u, v) ile (v, u) aynı. Paralel
          kenarda en küçük ağırlık seçilir; ağırlık ≥ 0 olmalı (Dijkstra
          varsayımı). En fazla 200 düğüm, 1000 kenar, 30 terminal.
        </p>
      </fieldset>

      <fieldset class="space-y-2">
        <legend class="font-display text-sm font-semibold text-slate-900 dark:text-white">
          Terminaller
        </legend>
        <input type="text" id="terminals-input" autocomplete="off" required
          class="block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 font-mono text-sm text-slate-900 focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100"
          placeholder="T1 T2 T3" />
        <p class="text-xs text-slate-500 dark:text-slate-400">
          Bağlanması zorunlu düğüm adları (boşluk, virgül veya tab ile
          ayır). Diğer düğümler isteğe bağlı Steiner noktası olarak ağaca
          alınabilir.
        </p>
      </fieldset>

      <button type="submit" class="inline-flex w-full items-center justify-center gap-2 rounded-lg bg-brand-700 px-4 py-2.5 text-sm font-semibold text-white hover:bg-brand-800 dark:bg-accent-500 dark:text-brand-950 dark:hover:bg-accent-400">
        Steiner ağacını bul
      </button>

      <div id="error-box" hidden role="alert" class="rounded-lg border border-red-300 bg-red-50 p-3 text-sm text-red-800 dark:border-red-900/50 dark:bg-red-950/30 dark:text-red-300"></div>
    </form>

    <section id="output" hidden aria-live="polite" class="space-y-6">
      <div id="unreachable-banner" hidden class="rounded-2xl border border-red-300 bg-red-50/60 p-5 dark:border-red-800/60 dark:bg-red-950/30">
        <p class="text-xs font-medium uppercase tracking-wide text-red-700 dark:text-red-300">
          Erişilemez
        </p>
        <p class="mt-1 font-display text-lg font-semibold text-red-900 dark:text-red-100">
          Terminaller aynı bağlı bileşende değil
        </p>
        <p class="mt-1 text-sm text-red-800 dark:text-red-200">
          En az iki terminal arasında yol yok; Steiner ağacı tanımsız.
          Kenarları kontrol edin.
        </p>
      </div>

      <div id="result-cards" hidden class="grid gap-4 sm:grid-cols-3">
        <div class="rounded-2xl border border-emerald-300 bg-emerald-50/60 p-5 dark:border-emerald-800/60 dark:bg-emerald-950/30">
          <p class="text-xs font-medium uppercase tracking-wide text-emerald-700 dark:text-emerald-300">
            Steiner toplam ağırlığı
          </p>
          <p id="total-weight" class="mt-1 font-display text-4xl font-bold tabular-nums text-emerald-900 dark:text-emerald-100"></p>
        </div>
        <div class="rounded-2xl border border-sky-300 bg-sky-50/60 p-5 dark:border-sky-800/60 dark:bg-sky-950/30">
          <p class="text-xs font-medium uppercase tracking-wide text-sky-700 dark:text-sky-300">
            Tüm grafın MST'si
          </p>
          <p id="mst-weight" class="mt-1 font-display text-4xl font-bold tabular-nums text-sky-900 dark:text-sky-100"></p>
          <p class="mt-1 text-xs text-sky-700/80 dark:text-sky-300/80">
            karşılaştırma için (tüm düğümleri kapsar)
          </p>
        </div>
        <div class="rounded-2xl border border-amber-300 bg-amber-50/60 p-5 dark:border-amber-800/60 dark:bg-amber-950/30">
          <p class="text-xs font-medium uppercase tracking-wide text-amber-700 dark:text-amber-300">
            Steiner noktaları
          </p>
          <p id="steiner-count" class="mt-1 font-display text-4xl font-bold tabular-nums text-amber-900 dark:text-amber-100"></p>
          <p id="steiner-list" class="mt-1 break-words text-xs font-mono text-amber-700/80 dark:text-amber-300/80"></p>
        </div>
      </div>

      <div id="tree-section" hidden>
        <h2 class="font-display text-base font-semibold text-slate-900 dark:text-white">
          Ağaç kenarları
        </h2>
        <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">
          KMB algoritması bulgusu — terminaller olduğu gibi, Steiner
          noktaları (terminal olmayan ara düğümler) sarıyla işaretli.
        </p>
        <div class="mt-3 overflow-x-auto rounded-xl border border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900/40">
          <table class="w-full min-w-[420px] text-sm">
            <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500 dark:bg-slate-900/60 dark:text-slate-400">
              <tr>
                <th class="px-3 py-2 text-left">#</th>
                <th class="px-3 py-2 text-left">Kenar</th>
                <th class="px-3 py-2 text-right">Ağırlık</th>
                <th class="px-3 py-2 text-right">Birikimli</th>
              </tr>
            </thead>
            <tbody id="tree-body" class="divide-y divide-slate-100 dark:divide-slate-800"></tbody>
          </table>
        </div>
      </div>

      <div id="terminal-paths-section" hidden>
        <h2 class="font-display text-base font-semibold text-slate-900 dark:text-white">
          Terminaller arası en kısa yollar (metrik kapanış)
        </h2>
        <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">
          KMB'nin Adım 1–2'si: terminal çiftleri arası Dijkstra. Aracın
          gerçek hesabını gösteren ara çıktı.
        </p>
        <div class="mt-3 overflow-x-auto rounded-xl border border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900/40">
          <table class="w-full min-w-[420px] text-sm">
            <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500 dark:bg-slate-900/60 dark:text-slate-400">
              <tr>
                <th class="px-3 py-2 text-left">Çift</th>
                <th class="px-3 py-2 text-right">Uzaklık</th>
                <th class="px-3 py-2 text-left">Yol</th>
              </tr>
            </thead>
            <tbody id="paths-body" class="divide-y divide-slate-100 dark:divide-slate-800"></tbody>
          </table>
        </div>
      </div>
    </section>
  </Container>

  {guideHref && (
    <Container as="section" size="wide" class="py-12 sm:py-16">
      <div class="rounded-2xl border border-slate-200 bg-slate-50 p-8 dark:border-slate-800 dark:bg-slate-900/40">
        <p class="text-xs font-semibold uppercase tracking-wide text-brand-600 dark:text-accent-400">
          Konuyu derinleştir
        </p>
        <h2 class="mt-2 max-w-2xl font-display text-2xl font-semibold tracking-tight text-slate-900 dark:text-white">
          Steiner ağacı, NP-zorluk ve KMB 2-yaklaşımı
        </h2>
        <p class="mt-3 max-w-2xl text-sm text-slate-600 dark:text-slate-400">
          MST ile farkı, problemin NP-zor olmasının kombinatoryel kaynağı,
          metrik kapanış, KMB'nin altı adımı, yaklaşım faktörü 2'nin
          ispatı, VLSI / multicast / filogenetik uygulamaları ve
          aracımızdaki örnekler.
        </p>
        <a href={guideHref} class="mt-5 inline-flex items-center gap-1 text-sm font-semibold text-brand-700 hover:text-brand-800 dark:text-accent-300 dark:hover:text-accent-200">
          Rehberi oku →
        </a>
      </div>
    </Container>
  )}
</BaseLayout>

<script>
  import {
    solveSteiner,
    SteinerError,
    type SteinerEdge,
    type SteinerResult,
  } from '../../lib/steiner';

  const STORAGE_KEY = 'steiner-state-v1';

  interface Sample {
    edges: string;
    terminals: string;
  }
  const SAMPLE_STAR: Sample = {
    edges:
      'T1 C 1\nT2 C 1\nT3 C 1\nT1 T2 5\nT2 T3 5\nT1 T3 5',
    terminals: 'T1 T2 T3',
  };
  const SAMPLE_GRID: Sample = {
    edges:
      'A B 1\nA C 1\nB D 1\nC D 1\nB X 1\nX D 1\nC Y 1\nY D 1',
    terminals: 'A D',
  };
  const SAMPLE_STUB: Sample = {
    edges:
      'T1 C 2\nC T2 2\nC X 1\nX Y 1\nT2 Z 3\nZ W 1',
    terminals: 'T1 T2',
  };

  const $ = <T extends HTMLElement = HTMLElement>(id: string): T => {
    const el = document.getElementById(id);
    if (!el) throw new Error(`Missing #${id}`);
    return el as T;
  };
  function fmt(n: number, d = 4): string {
    if (!Number.isFinite(n)) return '—';
    if (Math.abs(n) < 1e-9) return '0';
    return n.toFixed(d).replace(/\.?0+$/, '');
  }
  function escapeHtml(s: string): string {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  }

  const form = $<HTMLFormElement>('steiner-form');
  const edgesInput = $<HTMLTextAreaElement>('edges-input');
  const terminalsInput = $<HTMLInputElement>('terminals-input');
  const sampleStarBtn = $('sample-star-btn');
  const sampleGridBtn = $('sample-grid-btn');
  const sampleStubBtn = $('sample-stub-btn');
  const resetBtn = $('reset-btn');
  const errorBox = $('error-box');
  const output = $('output');
  const unreachableBanner = $('unreachable-banner');
  const resultCards = $('result-cards');
  const totalWeightEl = $('total-weight');
  const mstWeightEl = $('mst-weight');
  const steinerCountEl = $('steiner-count');
  const steinerListEl = $('steiner-list');
  const treeSection = $('tree-section');
  const treeBody = $('tree-body');
  const pathsSection = $('terminal-paths-section');
  const pathsBody = $('paths-body');

  type SavedState = { edges?: string; terminals?: string };

  function loadState(): void {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) {
        applySample(SAMPLE_STAR);
        return;
      }
      const s = JSON.parse(raw) as SavedState;
      if (typeof s.edges === 'string') edgesInput.value = s.edges;
      if (typeof s.terminals === 'string') terminalsInput.value = s.terminals;
    } catch {
      /* önemsiz. */
    }
  }
  function saveState(): void {
    try {
      localStorage.setItem(
        STORAGE_KEY,
        JSON.stringify({
          edges: edgesInput.value,
          terminals: terminalsInput.value,
        } satisfies SavedState),
      );
    } catch {
      /* önemsiz. */
    }
  }
  function applySample(s: Sample): void {
    edgesInput.value = s.edges;
    terminalsInput.value = s.terminals;
    saveState();
    clearError();
  }

  function parseEdges(text: string): SteinerEdge[] {
    const lines = text
      .split(/\r?\n/)
      .map((l) => l.trim())
      .filter((l) => l.length > 0 && !l.startsWith('#'));
    const out: SteinerEdge[] = [];
    lines.forEach((line, idx) => {
      const parts = line.split(/[\s,;\t]+/).filter((p) => p.length > 0);
      if (parts.length !== 3) {
        throw new SteinerError(
          `Satır ${idx + 1}: 3 alan bekleniyor (u v ağırlık); ${parts.length} alan bulundu: "${line}".`,
        );
      }
      const [from, to, wRaw] = parts;
      const weight = Number(wRaw.replace(',', '.'));
      if (!Number.isFinite(weight)) {
        throw new SteinerError(`Satır ${idx + 1}: ağırlık sayı olmalı ("${wRaw}").`);
      }
      out.push({ from, to, weight });
    });
    return out;
  }
  function parseTerminals(text: string): string[] {
    return text
      .split(/[\s,;\t]+/)
      .map((p) => p.trim())
      .filter((p) => p.length > 0);
  }

  function renderTree(result: SteinerResult): void {
    const terminalSet = new Set<string>();
    /* Terminal listesi treeNodes − steinerNodes ile çıkar. */
    for (const n of result.treeNodes) {
      if (!result.steinerNodes.includes(n)) terminalSet.add(n);
    }
    let cum = 0;
    const rows = result.treeEdges.map((e, i) => {
      cum += e.weight;
      const tag = (n: string): string => {
        const isSteiner = result.steinerNodes.includes(n);
        const cls = isSteiner
          ? 'bg-amber-100 text-amber-900 dark:bg-amber-900/40 dark:text-amber-200'
          : 'bg-emerald-100 text-emerald-900 dark:bg-emerald-900/40 dark:text-emerald-200';
        return `<span class="inline-flex items-center rounded px-1.5 py-0.5 text-xs font-medium ${cls}">${escapeHtml(n)}</span>`;
      };
      return `<tr>
        <td class="px-3 py-2 text-slate-500 dark:text-slate-400">${i + 1}</td>
        <td class="px-3 py-2 font-mono text-slate-900 dark:text-white">${tag(e.from)} — ${tag(e.to)}</td>
        <td class="px-3 py-2 text-right font-mono tabular-nums">${fmt(e.weight, 3)}</td>
        <td class="px-3 py-2 text-right font-mono tabular-nums text-emerald-700 dark:text-emerald-300">${fmt(cum, 3)}</td>
      </tr>`;
    });
    treeBody.innerHTML = rows.join('');
  }

  function renderPaths(result: SteinerResult): void {
    const rows = result.terminalPaths.map((p) => {
      const pathStr = p.path.map(escapeHtml).join(' → ');
      return `<tr>
        <td class="px-3 py-2 font-mono text-slate-900 dark:text-white">${escapeHtml(p.terminalA)} — ${escapeHtml(p.terminalB)}</td>
        <td class="px-3 py-2 text-right font-mono tabular-nums">${fmt(p.distance, 3)}</td>
        <td class="px-3 py-2 font-mono text-xs text-slate-600 dark:text-slate-400">${pathStr}</td>
      </tr>`;
    });
    pathsBody.innerHTML = rows.join('');
  }

  function showError(msg: string): void {
    errorBox.textContent = msg;
    errorBox.hidden = false;
    output.hidden = true;
  }
  function clearError(): void {
    errorBox.hidden = true;
    errorBox.textContent = '';
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    clearError();
    saveState();
    try {
      const edges = parseEdges(edgesInput.value);
      const terminals = parseTerminals(terminalsInput.value);
      const result = solveSteiner({ edges, terminals });

      if (!result.reachable) {
        unreachableBanner.hidden = false;
        resultCards.hidden = true;
        treeSection.hidden = true;
        pathsSection.hidden = true;
        output.hidden = false;
        output.scrollIntoView({ behavior: 'smooth', block: 'start' });
        return;
      }

      unreachableBanner.hidden = true;
      resultCards.hidden = false;
      totalWeightEl.textContent = fmt(result.totalWeight, 4);
      mstWeightEl.textContent = fmt(result.mstTotalWeight, 4);
      steinerCountEl.textContent = String(result.steinerNodes.length);
      steinerListEl.textContent =
        result.steinerNodes.length > 0 ? result.steinerNodes.join(', ') : 'yok';

      if (result.treeEdges.length > 0) {
        treeSection.hidden = false;
        renderTree(result);
      } else {
        treeSection.hidden = true;
      }

      if (result.terminalPaths.length > 0) {
        pathsSection.hidden = false;
        renderPaths(result);
      } else {
        pathsSection.hidden = true;
      }

      output.hidden = false;
      output.scrollIntoView({ behavior: 'smooth', block: 'start' });
    } catch (err) {
      const msg = err instanceof SteinerError ? err.message : err instanceof Error ? err.message : 'Bilinmeyen hata.';
      showError(msg);
    }
  });

  [edgesInput, terminalsInput].forEach((el) =>
    el.addEventListener('input', saveState),
  );
  sampleStarBtn.addEventListener('click', () => applySample(SAMPLE_STAR));
  sampleGridBtn.addEventListener('click', () => applySample(SAMPLE_GRID));
  sampleStubBtn.addEventListener('click', () => applySample(SAMPLE_STUB));
  resetBtn.addEventListener('click', () => {
    if (!confirm('Form sıfırlanacak. Devam edilsin mi?')) return;
    edgesInput.value = '';
    terminalsInput.value = '';
    try {
      localStorage.removeItem(STORAGE_KEY);
    } catch {
      /* önemsiz. */
    }
    clearError();
    output.hidden = true;
  });

  loadState();
</script>
