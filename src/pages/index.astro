---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import ToolCard from '../components/ToolCard.astro';
import { TOOLS } from '../data/tools';
import { withBase } from '../data/site';

const recentGuides = (await getCollection('rehberler'))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);

const dateFormatter = new Intl.DateTimeFormat('tr-TR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const valueProps = [
  {
    title: 'Tarayıcıda çalışır',
    body: 'Tüm hesaplamalar senin cihazında. Sunucu yok, hesap yok, veri toplama yok.',
  },
  {
    title: 'Açık kaynak',
    body: 'Tüm kod GitHub’da. Algoritmaları incele, katkıda bulun, kendi sürümünü çıkar.',
  },
  {
    title: 'Türkçe rehberler',
    body: 'Her aracın yanında problemi tanıtan, algoritmayı açıklayan uzun-form içerik.',
  },
  {
    title: 'Mobil-öncelikli',
    body: 'Telefonda da masaüstü kadar rahat. Hızlı yükleme, erişilebilir arayüz.',
  },
];
---

<BaseLayout>
  <Container as="section" size="wide" class="pt-12 pb-16 sm:pt-20 sm:pb-24">
    <div class="max-w-3xl">
      <span
        class="inline-flex items-center gap-2 rounded-full bg-accent-500/10 px-3 py-1 text-xs font-medium text-accent-700 ring-1 ring-accent-500/30 dark:text-accent-300"
      >
        <span class="size-1.5 rounded-full bg-accent-500"></span>
        Yapım aşamasında — yeni araçlar yolda
      </span>
      <h1
        class="mt-5 font-display text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl dark:text-white"
      >
        Yöneylem araçları, <span class="text-brand-600 dark:text-accent-400"
          >tek tıkla.</span
        >
      </h1>
      <p
        class="mt-5 max-w-2xl text-lg leading-relaxed text-slate-600 sm:text-xl dark:text-slate-300"
      >
        Lig fikstürü, lineer programlama, gezgin satıcı, atama, knapsack ve
        çizelgeleme problemlerini doğrudan tarayıcıda çöz. Her aracın yanında
        Türkçe açıklama ve örnekler.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href={withBase('/araclar')}
          class="inline-flex items-center gap-2 rounded-md bg-brand-700 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-brand-800 focus-visible:outline-2 focus-visible:outline-offset-2 dark:bg-accent-500 dark:text-brand-950 dark:hover:bg-accent-400"
        >
          Araçları gör
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12" />
            <polyline points="12 5 19 12 12 19" />
          </svg>
        </a>
        <a
          href={withBase('/rehberler')}
          class="inline-flex items-center gap-2 rounded-md border border-slate-300 bg-white px-5 py-2.5 text-sm font-semibold text-slate-700 transition-colors hover:border-slate-400 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:border-slate-600 dark:hover:bg-slate-800"
        >
          Rehberleri keşfet
        </a>
      </div>
    </div>
  </Container>

  <Container as="section" size="wide" class="py-12 sm:py-16">
    <div class="mb-8 flex items-end justify-between gap-4">
      <div>
        <h2
          class="font-display text-2xl font-semibold tracking-tight text-slate-900 sm:text-3xl dark:text-white"
        >
          Araçlar
        </h2>
        <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">
          {TOOLS.length} araç planlanıyor. İlki yolda.
        </p>
      </div>
      <a
        href={withBase('/araclar')}
        class="hidden text-sm font-medium text-brand-600 hover:text-brand-700 sm:inline-flex dark:text-accent-400 dark:hover:text-accent-300"
      >
        Tümünü gör →
      </a>
    </div>

    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {TOOLS.map((tool) => (
        <li>
          <ToolCard tool={tool} />
        </li>
      ))}
    </ul>
  </Container>

  <Container as="section" size="wide" class="py-12 sm:py-16">
    <h2
      class="font-display text-2xl font-semibold tracking-tight text-slate-900 sm:text-3xl dark:text-white"
    >
      Niçin OR Araçları?
    </h2>
    <ul class="mt-8 grid gap-6 sm:grid-cols-2">
      {
        valueProps.map((item) => (
          <li class="flex items-start gap-4">
            <span class="mt-1 inline-flex size-8 shrink-0 items-center justify-center rounded-full bg-brand-50 text-brand-700 dark:bg-brand-900/40 dark:text-accent-400">
              <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="20 6 9 17 4 12" />
              </svg>
            </span>
            <div>
              <h3 class="font-display font-semibold text-slate-900 dark:text-white">
                {item.title}
              </h3>
              <p class="mt-1 text-sm leading-relaxed text-slate-600 dark:text-slate-400">
                {item.body}
              </p>
            </div>
          </li>
        ))
      }
    </ul>
  </Container>

  <Container as="section" size="wide" class="py-12 sm:py-16">
    <div class="mb-8 flex items-end justify-between gap-4">
      <div>
        <h2
          class="font-display text-2xl font-semibold tracking-tight text-slate-900 sm:text-3xl dark:text-white"
        >
          Son rehberler
        </h2>
        <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">
          Yöneylem araştırması üzerine Türkçe yazılar.
        </p>
      </div>
      {
        recentGuides.length > 0 && (
          <a
            href={withBase('/rehberler')}
            class="hidden text-sm font-medium text-brand-600 hover:text-brand-700 sm:inline-flex dark:text-accent-400 dark:hover:text-accent-300"
          >
            Tümünü gör →
          </a>
        )
      }
    </div>

    {
      recentGuides.length > 0 ? (
        <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {recentGuides.map((guide) => (
            <li>
              <a
                href={withBase(`/rehberler/${guide.id}`)}
                class="group flex h-full flex-col gap-3 rounded-xl border border-slate-200 bg-white p-5 transition-colors hover:border-accent-400 hover:bg-accent-50/40 dark:border-slate-800 dark:bg-slate-900/40 dark:hover:border-accent-500 dark:hover:bg-slate-900"
              >
                <div class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400">
                  <time datetime={guide.data.pubDate.toISOString()}>
                    {dateFormatter.format(guide.data.pubDate)}
                  </time>
                  {guide.data.readingMinutes && (
                    <>
                      <span class="text-slate-300 dark:text-slate-700">·</span>
                      <span>{guide.data.readingMinutes} dk okuma</span>
                    </>
                  )}
                </div>
                <h3 class="font-display text-lg font-semibold tracking-tight text-slate-900 group-hover:text-brand-700 dark:text-white dark:group-hover:text-accent-300">
                  {guide.data.title}
                </h3>
                <p class="text-sm leading-relaxed text-slate-600 dark:text-slate-400">
                  {guide.data.description}
                </p>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <div class="rounded-xl border border-dashed border-slate-300 bg-slate-50/50 p-8 text-center dark:border-slate-700 dark:bg-slate-900/30">
          <p class="text-sm text-slate-600 dark:text-slate-400">
            İlk rehberler önümüzdeki haftalarda yayında.
            <a
              href={withBase('/rehberler')}
              class="font-medium text-brand-600 hover:text-brand-700 dark:text-accent-400 dark:hover:text-accent-300"
            >
              Yol haritasını gör →
            </a>
          </p>
        </div>
      )
    }
  </Container>
</BaseLayout>
