---
import '../styles/global.css';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const phases = [
  { id: 0, title: 'Repo iskelet & GH Pages deploy', status: 'done' },
  { id: 1, title: 'Layout, anasayfa, hakkında/gizlilik', status: 'next' },
  { id: 2, title: 'İlk araç: Lig Fikstürü Oluşturucu', status: 'todo' },
  { id: 3, title: 'Blog/rehber sistemi + 5 başlangıç yazısı', status: 'todo' },
  { id: 4, title: 'GA4 + AdSense altyapısı', status: 'todo' },
  { id: 5, title: 'LP, TSP, Atama, Knapsack, Çizelgeleme araçları', status: 'todo' },
];
---

<!doctype html>
<html lang="tr" class="bg-brand-900 text-slate-100">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="noindex" />
    <meta
      name="description"
      content="OR Araçları yapım aşamasında. Yöneylem Araştırması (Operations Research) klasik problemleri için tarayıcıda çalışan ücretsiz Türkçe araç koleksiyonu."
    />
    <title>OR Araçları — Yapım Aşamasında</title>
  </head>
  <body class="min-h-dvh font-sans antialiased">
    <main class="mx-auto flex min-h-dvh max-w-2xl flex-col justify-center px-6 py-16">
      <div class="mb-3 inline-flex w-fit items-center gap-2 rounded-full bg-accent-500/10 px-3 py-1 text-xs font-medium text-accent-300 ring-1 ring-accent-500/30">
        <span class="size-1.5 rounded-full bg-accent-400"></span>
        Faz 0 — kurulum tamamlandı
      </div>

      <h1 class="text-4xl font-bold tracking-tight text-white sm:text-5xl">
        OR Araçları
      </h1>
      <p class="mt-4 max-w-prose text-base leading-relaxed text-slate-300 sm:text-lg">
        Yöneylem Araştırması <span class="text-slate-400">(Operations Research)</span>
        klasik problemleri için tarayıcıda çalışan ücretsiz, açık kaynak Türkçe
        araç koleksiyonu. Şu an inşa ediliyor.
      </p>

      <ol class="mt-10 space-y-2 text-sm">
        {
          phases.map((phase) => (
            <li class="flex items-start gap-3 rounded-lg border border-white/5 bg-white/[0.02] px-4 py-3">
              <span
                class:list={[
                  'mt-0.5 inline-flex size-6 shrink-0 items-center justify-center rounded-full text-xs font-semibold',
                  phase.status === 'done' && 'bg-accent-500 text-brand-900',
                  phase.status === 'next' && 'bg-brand-200 text-brand-900',
                  phase.status === 'todo' && 'bg-white/5 text-slate-400',
                ]}
              >
                {phase.id}
              </span>
              <span
                class:list={[
                  'leading-6',
                  phase.status === 'done' && 'text-white',
                  phase.status === 'next' && 'text-slate-200',
                  phase.status === 'todo' && 'text-slate-400',
                ]}
              >
                {phase.title}
              </span>
            </li>
          ))
        }
      </ol>

      <footer class="mt-12 text-xs text-slate-500">
        <a
          href="https://github.com/Mavrikant/or-araclari"
          class="underline-offset-2 hover:text-accent-400 hover:underline"
          rel="noopener"
        >
          GitHub
        </a>
        <span class="mx-2 text-slate-700">·</span>
        <span>MIT lisansı</span>
        <span class="mx-2 text-slate-700">·</span>
        <span>Astro {Astro.generator.split(' ')[1]}</span>
      </footer>
    </main>
  </body>
</html>
