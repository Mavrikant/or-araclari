---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import { SITE, withBase } from '../../data/site';
import { TOOLS } from '../../data/tools';

export async function getStaticPaths() {
  const entries = await getCollection('rehberler');
  return entries.map((entry: CollectionEntry<'rehberler'>) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'rehberler'>;
}

const { entry } = Astro.props as Props;
const { Content, headings } = await render(entry);
const { data } = entry;

const tocItems = headings.filter((h) => h.depth === 2);

const relatedTool = data.relatedTool
  ? TOOLS.find((t) => t.slug === data.relatedTool)
  : undefined;

const dateFormatter = new Intl.DateTimeFormat('tr-TR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: data.title,
  description: data.description,
  inLanguage: SITE.locale,
  datePublished: data.pubDate.toISOString(),
  ...(data.updatedDate && { dateModified: data.updatedDate.toISOString() }),
  author: {
    '@type': 'Person',
    name: SITE.author.name,
    url: SITE.author.github,
  },
  publisher: {
    '@type': 'Organization',
    name: SITE.name,
  },
  keywords: data.keywords.join(', '),
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).toString(),
};

const faqJsonLd = data.faq
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: data.faq.map((q) => ({
        '@type': 'Question',
        name: q.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: q.answer,
        },
      })),
    }
  : null;
---

<BaseLayout title={data.title} description={data.description}>
  <Fragment slot="head">
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(articleJsonLd)}
    />
    {
      faqJsonLd && (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(faqJsonLd)}
        />
      )
    }
  </Fragment>

  <Container as="article" size="default" class="py-12 sm:py-16">
    <header class="mx-auto max-w-2xl">
      <p class="text-sm font-medium text-brand-600 dark:text-accent-400">
        Rehber
      </p>
      <h1
        class="mt-2 font-display text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl lg:text-5xl dark:text-white"
      >
        {data.title}
      </h1>
      <p class="mt-4 text-lg leading-relaxed text-slate-600 dark:text-slate-400">
        {data.description}
      </p>
      <div
        class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-slate-500 dark:text-slate-400"
      >
        <span>
          <time datetime={data.pubDate.toISOString()}>
            {dateFormatter.format(data.pubDate)}
          </time>
        </span>
        {
          data.updatedDate && (
            <span>
              · Güncellendi:{' '}
              <time datetime={data.updatedDate.toISOString()}>
                {dateFormatter.format(data.updatedDate)}
              </time>
            </span>
          )
        }
        {data.readingMinutes && <span>· {data.readingMinutes} dk okuma</span>}
      </div>
    </header>

    {
      relatedTool && (
        <div class="mx-auto mt-8 max-w-2xl rounded-xl border border-accent-500/30 bg-accent-500/5 p-5 dark:border-accent-500/40 dark:bg-accent-500/10">
          <p class="text-xs font-medium uppercase tracking-wide text-accent-700 dark:text-accent-400">
            İlgili araç
          </p>
          <p class="mt-1 font-display text-lg font-semibold text-slate-900 dark:text-white">
            {relatedTool.title}
          </p>
          <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">
            {relatedTool.description}
          </p>
          <a
            href={withBase(`/araclar/${relatedTool.slug}`)}
            class="mt-3 inline-flex items-center gap-1 text-sm font-semibold text-brand-700 hover:text-brand-800 dark:text-accent-300 dark:hover:text-accent-200"
          >
            Aracı aç →
          </a>
        </div>
      )
    }

    <div class="mt-10 grid gap-10 lg:grid-cols-[1fr_220px]">
      <div class="prose-tr mx-auto w-full max-w-2xl lg:mx-0">
        <Content />

        {
          data.faq && (
            <section class="mt-16">
              <h2>Sıkça sorulanlar</h2>
              <dl class="mt-6 space-y-6">
                {data.faq.map((q) => (
                  <div class="rounded-lg border border-slate-200 bg-slate-50/50 p-5 dark:border-slate-800 dark:bg-slate-900/40">
                    <dt class="font-display font-semibold text-slate-900 dark:text-white">
                      {q.question}
                    </dt>
                    <dd class="mt-2 text-slate-700 dark:text-slate-300">
                      {q.answer}
                    </dd>
                  </div>
                ))}
              </dl>
            </section>
          )
        }
      </div>

      {
        tocItems.length > 0 && (
          <aside class="hidden lg:sticky lg:top-20 lg:block lg:self-start">
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">
              İçindekiler
            </p>
            <ol class="mt-3 space-y-2 text-sm">
              {tocItems.map((heading) => (
                <li>
                  <a
                    href={`#${heading.slug}`}
                    class="block leading-snug text-slate-600 hover:text-brand-700 dark:text-slate-400 dark:hover:text-accent-300"
                  >
                    {heading.text}
                  </a>
                </li>
              ))}
            </ol>
          </aside>
        )
      }
    </div>
  </Container>
</BaseLayout>
