---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import { withBase } from '../data/site';
---

<BaseLayout
  title="Sayfa bulunamadı"
  description="Aradığın sayfa kaybolmuş, taşınmış ya da hiç var olmamış."
  noindex
>
  <Container as="section" size="narrow" class="flex min-h-[50vh] flex-col justify-center py-16">
    <p class="font-display text-7xl font-bold text-brand-600 dark:text-accent-400">
      404
    </p>
    <h1 class="mt-4 font-display text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl dark:text-white">
      Burada bir şey yok.
    </h1>
    <p class="mt-4 max-w-prose text-base leading-relaxed text-slate-600 dark:text-slate-400">
      Aradığın sayfa kaybolmuş, taşınmış ya da hiç var olmamış. Sitenin geri
      kalanını aşağıdaki bağlantılardan keşfedebilirsin.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a
        href={withBase('/')}
        class="inline-flex items-center gap-2 rounded-md bg-brand-700 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-brand-800 dark:bg-accent-500 dark:text-brand-950 dark:hover:bg-accent-400"
      >
        Anasayfaya dön
      </a>
      <a
        href={withBase('/araclar')}
        class="inline-flex items-center gap-2 rounded-md border border-slate-300 bg-white px-5 py-2.5 text-sm font-semibold text-slate-700 hover:border-slate-400 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:border-slate-600 dark:hover:bg-slate-800"
      >
        Araçları gör
      </a>
    </div>
  </Container>
</BaseLayout>
