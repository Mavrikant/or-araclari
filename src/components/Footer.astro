---
import { FOOTER_NAV } from '../data/nav';
import { SITE, withBase } from '../data/site';
import Container from './Container.astro';
import Logo from './Logo.astro';

const year = new Date().getFullYear();
---

<footer class="mt-16 border-t border-slate-200 bg-slate-50 dark:border-slate-800 dark:bg-slate-950/40">
  <Container as="div" size="wide" class="py-10">
    <div class="flex flex-col gap-8 sm:flex-row sm:items-start sm:justify-between">
      <div class="max-w-sm">
        <Logo size="md" />
        <p class="mt-3 text-sm leading-relaxed text-slate-600 dark:text-slate-400">
          {SITE.tagline}
        </p>
      </div>

      <nav aria-label="Footer" class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
        {
          FOOTER_NAV.map((item) => (
            <a
              href={withBase(item.href)}
              class="text-slate-600 hover:text-brand-700 dark:text-slate-400 dark:hover:text-accent-300"
            >
              {item.label}
            </a>
          ))
        }
        <a
          href={SITE.repo}
          rel="noopener"
          class="text-slate-600 hover:text-brand-700 dark:text-slate-400 dark:hover:text-accent-300"
        >
          GitHub
        </a>
      </nav>
    </div>

    <div class="mt-8 flex flex-col gap-2 border-t border-slate-200 pt-6 text-xs text-slate-500 sm:flex-row sm:items-center sm:justify-between dark:border-slate-800 dark:text-slate-500">
      <p>
        © {year} {SITE.author.name}. <a
          href={`${SITE.repo}/blob/main/LICENSE`}
          rel="noopener"
          class="underline-offset-2 hover:underline"
          >MIT lisansı</a
        > altında açık kaynak.
      </p>
      <p>Türkiye'de tasarlandı, dünyada kullanılır.</p>
    </div>
  </Container>
</footer>
