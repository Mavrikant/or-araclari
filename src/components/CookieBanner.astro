---
import { withBase, CLARITY_ID } from '../data/site';
---

<div
  id="cookie-banner"
  hidden
  role="dialog"
  aria-labelledby="cookie-title"
  aria-describedby="cookie-desc"
  class="fixed inset-x-0 bottom-0 z-50 border-t border-slate-200 bg-white shadow-lg dark:border-slate-800 dark:bg-slate-950"
>
  <div class="mx-auto flex max-w-5xl flex-col gap-4 px-4 py-4 sm:flex-row sm:items-center sm:justify-between sm:px-6 sm:py-5">
    <div class="flex-1 text-sm text-slate-700 dark:text-slate-300">
      <p id="cookie-title" class="font-display font-semibold text-slate-900 dark:text-white">
        Çerez tercihi
      </p>
      <p id="cookie-desc" class="mt-1">
        Bu site deneyimi iyileştirmek için anonim trafik ölçümü
        <span class="whitespace-nowrap">(Google Analytics 4)</span>,
        kullanım deneyimi analizi
        <span class="whitespace-nowrap">(Microsoft Clarity — ısı haritası ve oturum kaydı)</span>
        ve masrafları karşılamak için bağlamsal reklamlar
        <span class="whitespace-nowrap">(Google AdSense)</span> kullanır.
        İstemediğinde bunları kapatabilirsin.
        <a
          href={withBase('/cerezler')}
          class="text-brand-600 underline-offset-4 hover:underline dark:text-accent-400"
          >Detaylar</a
        >.
      </p>
    </div>
    <div class="flex flex-col gap-2 sm:flex-row sm:gap-3">
      <button
        type="button"
        id="cookie-reject"
        class="inline-flex items-center justify-center rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:border-slate-400 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800"
      >
        Sadece zorunlu
      </button>
      <button
        type="button"
        id="cookie-accept"
        class="inline-flex items-center justify-center rounded-md bg-brand-700 px-4 py-2 text-sm font-semibold text-white hover:bg-brand-800 dark:bg-accent-500 dark:text-brand-950 dark:hover:bg-accent-400"
      >
        Tümünü kabul et
      </button>
    </div>
  </div>
</div>

<script is:inline define:vars={{ clarityId: CLARITY_ID }}>
  (() => {
    const KEY = 'cookie-consent';
    const banner = document.getElementById('cookie-banner');
    const accept = document.getElementById('cookie-accept');
    const reject = document.getElementById('cookie-reject');
    if (!banner || !accept || !reject) return;

    const loadClarity = () => {
      if (!clarityId || window.clarity) return;
      (function (c, l, a, r, i) {
        c[a] =
          c[a] ||
          function () {
            (c[a].q = c[a].q || []).push(arguments);
          };
        const t = l.createElement(r);
        t.async = 1;
        t.src = 'https://www.clarity.ms/tag/' + i;
        const y = l.getElementsByTagName(r)[0];
        y.parentNode.insertBefore(t, y);
      })(window, document, 'clarity', 'script', clarityId);
    };

    const updateConsent = (granted) => {
      const value = granted ? 'granted' : 'denied';
      const update = {
        analytics_storage: value,
        ad_storage: value,
        ad_user_data: value,
        ad_personalization: value,
      };
      if (typeof window.gtag === 'function') {
        window.gtag('consent', 'update', update);
      }
      if (granted) {
        loadClarity();
      } else if (typeof window.clarity === 'function') {
        window.clarity('consent', false);
      }
    };

    const hide = (choice) => {
      try {
        localStorage.setItem(KEY, choice);
      } catch (_e) {
        /* localStorage unavailable; choice applies to this session only */
      }
      banner.hidden = true;
      updateConsent(choice === 'all');
    };

    let stored = null;
    try {
      stored = localStorage.getItem(KEY);
    } catch (_e) {
      /* ignore */
    }

    if (!stored) {
      banner.hidden = false;
    } else {
      updateConsent(stored === 'all');
    }

    accept.addEventListener('click', () => hide('all'));
    reject.addEventListener('click', () => hide('necessary'));
  })();
</script>
